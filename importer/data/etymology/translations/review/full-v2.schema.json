{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complete Shuowen uncertainty-reviewed v2 provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "dataset_metadata",
    "base_review_archive_sha256",
    "subset_archive_sha256",
    "file",
    "changed_english_keys",
    "resolved_keys",
    "new_uncertain_keys",
    "statistics"
  ],
  "properties": {
    "format": {
      "const": "mandarin-shuowen-full-uncertainty-review"
    },
    "schemaVersion": {
      "const": 1
    },
    "dataset_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_name", "version", "review_id", "status", "disclaimer"],
      "properties": {
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "1.0.0"
        },
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "partial-editorial-review"
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "base_review_archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subset_archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "uncertainty-reviewed-v2.txt"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "changed_english_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^shuowen:[1-9][0-9]*$"
      }
    },
    "resolved_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^shuowen:[1-9][0-9]*$"
      }
    },
    "new_uncertain_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^shuowen:[1-9][0-9]*$"
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "translation_edited_entries",
        "uncertain_before",
        "uncertain_after",
        "resolved_flags",
        "new_uncertain_flags",
        "changed_entry_count"
      ],
      "properties": {
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "translation_edited_entries": {
          "type": "integer",
          "minimum": 0
        },
        "uncertain_before": {
          "type": "integer",
          "minimum": 0
        },
        "uncertain_after": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_flags": {
          "type": "integer",
          "minimum": 0
        },
        "new_uncertain_flags": {
          "type": "integer",
          "minimum": 0
        },
        "changed_entry_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
