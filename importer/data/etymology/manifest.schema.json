{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mandarin etymology importer source manifest",
  "description": "Pinned importer-only sources. Counts describe upstream entries, not reviewed claims or matched application records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schemaVersion", "dataset_metadata", "retrievedAt", "sources"],
  "properties": {
    "$schema": {
      "const": "./manifest.schema.json"
    },
    "format": {
      "const": "mandarin-etymology-source-manifest"
    },
    "schemaVersion": {
      "const": 1
    },
    "dataset_metadata": {
      "$ref": "#/$defs/datasetMetadata"
    },
    "retrievedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "datasetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_name",
        "source_urls",
        "license",
        "license_scope",
        "import_date",
        "version",
        "disclaimer",
        "license_notices"
      ],
      "properties": {
        "source_name": { "type": "string", "minLength": 1 },
        "source_urls": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" }
        },
        "license": { "const": "source-specific" },
        "license_scope": { "type": "string", "minLength": 1 },
        "import_date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "version": { "const": "1.0.0" },
        "disclaimer": { "type": "string", "minLength": 1 },
        "license_notices": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/licenseNotice" }
        }
      }
    },
    "licenseNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "license",
        "source_path",
        "source_url",
        "sha256",
        "copyright_source_path",
        "copyright_notice",
        "notice"
      ],
      "properties": {
        "source_id": { "enum": ["howell", "shuowen"] },
        "license": { "enum": ["MIT", "Apache-2.0"] },
        "source_path": { "type": "string", "pattern": "^(howell|shuowen)/[^/]+$" },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "copyright_source_path": { "type": "string", "pattern": "^(howell|shuowen)/[^/]+$" },
        "copyright_notice": { "type": "string", "minLength": 1 },
        "notice": { "type": "string", "minLength": 1 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "upstreamPath", "url", "bytes", "sha256", "gitBlobSha1"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(howell|shuowen)/[^/]+$"
        },
        "upstreamPath": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "gitBlobSha1": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordCount", "distinctHeadwordCount", "format"],
      "properties": {
        "recordCount": {
          "type": "integer",
          "minimum": 1
        },
        "distinctHeadwordCount": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "authors",
        "repository",
        "revision",
        "license",
        "reviewStatus",
        "scopeNote",
        "inventory",
        "files"
      ],
      "properties": {
        "id": {
          "enum": ["howell", "shuowen"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "license": {
          "enum": ["MIT", "Apache-2.0"]
        },
        "reviewStatus": {
          "const": "unreviewed-source-material"
        },
        "scopeNote": {
          "type": "string",
          "minLength": 1
        },
        "inventory": {
          "$ref": "#/$defs/inventory"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    }
  }
}
