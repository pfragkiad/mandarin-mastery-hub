{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complementary etymology association handoff v1",
  "description": "Generated source notes and exact identities; all historical interpretations remain unreviewed. No catalogue, geometry or IDS mutation.",
  "oneOf": [
    {
      "$ref": "#/$defs/index"
    },
    {
      "$ref": "#/$defs/shard"
    },
    {
      "$ref": "#/$defs/audit"
    }
  ],
  "$defs": {
    "licenseNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "license",
        "source_path",
        "source_url",
        "sha256",
        "copyright_source_path",
        "copyright_notice",
        "notice"
      ],
      "properties": {
        "source_id": {
          "enum": ["howell", "shuowen"]
        },
        "license": {
          "enum": ["MIT", "Apache-2.0"]
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "copyright_source_path": {
          "type": "string",
          "minLength": 1
        },
        "copyright_notice": {
          "type": "string",
          "minLength": 1
        },
        "notice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "structuralSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "licenseEvidence",
        "name",
        "sha256",
        "url",
        "use",
        "version",
        "notice"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "licenseEvidence": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "use": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "notice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_name",
        "source_urls",
        "license",
        "license_scope",
        "import_date",
        "version",
        "disclaimer",
        "license_notices",
        "structural_source"
      ],
      "properties": {
        "source_name": {
          "const": "Mandarin etymology association handoff"
        },
        "source_urls": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "license": {
          "const": "source-specific"
        },
        "license_scope": {
          "type": "string",
          "minLength": 1
        },
        "import_date": {
          "type": "string",
          "format": "date"
        },
        "version": {
          "enum": ["1.0.0", "1.1.0"]
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        },
        "license_notices": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/licenseNotice"
          }
        },
        "structural_source": {
          "$ref": "#/$defs/structuralSource"
        },
        "translation_layer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language",
            "method",
            "review_status",
            "record_count",
            "uncertain_record_count",
            "version"
          ],
          "properties": {
            "language": {
              "const": "en"
            },
            "method": {
              "const": "ai-generated"
            },
            "review_status": {
              "const": "unreviewed-ai-draft"
            },
            "record_count": {
              "type": "integer",
              "minimum": 1
            },
            "uncertain_record_count": {
              "type": "integer",
              "minimum": 0
            },
            "version": {
              "const": "1.0.0"
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "glyph",
        "status",
        "entryIds",
        "candidateEntryIds",
        "historicalRoleVerified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(Characters|Components|Radicals):.+"
        },
        "kind": {
          "enum": ["Characters", "Components", "Radicals"]
        },
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "familyId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 214
        },
        "headingId": {
          "type": "string",
          "minLength": 1
        },
        "formKey": {
          "type": "string",
          "minLength": 1
        },
        "contextualIdentity": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["parentRadical", "lookAlikeGlyph"],
              "properties": {
                "parentRadical": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1
                },
                "lookAlikeGlyph": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "exact-headword",
            "context-review-required",
            "blocked-contextual-identity",
            "no-exact-headword"
          ]
        },
        "entryIds": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^(howell|shuowen):[^:]+$"
          }
        },
        "candidateEntryIds": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^(howell|shuowen):[^:]+$"
          }
        },
        "historicalRoleVerified": {
          "const": false
        },
        "file": {
          "type": "string",
          "pattern": "^glyphs/[a-f0-9]{4,6}\\.json$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "headword",
        "contentKind",
        "language",
        "text",
        "reviewStatus",
        "sourceRecord",
        "sourceUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(howell|shuowen):[^:]+$"
        },
        "sourceId": {
          "enum": ["howell", "shuowen"]
        },
        "headword": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "contentKind": {
          "enum": ["author-interpretation", "historical-dictionary"]
        },
        "language": {
          "enum": ["en", "lzh"]
        },
        "text": {
          "type": "string"
        },
        "reviewStatus": {
          "const": "unreviewed-source-material"
        },
        "sourceRecord": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "revision", "locator"],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "locator": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["entryOrdinal", "startLine", "endLine"],
                  "properties": {
                    "entryOrdinal": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["member", "memberSha256", "entryId"],
                  "properties": {
                    "member": {
                      "type": "string",
                      "minLength": 1
                    },
                    "memberSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "entryId": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              ]
            }
          }
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "translation": {
          "$ref": "#/$defs/translation"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "interpretationStatus"],
      "properties": {
        "coverage": {
          "enum": ["both", "howell-only", "shuowen-only", "none"]
        },
        "interpretationStatus": {
          "enum": ["unreviewed", "not-compared"]
        }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "glyph",
        "recordId",
        "entryIds",
        "requiresReview",
        "evidenceFile",
        "groupHead",
        "recordedNotes"
      ],
      "properties": {
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "recordId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "entryIds": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^(howell|shuowen):[^:]+$"
          }
        },
        "requiresReview": {
          "const": true
        },
        "evidenceFile": {
          "const": "public/data/character-variants-v1.4.0.json"
        },
        "groupHead": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "recordedNotes": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "path",
        "tokenKind",
        "headwordEntryIds",
        "relationship",
        "historicalRoleVerified"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "tokenKind": {
          "enum": ["babelstone-numbered", "unknown", "exact-form"]
        },
        "headwordEntryIds": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^(howell|shuowen):[^:]+$"
          }
        },
        "relationship": {
          "const": "graphical-membership-only"
        },
        "historicalRoleVerified": {
          "const": false
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "glyph",
        "sidecar",
        "sidecarCanonicalSha256",
        "currentTreeChecksum",
        "recordedTreeChecksum",
        "status",
        "alternatives"
      ],
      "properties": {
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "sidecar": {
          "type": "string",
          "minLength": 1
        },
        "sidecarCanonicalSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "currentTreeChecksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recordedTreeChecksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": ["current", "no-direct-G", "stale-tree-binding"]
        },
        "alternatives": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expression", "qualifiers", "parseStatus", "occurrences"],
            "properties": {
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "qualifiers": {
                "type": "string"
              },
              "parseStatus": {
                "enum": ["parsed", "unsupported"]
              },
              "occurrences": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "$ref": "#/$defs/occurrence"
                }
              }
            }
          }
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "glyph",
        "entries",
        "comparison",
        "relatedFormSuggestions",
        "babelstone",
        "associations",
        "radicalForms"
      ],
      "properties": {
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "entries": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        },
        "relatedFormSuggestions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/related"
          }
        },
        "babelstone": {
          "anyOf": [
            {
              "$ref": "#/$defs/structure"
            },
            {
              "type": "null"
            }
          ]
        },
        "associations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "radicalForms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceEntries",
        "catalogueRecords",
        "radicalFormRecords",
        "associationStatuses",
        "formStatuses",
        "sharedSourceHeadwords",
        "sharedCharacterRecords",
        "exactHeadwordMatchesByKind",
        "babelstoneLeafHeadwordMatches",
        "babelstoneLeafHeadwordMatchesBoth",
        "babelstoneNumberedTokens",
        "shardCount"
      ],
      "properties": {
        "sourceEntries": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "catalogueRecords": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "radicalFormRecords": {
          "type": "integer",
          "minimum": 0
        },
        "associationStatuses": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "formStatuses": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sharedSourceHeadwords": {
          "type": "integer",
          "minimum": 0
        },
        "sharedCharacterRecords": {
          "type": "integer",
          "minimum": 0
        },
        "exactHeadwordMatchesByKind": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "babelstoneLeafHeadwordMatches": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "babelstoneLeafHeadwordMatchesBoth": {
          "type": "integer",
          "minimum": 0
        },
        "babelstoneNumberedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "shardCount": {
          "type": "integer",
          "minimum": 1
        },
        "shuowenEnglishDrafts": {
          "type": "integer",
          "minimum": 0
        },
        "uncertainShuowenEnglishDrafts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "format",
        "schemaVersion",
        "dataset_metadata",
        "repositoryInputHashMode",
        "inputs",
        "shards",
        "records",
        "radicalForms"
      ],
      "properties": {
        "$schema": {
          "const": "./etymology.schema.json#/$defs/index"
        },
        "format": {
          "const": "mandarin-etymology-index"
        },
        "schemaVersion": {
          "const": 1
        },
        "dataset_metadata": {
          "$ref": "#/$defs/metadata"
        },
        "repositoryInputHashMode": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "shards": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "bytes", "glyphCount"],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "glyphCount": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "records": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["glyph", "status", "file"],
            "properties": {
              "glyph": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1
              },
              "status": {
                "enum": [
                  "exact-headword",
                  "context-review-required",
                  "blocked-contextual-identity",
                  "no-exact-headword"
                ]
              },
              "file": {
                "type": "string",
                "pattern": "^glyphs/[a-f0-9]{4,6}\\.json$"
              }
            }
          }
        },
        "radicalForms": {
          "type": "object",
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "#/$defs/target"
              },
              {
                "required": ["file", "headingId", "familyId", "formKey", "contextualIdentity"]
              }
            ]
          }
        }
      }
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "format", "schemaVersion", "dataset_metadata", "characters"],
      "properties": {
        "$schema": {
          "const": "../etymology.schema.json#/$defs/shard"
        },
        "format": {
          "const": "mandarin-etymology-shard"
        },
        "schemaVersion": {
          "const": 1
        },
        "dataset_metadata": {
          "$ref": "#/$defs/metadata"
        },
        "characters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/character"
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "format",
        "schemaVersion",
        "dataset_metadata",
        "inputs",
        "summary",
        "unmatchedSourceHeadwords",
        "duplicateShuowenHeadwords",
        "contextReviewTargets",
        "blockedContextualForms",
        "staleBabelstoneBindings",
        "unsupportedBabelstoneExpressions",
        "numberedTokens",
        "historicalInterpretationsVerified",
        "limitations"
      ],
      "properties": {
        "$schema": {
          "const": "../public/data/etymology/etymology.schema.json#/$defs/audit"
        },
        "format": {
          "const": "mandarin-etymology-association-audit"
        },
        "schemaVersion": {
          "const": 1
        },
        "dataset_metadata": {
          "$ref": "#/$defs/metadata"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "unmatchedSourceHeadwords": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            }
          }
        },
        "duplicateShuowenHeadwords": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "pattern": "^(howell|shuowen):[^:]+$"
            }
          }
        },
        "contextReviewTargets": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockedContextualForms": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "staleBabelstoneBindings": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["glyph", "sidecar", "currentTreeChecksum", "recordedTreeChecksum"],
            "properties": {
              "glyph": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1
              },
              "sidecar": {
                "type": "string",
                "minLength": 1
              },
              "currentTreeChecksum": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "recordedTreeChecksum": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "unsupportedBabelstoneExpressions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["glyph", "alternativeIndex", "expression"],
            "properties": {
              "glyph": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1
              },
              "alternativeIndex": {
                "type": "integer",
                "minimum": 0
              },
              "expression": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "numberedTokens": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^\\{[0-9]+\\}$"
          }
        },
        "historicalInterpretationsVerified": {
          "const": 0
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
