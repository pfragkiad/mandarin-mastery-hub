{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mandarin/v3/lesson_common.schema.json",
  "title": "Mandarin lessons v3.0.0 - shared contracts and reusable definitions",
  "description": "Specification module: use its $defs in type-specific lesson schemas; the module is not itself a lesson.",
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_topic_id",
        "topic_ids",
        "tags",
        "course_topic_refs"
      ],
      "properties": {
        "primary_topic_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Global topic key or null only when no global category reasonably applies."
        },
        "topic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "course_topic_refs": {
          "type": "array",
          "uniqueItems": true,
          "description": "Optional cross-references to course-private topics; not curriculum membership.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "curriculum_id",
              "course_topic_id"
            ],
            "properties": {
              "curriculum_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "course_topic_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "primary_topic_id": {
                "type": "string"
              }
            },
            "required": [
              "primary_topic_id"
            ]
          },
          "then": {
            "properties": {
              "topic_ids": {
                "contains": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "lesson_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "slug"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 4
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 20
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "template_version",
        "audience",
        "language",
        "date_reviewed"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "approved"
          ]
        },
        "template_version": {
          "const": "3.0.0"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "zh-CN",
            "zh-TW",
            "zh-HK"
          ]
        },
        "date_reviewed": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "catalog_character_refs": {
      "type": "object",
      "description": "Exact per-character IDs from external catalog_ids.json, never inferred or synthesized.",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 2
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^Characters:.+$"
      }
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "syllabus_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curriculum_id",
        "entry_id"
      ],
      "properties": {
        "curriculum_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "entry_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "quiz_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "hanzi": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        },
        "meaning_en": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "hanzi",
            "pinyin"
          ]
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "prompt",
        "choices",
        "correct_choice_ids",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "selection",
            "multi_selection",
            "comprehension",
            "production"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quiz_choice"
          }
        },
        "correct_choice_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "selection"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 2
              },
              "correct_choice_ids": {
                "minItems": 1,
                "maxItems": 1
              }
            },
            "not": {
              "required": [
                "answer"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "multi_selection"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 3
              },
              "correct_choice_ids": {
                "minItems": 2
              }
            },
            "not": {
              "required": [
                "answer"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "comprehension",
                  "production"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "answer"
            ],
            "properties": {
              "choices": {
                "maxItems": 0
              },
              "correct_choice_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hanzi",
        "pinyin",
        "english",
        "teaching_note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hanzi": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        },
        "english": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "enum": [
            "conversational",
            "written",
            "dialogue",
            "other"
          ]
        },
        "register": {
          "type": "string"
        },
        "teaching_note": {
          "type": "string"
        }
      }
    }
  }
}
