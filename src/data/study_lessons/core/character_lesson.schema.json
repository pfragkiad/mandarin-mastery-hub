      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "selection"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 2
              },
              "correct_choice_ids": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "multi_selection"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 3
              },
              "correct_choice_ids": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "comprehension",
                  "production"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "answer"
            ],
            "properties": {
              "choices": {
                "maxItems": 0
              },
              "correct_choice_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
