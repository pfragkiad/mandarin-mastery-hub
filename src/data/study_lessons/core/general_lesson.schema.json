{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mandarin/v3.1/general_lesson.schema.json",
  "title": "General grammar, dialogue and review lessons v3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "lesson_type",
    "lesson",
    "classification",
    "learning_objectives",
    "metadata",
    "catalog_character_refs",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "mandarin-general-lesson/3.0.0",
        "mandarin-general-lesson/3.1.0"
      ]
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "lesson_type": {
      "enum": [
        "grammar",
        "dialogue",
        "review",
        "generic"
      ]
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "slug"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 4
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 20
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_topic_id",
        "topic_ids",
        "tags",
        "course_topic_refs"
      ],
      "properties": {
        "primary_topic_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Global topic key or null only when no global category reasonably applies."
        },
        "topic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "course_topic_refs": {
          "type": "array",
          "uniqueItems": true,
          "description": "Optional cross-references to course-private topics; not curriculum membership.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "curriculum_id",
              "course_topic_id"
            ],
            "properties": {
              "curriculum_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "course_topic_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        },
        "primary_subtopic_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Optional primary global subtopic; must belong to an assigned topic parent."
        },
        "subtopic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true,
          "description": "Optional stable global subtopic IDs from the topic registry."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "primary_topic_id": {
                "type": "string"
              }
            },
            "required": [
              "primary_topic_id"
            ]
          },
          "then": {
            "properties": {
              "topic_ids": {
                "contains": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "template_version",
        "audience",
        "language",
        "date_reviewed"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "approved"
          ]
        },
        "template_version": {
          "enum": [
            "3.0.0",
            "3.1.0"
          ]
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "zh-CN",
            "zh-TW",
            "zh-HK"
          ]
        },
        "date_reviewed": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "catalog_character_refs": {
      "type": "object",
      "description": "Exact per-character IDs from external catalog_ids.json, never inferred or synthesized.",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 2
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^Characters:.+$"
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks",
        "practice"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "text"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "explanation"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "pattern_hanzi",
                  "pattern_pinyin",
                  "function_en",
                  "example"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "grammar_pattern"
                  },
                  "pattern_hanzi": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pattern_pinyin": {
                    "type": "string",
                    "minLength": 1
                  },
                  "function_en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "example": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "hanzi",
                      "pinyin",
                      "english",
                      "teaching_note"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "hanzi": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pinyin": {
                        "type": "string",
                        "minLength": 1
                      },
                      "english": {
                        "type": "string",
                        "minLength": 1
                      },
                      "style": {
                        "enum": [
                          "conversational",
                          "written",
                          "dialogue",
                          "other"
                        ]
                      },
                      "register": {
                        "type": "string"
                      },
                      "teaching_note": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "turns"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "dialogue"
                  },
                  "title": {
                    "type": "string"
                  },
                  "turns": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "speaker",
                        "hanzi",
                        "pinyin",
                        "english"
                      ],
                      "properties": {
                        "speaker": {
                          "type": "string",
                          "minLength": 1
                        },
                        "hanzi": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pinyin": {
                          "type": "string",
                          "minLength": 1
                        },
                        "english": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "items"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "review_set"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "hanzi",
                        "pinyin",
                        "meaning_en"
                      ],
                      "properties": {
                        "hanzi": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pinyin": {
                          "type": "string",
                          "minLength": 1
                        },
                        "meaning_en": {
                          "type": "string",
                          "minLength": 1
                        },
                        "syllabus_refs": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "curriculum_id",
                              "entry_id"
                            ],
                            "properties": {
                              "curriculum_id": {
                                "type": "string",
                                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                              },
                              "entry_id": {
                                "oneOf": [
                                  {
                                    "type": "integer",
                                    "minimum": 1
                                  },
                                  {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "examples"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "examples"
                  },
                  "examples": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "hanzi",
                        "pinyin",
                        "english",
                        "teaching_note"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "hanzi": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pinyin": {
                          "type": "string",
                          "minLength": 1
                        },
                        "english": {
                          "type": "string",
                          "minLength": 1
                        },
                        "style": {
                          "enum": [
                            "conversational",
                            "written",
                            "dialogue",
                            "other"
                          ]
                        },
                        "register": {
                          "type": "string"
                        },
                        "teaching_note": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "practice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "questions"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "questions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/question"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "prompt",
        "choices",
        "correct_choice_ids",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "selection",
            "multi_selection",
            "comprehension",
            "production"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quiz_choice"
          }
        },
        "correct_choice_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "selection"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 2
              },
              "correct_choice_ids": {
                "minItems": 1,
                "maxItems": 1
              }
            },
            "not": {
              "required": [
                "answer"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "multi_selection"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 3
              },
              "correct_choice_ids": {
                "minItems": 2
              }
            },
            "not": {
              "required": [
                "answer"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "comprehension",
                  "production"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "answer"
            ],
            "properties": {
              "choices": {
                "maxItems": 0
              },
              "correct_choice_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "quiz_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "hanzi": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        },
        "meaning_en": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "hanzi",
            "pinyin"
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lesson_type": {
            "const": "dialogue"
          }
        },
        "required": [
          "lesson_type"
        ]
      },
      "then": {
        "properties": {
          "sections": {
            "properties": {
              "blocks": {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "dialogue"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "const": "grammar"
          }
        },
        "required": [
          "lesson_type"
        ]
      },
      "then": {
        "properties": {
          "sections": {
            "properties": {
              "blocks": {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "grammar_pattern"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "const": "review"
          }
        },
        "required": [
          "lesson_type"
        ]
      },
      "then": {
        "properties": {
          "sections": {
            "properties": {
              "blocks": {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "review_set"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "mandarin-general-lesson/3.0.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "template_version": {
                "const": "3.0.0"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "mandarin-general-lesson/3.1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "template_version": {
                "const": "3.1.0"
              }
            }
          }
        }
      }
    }
  ],
  "description": " Optional global subtopics are validated against the shared taxonomy."
}
