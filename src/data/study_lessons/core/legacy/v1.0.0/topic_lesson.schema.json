{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mandarin-topic-lesson-1.0.0.schema.json",
  "title": "Mandarin HSK thematic lesson — v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "lesson",
    "metadata",
    "catalog_character_refs",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "mandarin-topic-lesson/1.0.0"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^hsk3-l1-topic-[a-z0-9-]+$"
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "description",
        "categories",
        "primary_category_id",
        "tags",
        "slug"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 15
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "primary_category_id": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "template_version",
        "audience",
        "language",
        "hsk",
        "primary_vocabulary_count",
        "related_vocabulary_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "approved"
          ]
        },
        "template_version": {
          "const": "1.0.0"
        },
        "audience": {
          "type": "string"
        },
        "language": {
          "const": "zh-CN"
        },
        "hsk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "edition"
          ],
          "properties": {
            "level": {
              "const": 1
            },
            "edition": {
              "type": "string"
            }
          }
        },
        "primary_vocabulary_count": {
          "type": "integer",
          "minimum": 1
        },
        "related_vocabulary_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "catalog_character_refs": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 2
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^Characters:.+$"
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "vocabulary",
        "grammar_points",
        "featured_example_ids",
        "practice"
      ],
      "properties": {
        "overview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic_description",
            "focus",
            "learning_objectives"
          ],
          "properties": {
            "topic_description": {
              "type": "string"
            },
            "focus": {
              "type": "string"
            },
            "learning_objectives": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            }
          }
        },
        "vocabulary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "related_entries"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/vocab"
              }
            },
            "related_entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/related"
              }
            }
          }
        },
        "grammar_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/grammar"
          }
        },
        "featured_example_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "practice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "questions"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "questions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/question"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "style",
        "register",
        "hanzi",
        "pinyin",
        "english",
        "teaching_note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ex-\\d{3}-[12]$"
        },
        "style": {
          "enum": [
            "conversational",
            "written"
          ]
        },
        "register": {
          "type": "string"
        },
        "hanzi": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        },
        "english": {
          "type": "string",
          "minLength": 1
        },
        "teaching_note": {
          "type": "string"
        }
      }
    },
    "vocab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entry_number",
        "hanzi",
        "pinyin",
        "meaning_en",
        "primary_pos_id",
        "pos_ids",
        "topic_ids",
        "examples"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^w-\\d{3}$"
        },
        "entry_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "hanzi": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        },
        "meaning_en": {
          "type": "string",
          "minLength": 1
        },
        "primary_pos_id": {
          "type": "string"
        },
        "pos_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "topic_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "pos_note": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_number",
        "hanzi",
        "pinyin",
        "meaning_en",
        "primary_category_id"
      ],
      "properties": {
        "entry_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "hanzi": {
          "type": "string"
        },
        "pinyin": {
          "type": "string"
        },
        "meaning_en": {
          "type": "string"
        },
        "primary_category_id": {
          "type": "string"
        }
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "explanation",
        "example_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "example_id": {
          "type": "string"
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "hanzi": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "prompt",
        "choices",
        "correct_choice_ids",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "selection",
            "multi_selection",
            "comprehension",
            "production"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 5
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "correct_choice_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "answer": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "selection"
              }
            }
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 2
              },
              "correct_choice_ids": {
                "minItems": 1,
                "maxItems": 1
              }
            },
            "not": {
              "required": [
                "answer"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "multi_selection"
              }
            }
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 3
              },
              "correct_choice_ids": {
                "minItems": 2
              }
            },
            "not": {
              "required": [
                "answer"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "comprehension",
                  "production"
                ]
              }
            }
          },
          "then": {
            "required": [
              "answer"
            ],
            "properties": {
              "choices": {
                "maxItems": 0
              },
              "correct_choice_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
