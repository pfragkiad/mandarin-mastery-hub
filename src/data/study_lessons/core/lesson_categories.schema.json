{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mandarin/v3/lesson_categories.schema.json",
  "title": "Global Mandarin topic registry v3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "description",
    "categories"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "aliases",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 4
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "status": {
            "enum": [
              "active",
              "deprecated"
            ]
          }
        }
      }
    }
  }
}
