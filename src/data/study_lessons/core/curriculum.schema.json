{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mandarin/v3/curriculum.schema.json",
  "title": "Mandarin multi-course curriculum manifest — v3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "curriculum_id",
    "title",
    "kind",
    "language",
    "status",
    "course_topics",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "mandarin-curriculum/3.0.0"
    },
    "curriculum_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "syllabus",
        "course",
        "custom"
      ]
    },
    "language": {
      "enum": [
        "zh-CN",
        "zh-TW",
        "zh-HK"
      ]
    },
    "edition": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "archived"
      ]
    },
    "description": {
      "type": "string"
    },
    "course_topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/course_topic"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "course_topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "global_topic_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "global_topic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "title",
        "sequence",
        "units"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
          }
        },
        "level_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "title",
        "sequence",
        "placements"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placement"
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement_id",
        "lesson_id",
        "sequence",
        "role",
        "prerequisite_lesson_ids",
        "course_topic_ids",
        "introduced_syllabus_entry_ids",
        "reviewed_syllabus_entry_ids"
      ],
      "properties": {
        "placement_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "lesson_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "core",
            "supplemental",
            "review",
            "reference"
          ]
        },
        "prerequisite_lesson_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "course_topic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "introduced_syllabus_entry_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "reviewed_syllabus_entry_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
