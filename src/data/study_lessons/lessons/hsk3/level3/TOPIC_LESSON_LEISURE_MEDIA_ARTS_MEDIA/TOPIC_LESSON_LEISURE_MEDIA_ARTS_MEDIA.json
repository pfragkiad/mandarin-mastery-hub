    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "At the Mid-Autumn Evening Party",
        "context_en": "Two friends talk about a campus festival show and taking photos.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "今晚学校有个中秋晚会，听说有很多精彩的节目！",
            "pinyin": "Jīnwǎn xuéxiào yǒu ge Zhōngqiū wǎnhuì, tīngshuō yǒu hěn duō jīngcǎi de jiémù!",
            "english": "Tonight the school has a Mid-Autumn evening party—I heard there are lots of wonderful acts!"
          },
          {
            "speaker": "B",
            "hanzi": "对，我们班还要表演一段音乐节目呢。你带相机了吗？",
            "pinyin": "Duì, wǒmen bān hái yào biǎoyǎn yí duàn yīnyuè jiémù ne. Nǐ dài xiàngjī le ma?",
            "english": "Yes, our class is even performing a music act. Did you bring your camera?"
          },
          {
            "speaker": "A",
            "hanzi": "带了！过节的时候大家一起拍照留念，多有意思。",
            "pinyin": "Dài le! Guòjié de shíhou dàjiā yìqǐ pāizhào liúniàn, duō yǒu yìsi.",
            "english": "I did! Taking photos together during the festival as a keepsake is so meaningful."
          },
          {
            "speaker": "B",
            "hanzi": "明天校报的新闻里说不定还会登我们的照片呢！",
            "pinyin": "Míngtiān xiàobào de xīnwén lǐ shuōbudìng hái huì dēng wǒmen de zhàopiàn ne!",
            "english": "Maybe tomorrow’s school newspaper news will even print our photos!"
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Taking photos with 拍照 / 照相",
          "explanation_en": "Both 拍照 (pāizhào) and 照相 (zhàoxiàng) mean \"take a photo\"; place 给 + person before them to say who you photograph.",
          "pattern_hanzi": "给 + <Person> + 拍照 / 照相",
          "pattern_pinyin": "gěi + <Person> + pāizhào / zhàoxiàng",
          "pattern_pseudo_translation": "for + <Person> + take photo",
          "examples": [
            {
              "hanzi": "能帮我们大家拍张照吗？",
              "pinyin": "Néng bāng wǒmen dàjiā pāi zhāng zhào ma?",
              "english": "Could you help take a photo for all of us?"
            },
            {
              "hanzi": "游客们喜欢在公园里照相。",
              "pinyin": "Yóukèmen xǐhuan zài gōngyuán lǐ zhàoxiàng.",
              "english": "Tourists like taking photos in the park."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Celebrating a festival with 过节",
          "explanation_en": "过节 (guòjié) means to celebrate or spend a holiday/festival.",
          "pattern_hanzi": "<People> + 在一起 + 过节",
          "pattern_pinyin": "<People> + zài yìqǐ + guòjié",
          "pattern_pseudo_translation": "<People> + together + celebrate festival",
          "examples": [
            {
              "hanzi": "每年春节，一家人都聚在一起过节。",
              "pinyin": "Měi nián Chūnjié, yì jiā rén dōu jù zài yìqǐ guòjié.",
              "english": "Every Spring Festival, the whole family gathers together to celebrate."
            },
            {
              "hanzi": "你们国家有哪些重要的节日？",
              "pinyin": "Nǐmen guójiā yǒu nǎxiē zhòngyào de jiérì?",
              "english": "What important festivals does your country have?"
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Talk about news, stories, music, and performances.",
        "model": {
          "hanzi": "爷爷每天早上都一边喝茶一边看报纸。",
          "pinyin": "Yéye měitiān zǎoshang dōu yìbiān hē chá yìbiān kàn bàozhǐ.",
          "english": "Grandpa reads the newspaper while drinking tea every morning."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Say you like listening to quiet music.",
            "model_answer": {
              "hanzi": "我喜欢听安静的音乐。",
              "pinyin": "Wǒ xǐhuan tīng ānjìng de yīnyuè.",
              "english": "I like listening to quiet music."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say you read an interesting piece of news today.",
            "model_answer": {
              "hanzi": "今天我在网上看到一条有趣的新闻。",
              "pinyin": "Jīntiān wǒ zài wǎngshàng kàndào yì tiáo yǒuqù de xīnwén.",
              "english": "Today I saw an interesting piece of news online."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say the children performed a short story on stage.",
            "model_answer": {
              "hanzi": "孩子们在台上表演了一个小故事。",
              "pinyin": "Háizimen zài tái shàng biǎoyǎn le yí ge xiǎo gùshi.",
              "english": "The children performed a short story on stage."
            }
          }
        ]
      },
      "reading": {
        "title": "Remembering a Festival Evening",
        "paragraphs": [
          {
            "hanzi": "去年中秋节，社区举办了一场热闹的晚会。台上既有唱歌、跳舞等音乐节目，也有小朋友表演的有趣故事。",
            "pinyin": "Qùnián Zhōngqiūjié, shèqū jǔbàn le yì chǎng rènào de wǎnhuì. Táishàng jì yǒu chànggē, tiàowǔ děng yīnyuè jiémù, yě yǒu xiǎo péngyou biǎoyǎn de yǒuqù gùshi.",
            "english": "Last Mid-Autumn Festival, the community held a lively evening party. On stage there were both music acts like singing and dancing, and fun stories performed by children."
          },
          {
            "hanzi": "张叔叔用他的新相机给大家拍了不少照片。第二天，当地报纸还发了一条关于这次过节活动的新闻。",
            "pinyin": "Zhāng shūshu yòng tā de xīn xiàngjī gěi dàjiā pāi le bùshǎo zhàopiàn. Dì-èr tiān, dāngdì bàozhǐ hái fā le yì tiáo guānyú zhè cì guòjié huódòng de xīnwén.",
            "english": "Uncle Zhang used his new camera to take quite a few photos for everyone. The next day, the local newspaper even published a news piece about this festival event."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "What kinds of performances were on stage at the evening party?",
            "answer_en": "Music acts like singing and dancing, and stories performed by children."
          },
          {
            "id": "reading-2",
            "prompt_en": "What appeared in the local newspaper the next day?",
            "answer_en": "A news piece about the festival event."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Talk about your favorite festival and how you celebrate it using 节日 and 过节.",
          "model_answer": {
            "hanzi": "我最喜欢的节日是春节，过节时家人会一起吃饭、看晚会。",
            "pinyin": "Wǒ zuì xǐhuan de jiérì shì Chūnjié, guòjié shí jiārén huì yìqǐ chīfàn, kàn wǎnhuì.",
            "english": "My favorite festival is Spring Festival; during the holiday my family eats together and watches the evening gala."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Say whether you read newspapers/news or like taking photos.",
          "model_answer": {
            "hanzi": "我每天看新闻，出去玩儿时也喜欢用相机拍照。",
            "pinyin": "Wǒ měitiān kàn xīnwén, chūqù wánr shí yě xǐhuan yòng xiàngjī pāizhào.",
            "english": "I read the news every day, and when I go out I also like taking photos with a camera."
          }
        }
      ],
      "common_pitfall": "报纸 is the physical newspaper (\"a sheet of newspaper\": 一份报纸), while 新闻 is the news content (\"a news story\": 一条新闻).",
      "pronunciation_focus": "故事 (gùshi) and 报纸 (bàozhǐ) contrast neutral-tone shi with third-tone zhǐ; 拍照 (pāizhào) moves from flat pāi to falling zhào.",
      "review": {
        "can_do": [
          "Talk about shows, music, and festivals.",
