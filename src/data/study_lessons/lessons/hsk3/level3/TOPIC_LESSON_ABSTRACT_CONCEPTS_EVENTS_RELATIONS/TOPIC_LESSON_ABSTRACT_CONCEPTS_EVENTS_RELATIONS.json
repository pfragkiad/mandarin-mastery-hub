    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Talking About City Changes",
        "context_en": "Two friends talk about how their hometown has changed and a cultural talk they attended.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "这几年我们城市发生了很大的变化，发展得真快！",
            "pinyin": "Zhè jǐ nián wǒmen chéngshì fāshēng le hěn dà de biànhuà, fāzhǎn de zhēn kuài!",
            "english": "In the last few years our city has undergone huge changes—it’s developing so fast!"
          },
          {
            "speaker": "B",
            "hanzi": "是啊，科技发展对大家的生活影响特别大。",
            "pinyin": "Shì a, kējì fāzhǎn duì dàjiā de shēnghuó yǐngxiǎng tèbié dà.",
            "english": "Yes, technological development has an especially big influence on everyone’s life."
          },
          {
            "speaker": "A",
            "hanzi": "对了，昨天我听了一个关于中国茶文化的讲座，很有意思。",
            "pinyin": "Duìle, zuótiān wǒ tīng le yí ge guānyú Zhōngguó chá wénhuà de jiǎngzuò, hěn yǒu yìsi.",
            "english": "By the way, yesterday I attended a talk about Chinese tea culture—it was very interesting."
          },
          {
            "speaker": "B",
            "hanzi": "我也对这方面很感兴趣，和历史有关的书我都喜欢看。",
            "pinyin": "Wǒ yě duì zhè fāngmiàn hěn gǎn xìngqù, hé lìshǐ yǒuguān de shū wǒ dōu xǐhuan kàn.",
            "english": "I’m very interested in that area too; I like reading any books related to history."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Introducing a topic with 关于 / 有关",
          "explanation_en": "关于 (guānyú) precedes a topic noun (\"about / regarding\"); 有关 (yǒuguān) follows 和 / 与 (\"related to\").",
          "pattern_hanzi": "关于 + <Topic> + 的 + <Noun>  /  和 + <Topic> + 有关的 + <Noun>",
          "pattern_pinyin": "guānyú + <Topic> + de + <Noun>  /  hé + <Topic> + yǒuguān de + <Noun>",
          "pattern_pseudo_translation": "regarding + <Topic> + ’s + <Noun>  /  with + <Topic> + related + <Noun>",
          "examples": [
            {
              "hanzi": "这是一本关于环境保护的书。",
              "pinyin": "Zhè shì yì běn guānyú huánjìng bǎohù de shū.",
              "english": "This is a book about environmental protection."
            },
            {
              "hanzi": "老师讲了很多和考试有关的要求。",
              "pinyin": "Lǎoshī jiǎng le hěn duō hé kǎoshì yǒuguān de yāoqiú.",
              "english": "The teacher explained many requirements related to the exam."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Receiving influence or welcome with 受到",
          "explanation_en": "受到 (shòudào) pairs with abstract nouns like 影响 (influence) or 欢迎 (welcome).",
          "pattern_hanzi": "<Subject> + 受到 + (了) + <Abstract Noun>",
          "pattern_pinyin": "<Subject> + shòudào + (le) + <Abstract Noun>",
          "pattern_pseudo_translation": "<Subject> + received + <Abstract Noun>",
          "examples": [
            {
              "hanzi": "他的想法受到了老师的影响。",
              "pinyin": "Tā de xiǎngfǎ shòudào le lǎoshī de yǐngxiǎng.",
              "english": "His ideas were influenced by the teacher."
            },
            {
              "hanzi": "这位新歌手受到了年轻人的欢迎。",
              "pinyin": "Zhè wèi xīn gēshǒu shòudào le niánqīngrén de huānyíng.",
              "english": "This new singer was welcomed by young people."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Talk about relationships, requirements, and things happening.",
        "model": {
          "hanzi": "这件事和我们的学习关系很大。",
          "pinyin": "Zhè jiàn shì hé wǒmen de xuéxí guānxì hěn dà.",
          "english": "This matter has a big connection to our studies."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Say something interesting happened at school today.",
            "model_answer": {
              "hanzi": "今天学校里发生了一件有趣的事。",
              "pinyin": "Jīntiān xuéxiào lǐ fāshēng le yí jiàn yǒuqù de shì.",
              "english": "Something interesting happened at school today."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say the company has high requirements for work.",
            "model_answer": {
              "hanzi": "公司对工作的要求很高。",
              "pinyin": "Gōngsī duì gōngzuò de yāoqiú hěn gāo.",
              "english": "The company has high requirements for work."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say it doesn’t matter (没关系), we can try again.",
            "model_answer": {
              "hanzi": "没关系，咱们可以再试一次。",
              "pinyin": "Méiguānxi, zánmen kěyǐ zài shì yí cì.",
              "english": "It doesn’t matter; we can try one more time."
            }
          }
        ]
      },
      "reading": {
        "title": "How Reading Changes Life",
        "paragraphs": [
          {
            "hanzi": "一个人的阅读习惯往往对他的生活有很大的影响。多读好书不仅能帮我们了解不同的文化，还能让我们看到世界的发展和变化。",
            "pinyin": "Yí ge rén de yuèdú xíguàn wǎngwǎng duì tā de shēnghuó yǒu hěn dà de yǐngxiǎng. Duō dú hǎo shū bùjǐn néng bāng wǒmen liǎojiě bù tóng de wénhuà, hái néng ràng wǒmen kàndào shìjiè de fāzhǎn hé biànhuà.",
            "english": "A person’s reading habits often have a big influence on their life. Reading more good books not only helps us understand different cultures, but also lets us see the world’s development and changes."
          },
          {
            "hanzi": "不管工作要求有多高，每天留一点儿时间看看关于生活或历史的书，都会让人受益。",
            "pinyin": "Bùguǎn gōngzuò yāoqiú yǒu duō gāo, měitiān liú yìdiǎnr shíjiān kànkan guānyú shēnghuó huò lìshǐ de shū, dōu huì ràng rén shòuyì.",
            "english": "No matter how high work demands are, setting aside a little time each day to read books about life or history will benefit you."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "What two benefits of reading good books are mentioned?",
            "answer_en": "Understanding different cultures and seeing the world’s development and changes."
          },
          {
            "id": "reading-2",
            "prompt_en": "What kinds of books does the passage suggest reading each day?",
            "answer_en": "Books about life or history."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Describe a change in your city or life using 发生 and 变化.",
          "model_answer": {
            "hanzi": "这几年我的生活发生了很大的变化，工作更忙但也更充实了。",
            "pinyin": "Zhè jǐ nián wǒ de shēnghuó fāshēng le hěn dà de biànhuà, gōngzuò gèng máng dàn yě gèng chōngshí le.",
            "english": "Over the past few years my life has undergone big changes—work is busier yet more fulfilling."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Say what kind of books or culture you like using 关于 or 文化.",
          "model_answer": {
            "hanzi": "我特别喜欢看关于中国饮食文化的节目。",
            "pinyin": "Wǒ tèbié xǐhuan kàn guānyú Zhōngguó yǐnshí wénhuà de jiémù.",
            "english": "I especially like watching programs about Chinese food culture."
          }
        }
      ],
      "common_pitfall": "Use 发生 (\"happen / occur\") for events, accidents, or changes (发生了一件事 / 发生了变化), not for people doing things.",
      "pronunciation_focus": "文化 (wénhuà) moves from rising wén to falling huà; 影响 (yǐngxiǎng) has two third tones, so the first shifts to yíngxiǎng.",
      "review": {
        "can_do": [
          "Talk about events, changes, and development.",
          "Use 关于 and 和……有关.",
          "Describe requirements, culture, and influence."
        ],
