    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Moving Into a New Apartment",
        "context_en": "Xiao Zhang shows his friend around his new house after moving.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "听说你上周搬家了，新房子怎么样？",
            "pinyin": "Tīngshuō nǐ shàng zhōu bānjiā le, xīn fángzi zěnmeyàng?",
            "english": "I heard you moved last week—how is the new house?"
          },
          {
            "speaker": "B",
            "hanzi": "很不错！屋子很大，楼下还有一个小花园。",
            "pinyin": "Hěn búcuò! Wūzi hěn dà, lóuxià hái yǒu yí ge xiǎo huāyuán.",
            "english": "Really nice! The rooms are big, and there’s a small garden downstairs."
          },
          {
            "speaker": "A",
            "hanzi": "家具和电器都买齐了吗？",
            "pinyin": "Jiājù hé diànqì dōu mǎi qí le ma?",
            "english": "Have you bought all the furniture and appliances yet?"
          },
          {
            "speaker": "B",
            "hanzi": "差不多了，沙发、冰箱、空调和洗衣机都已经放好了。",
            "pinyin": "Chàbuduō le, shāfā, bīngxiāng, kōngtiáo hé xǐyījī dōu yǐjīng fàng hǎo le.",
            "english": "Almost—the sofa, fridge, air conditioner, and washing machine are all already in place."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Counting appliances with 台",
          "explanation_en": "Use 台 (tái) as the classifier for electrical appliances and machines such as 冰箱, 空调, and 洗衣机.",
          "pattern_hanzi": "<Number> + 台 + 冰箱 / 空调 / 洗衣机",
          "pattern_pinyin": "<Number> + tái + bīngxiāng / kōngtiáo / xǐyījī",
          "pattern_pseudo_translation": "<Number> + unit + fridge / AC / washer",
          "examples": [
            {
              "hanzi": "新屋子里装了两台空调。",
              "pinyin": "Xīn wūzi lǐ zhuāng le liǎng tái kōngtiáo.",
              "english": "Two air conditioners were installed in the new room."
            },
            {
              "hanzi": "我家的这台洗衣机用了五年了。",
              "pinyin": "Wǒ jiā de zhè tái xǐyījī yòng le wǔ nián le.",
              "english": "This washing machine at our home has been used for five years."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Moving to a new place with 搬家",
          "explanation_en": "搬家 (bānjiā) means to move house; use 搬到 + place when specifying the new address.",
          "pattern_hanzi": "<Subject> + 搬家 + 到 + <Place>",
          "pattern_pinyin": "<Subject> + bānjiā + dào + <Place>",
          "pattern_pseudo_translation": "<Subject> + move home + to + <Place>",
          "examples": [
            {
              "hanzi": "下个月我们就要搬家到市中心了。",
              "pinyin": "Xià ge yuè wǒmen jiù yào bānjiā dào shìzhōngxīn le.",
              "english": "Next month we are moving to the city center."
            },
            {
              "hanzi": "搬家那天，好几个朋友来帮忙。",
              "pinyin": "Bānjiā nà tiān, hǎo jǐ ge péngyou lái bāngmáng.",
              "english": "On moving day, several friends came to help."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Describe rooms, furniture, and appliances.",
        "model": {
          "hanzi": "奶奶喜欢坐在花园里晒太阳。",
          "pinyin": "Nǎinai xǐhuan zuò zài huāyuán lǐ shài tàiyáng.",
          "english": "Grandma likes sitting in the garden to enjoy the sun."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Say there is fresh fruit and milk in the refrigerator.",
            "model_answer": {
              "hanzi": "冰箱里有新鲜的水果和牛奶。",
              "pinyin": "Bīngxiāng lǐ yǒu xīnxiān de shuǐguǒ hé niúnǎi.",
              "english": "There is fresh fruit and milk in the refrigerator."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say the cat likes sleeping on the sofa.",
            "model_answer": {
              "hanzi": "小猫喜欢在沙发上睡觉。",
              "pinyin": "Xiǎo māo xǐhuan zài shāfā shàng shuìjiào.",
              "english": "The kitten likes sleeping on the sofa."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say this house is bright and clean.",
            "model_answer": {
              "hanzi": "这套房子又亮堂又干净。",
              "pinyin": "Zhè tào fángzi yòu liàngtang yòu gānjìng.",
              "english": "This house is both bright and clean."
            }
          }
        ]
      },
      "reading": {
        "title": "Cleaning Up the New Home",
        "paragraphs": [
          {
            "hanzi": "李叔叔一家刚搬进新房子。屋子虽然不算特别大，但是客厅里的沙发很舒服，窗外就能看到小区里的花园。",
            "pinyin": "Lǐ shūshu yì jiā gāng bān jìn xīn fángzi. Wūzi suīrán bú suàn tèbié dà, dànshì kètīng lǐ de shāfā hěn shūfu, chuāngwài jiù néng kàndào xiǎoqū lǐ de huāyuán.",
            "english": "Uncle Li’s family just moved into a new house. Although the rooms aren’t huge, the sofa in the living room is very comfortable, and outside the window you can see the neighborhood garden."
          },
          {
            "hanzi": "夏天快到了，他们还提前检查了空调和冰箱，把屋子打扫得干干净净。",
            "pinyin": "Xiàtiān kuài dào le, tāmen hái tíqián jiǎnchá le kōngtiáo hé bīngxiāng, bǎ wūzi dǎsǎo de gāngānjìngjìng.",
            "english": "Summer is almost here, so they checked the air conditioner and refrigerator in advance and cleaned the rooms spotless."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "What can you see outside the window of Uncle Li’s new home?",
            "answer_en": "The neighborhood garden (小区里的花园)."
          },
          {
            "id": "reading-2",
            "prompt_en": "Which appliances did they check before summer?",
            "answer_en": "The air conditioner and refrigerator."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Describe your home or room using 房子, 屋子, or 沙发.",
          "model_answer": {
            "hanzi": "我的屋子不大，但放着一张床和一张小沙发，很舒服。",
            "pinyin": "Wǒ de wūzi bú dà, dàn fàng zhe yì zhāng chuáng hé yì zhāng xiǎo shāfā, hěn shūfu.",
            "english": "My room isn’t big, but it has a bed and a small sofa—very comfortable."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Say which household appliance you use most often.",
          "model_answer": {
            "hanzi": "夏天我每天都要开空调，冬天用得比较少。",
            "pinyin": "Xiàtiān wǒ měitiān dōu yào kāi kōngtiáo, dōngtiān yòng de bǐjiào shǎo.",
            "english": "In summer I turn on the air conditioner every day, and use it less in winter."
          }
        }
      ],
      "common_pitfall": "房子 refers to a house/apartment building or unit as a whole, while 屋子 refers to a room (or the interior space of a home).",
      "pronunciation_focus": "空调 (kōngtiáo) pairs flat kōng with rising tiáo; 洗衣机 (xǐyījī) has third-tone xǐ followed by two flat first tones.",
      "review": {
        "can_do": [
          "Talk about moving house and rooms.",
