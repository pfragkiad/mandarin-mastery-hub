    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Four Seasons at the Zoo and Park",
        "context_en": "Two friends talk about the weather and going to see giant pandas.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "今天刮风了，比昨天凉快多了！",
            "pinyin": "Jīntiān guā fēng le, bǐ zuótiān liángkuai duō le!",
            "english": "It’s windy today—much cooler than yesterday!"
          },
          {
            "speaker": "B",
            "hanzi": "是啊，秋天到了嘛。我们这儿四季分明，春天暖和，夏天热，秋天凉快，冬天冷。",
            "pinyin": "Shì a, qiūtiān dào le ma. Wǒmen zhèr sìjì fēn míng, chūntiān nuǎnhuo, xiàtiān rè, qiūtiān liángkuai, dōngtiān lěng.",
            "english": "Yes, autumn has arrived! Our four seasons are distinct here: warm spring, hot summer, cool autumn, and cold winter."
          },
          {
            "speaker": "A",
            "hanzi": "这么凉快的天气，周末咱们去动物园看大熊猫吧？",
            "pinyin": "Zhème liángkuai de tiānqì, zhōumò zánmen qù dòngwùyuán kàn dàxióngmāo ba?",
            "english": "With weather this cool, shall we go to the zoo this weekend to see the giant pandas?"
          },
          {
            "speaker": "B",
            "hanzi": "好呀，我还想看看草原上的马、牛和羊呢！",
            "pinyin": "Hǎo ya, wǒ hái xiǎng kànkan cǎoyuán shàng de mǎ, niú hé yáng ne!",
            "english": "Sure, and I’d also love to see horses, cows, and sheep on the grasslands!"
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Talking about wind with 刮风",
          "explanation_en": "刮 (guā) pairs with 风 (fēng) as 刮风 (\"the wind blows\"); modifiers like 大 go between 刮 and 风.",
          "pattern_hanzi": "刮 + (大) + 风 + 了",
          "pattern_pinyin": "guā + (dà) + fēng + le",
          "pattern_pseudo_translation": "blow + (big) + wind + (change)",
          "examples": [
            {
              "hanzi": "外面刮大风了，快把窗户关上。",
              "pinyin": "Wàimiàn guā dà fēng le, kuài bǎ chuānghu guān shàng.",
              "english": "It’s blowing a strong wind outside—hurry and close the window."
            },
            {
              "hanzi": "冬天北方常常刮北风。",
              "pinyin": "Dōngtiān běifāng chángcháng guā běifēng.",
              "english": "In winter, a north wind often blows in northern China."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Comparing seasons",
          "explanation_en": "Use 春天 / 夏天 / 秋天 / 冬天 + 比 + season + adj to compare seasonal weather.",
          "pattern_hanzi": "<Season A> + 比 + <Season B> + <Adjective>",
          "pattern_pinyin": "<Season A> + bǐ + <Season B> + <Adjective>",
          "pattern_pseudo_translation": "<Season A> + compared to + <Season B> + <Adjective>",
          "examples": [
            {
              "hanzi": "秋天比夏天凉快得多。",
              "pinyin": "Qiūtiān bǐ xiàtiān liángkuai de duō.",
              "english": "Autumn is much cooler than summer."
            },
            {
              "hanzi": "我老家的冬天没有北京那么冷。",
              "pinyin": "Wǒ lǎojiā de dōngtiān méiyǒu Běijīng nàme lěng.",
              "english": "Winter in my hometown is not as cold as in Beijing."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Describe seasonal weather and animals.",
        "model": {
          "hanzi": "我最喜欢的动物是可爱的大熊猫。",
          "pinyin": "Wǒ zuì xǐhuan de dòngwù shì kě’ài de dàxióngmāo.",
          "english": "My favorite animal is the cute giant panda."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Say flowers bloom everywhere in spring.",
            "model_answer": {
              "hanzi": "春天的时候，公园里到处开花。",
              "pinyin": "Chūntiān de shíhou, gōngyuán lǐ dàochù kāihuā.",
              "english": "In spring, flowers bloom everywhere in the park."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say there are many cows and sheep on the grass.",
            "model_answer": {
              "hanzi": "草地上有很多牛和羊。",
              "pinyin": "Cǎodì shàng yǒu hěn duō niú hé yáng.",
              "english": "There are many cows and sheep on the grassland."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say he learned to ride a horse last summer.",
            "model_answer": {
              "hanzi": "去年夏天他学会了骑马。",
              "pinyin": "Qùnián xiàtiān tā xuéhuì le qí mǎ.",
              "english": "Last summer he learned to ride a horse."
            }
          }
        ]
      },
      "reading": {
        "title": "Visiting the Giant Pandas",
        "paragraphs": [
          {
            "hanzi": "成都不仅美食多，而且能看到国宝大熊猫。春天的成都还不算太热，微风吹来非常凉快。",
            "pinyin": "Chéngdū bùjǐn měishí duō, érqiě néng kàndào guóbǎo dàxióngmāo. Chūntiān de Chéngdū hái bú suàn tài rè, wēifēng chuī lái fēicháng liángkuai.",
            "english": "Chengdu not only has lots of good food, you can also see the national treasure giant pandas. Chengdu in spring is not too hot yet, and the gentle breeze feels very cool."
          },
          {
            "hanzi": "早上动物们最有精神，大熊猫一边吃竹子一边慢慢地走来走去，吸引了好多游客。",
            "pinyin": "Zǎoshang dòngwùmen zuì yǒu jīngshen, dàxióngmāo yìbiān chī zhúzi yìbiān mànmàn de zǒu lái zǒu qù, xīyǐn le hǎoduō yóukè.",
            "english": "In the morning the animals have the most energy; the giant pandas eat bamboo while walking slowly around, attracting lots of tourists."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "When do the animals have the most energy?",
            "answer_en": "In the morning."
          },
          {
            "id": "reading-2",
            "prompt_en": "What are the giant pandas doing while walking around?",
            "answer_en": "Eating bamboo."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Compare two seasons in your hometown using 春天, 夏天, 秋天, 冬天, or 凉快.",
          "model_answer": {
            "hanzi": "我们那儿夏天很热，但是秋天特别凉快，是我最喜欢的季节。",
            "pinyin": "Wǒmen nàr xiàtiān hěn rè, dànshì qiūtiān tèbié liángkuai, shì wǒ zuì xǐhuan de jìjié.",
            "english": "Summer is very hot where I live, but autumn is especially cool—it’s my favorite season."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Name an animal you like or have seen at a zoo or farm.",
          "model_answer": {
            "hanzi": "我在动物园见过大熊猫，还在农村见过马和羊。",
            "pinyin": "Wǒ zài dòngwùyuán jiàn guò dàxióngmāo, hái zài nóngcūn jiàn guò mǎ hé yáng.",
            "english": "I’ve seen giant pandas at the zoo, and horses and sheep in the countryside."
          }
        }
      ],
      "common_pitfall": "Use 凉快 (liángkuai) for pleasantly cool weather or breeze (秋天很凉快), whereas 冷 (lěng) means uncomfortably cold.",
      "pronunciation_focus": "凉快 (liángkuai) has a neutral tone on kuai; 大熊猫 (dàxióngmāo) moves from fourth to second to first tone.",
      "review": {
