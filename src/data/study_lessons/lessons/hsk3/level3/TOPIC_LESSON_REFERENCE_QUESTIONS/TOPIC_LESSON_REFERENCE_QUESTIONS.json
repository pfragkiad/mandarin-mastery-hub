  "lesson": {
    "title": "Asking How & Talking About Others",
    "subtitle": "Inclusive \"we\", \"other\", and asking how to handle things",
    "description": "Learn to include the listener with 咱们, refer to others with 别的 or 其他, and ask what to do.",
    "slug": "asking-how-and-others"
  },
  "classification": {
    "primary_topic_id": "reference-questions",
