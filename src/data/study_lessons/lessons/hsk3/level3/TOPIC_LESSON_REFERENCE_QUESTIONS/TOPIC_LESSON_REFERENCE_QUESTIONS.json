  "sections": {
    "overview": {
      "topic_description": "Five high-frequency reference and question expressions used constantly in everyday conversation.",
      "focus": "Use 咱们 when both speaker and listener are included, and 怎么办 when asking what to do about a situation."
    },
    "vocabulary": {
      "items": [
        {
          "id": "w-0531",
          "hanzi": "别的",
          "pinyin": "biéde",
          "meaning_en": "other; another",
          "primary_pos_id": "pronoun",
          "pos_ids": [
            "pronoun"
          ],
          "primary_topic_id": "reference-questions",
          "topic_ids": [
            "reference-questions"
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "examples": [
            {
              "id": "ex-0531-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "有没有别的颜色？",
              "pinyin": "yǒu méiyǒu biéde yánsè?",
              "english": "Do you have another color?",
              "teaching_note": "Short everyday spoken use of 别的."
            },
            {
              "id": "ex-0531-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "我们还可以用别的办法。",
              "pinyin": "wǒmen hái kěyǐ yòng biéde bànfǎ.",
              "english": "We can also use another method.",
              "teaching_note": "Simple descriptive or narrative use of 别的."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 531
            }
          ]
        },
        {
          "id": "w-0798",
          "hanzi": "其他",
          "pinyin": "qítā",
          "meaning_en": "other; others",
          "primary_pos_id": "pronoun",
          "pos_ids": [
            "pronoun"
          ],
          "primary_topic_id": "reference-questions",
          "topic_ids": [
            "reference-questions"
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "examples": [
            {
              "id": "ex-0798-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "其他人呢？",
              "pinyin": "qítā rén ne?",
              "english": "What about the others?",
              "teaching_note": "Short everyday spoken use of 其他."
            },
            {
              "id": "ex-0798-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "其他学生已经回家了。",
              "pinyin": "qítā xuéshēng yǐjīng huí jiā le.",
              "english": "The other students have already gone home.",
              "teaching_note": "Simple descriptive or narrative use of 其他."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 798
            }
          ]
        },
        {
          "id": "w-0962",
          "hanzi": "咱们",
          "pinyin": "zánmen",
          "meaning_en": "we; us (including listener)",
          "primary_pos_id": "pronoun",
          "pos_ids": [
            "pronoun"
          ],
          "primary_topic_id": "reference-questions",
          "topic_ids": [
            "reference-questions"
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "examples": [
            {
              "id": "ex-0962-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "咱们走吧！",
              "pinyin": "zánmen zǒu ba!",
              "english": "Let's go!",
              "teaching_note": "Short everyday spoken use of 咱们."
            },
            {
              "id": "ex-0962-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "“咱们明天一起去公园吧。”爷爷说。",
              "pinyin": "“zánmen míngtiān yìqǐ qù gōngyuán ba.” yéye shuō.",
              "english": "“Let’s go to the park together tomorrow,” Grandpa said.",
              "teaching_note": "Quoted speech in a written narrative frame."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 962
            }
          ]
        },
        {
          "id": "w-0964",
          "hanzi": "怎么办",
          "pinyin": "zěnme bàn",
          "meaning_en": "what to do; how to deal with it",
          "primary_pos_id": "pronoun",
          "pos_ids": [
            "pronoun"
          ],
          "primary_topic_id": "reference-questions",
          "topic_ids": [
            "reference-questions"
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "examples": [
            {
              "id": "ex-0964-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "现在怎么办？",
              "pinyin": "xiànzài zěnme bàn?",
              "english": "What should we do now?",
              "teaching_note": "Short everyday spoken use of 怎么办."
            },
            {
              "id": "ex-0964-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "大家都在想明天下雨了该怎么办。",
              "pinyin": "dàjiā dōu zài xiǎng míngtiān xià yǔ le gāi zěnme bàn.",
              "english": "Everyone is wondering what to do if it rains tomorrow.",
              "teaching_note": "怎么办 introduces the question being considered within the sentence."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 964
            }
          ]
        },
        {
          "id": "w-0965",
          "hanzi": "怎样",
          "pinyin": "zěnyàng",
          "meaning_en": "how; in what way",
          "primary_pos_id": "pronoun",
          "pos_ids": [
            "pronoun"
          ],
          "primary_topic_id": "reference-questions",
          "topic_ids": [
            "reference-questions"
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "examples": [
            {
              "id": "ex-0965-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "你想怎样做？",
              "pinyin": "nǐ xiǎng zěnyàng zuò?",
              "english": "How do you want to do it?",
              "teaching_note": "Short everyday spoken use of 怎样."
            },
            {
              "id": "ex-0965-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "他正在想怎样回答这个问题。",
              "pinyin": "tā zhèngzài xiǎng zěnyàng huídá zhège wèntí.",
              "english": "He is thinking about how to answer this question.",
              "teaching_note": "Simple descriptive or narrative use of 怎样."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 965
            }
          ]
        },
        {
          "id": "w-0146",
          "hanzi": "你",
          "pinyin": "nǐ",
          "meaning_en": "you",
          "primary_pos_id": "pronoun",
          "pos_ids": [
            "pronoun"
          ],
          "primary_topic_id": "reference-questions",
          "topic_ids": [
            "reference-questions"
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "examples": [
            {
              "id": "ex-0146-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "你好，你是新学生吗？",
              "pinyin": "nǐ hǎo, nǐ shì xīn xuéshēng ma?",
              "english": "Hello, are you a new student?",
              "teaching_note": "Revised to exemplify the headword naturally using vocabulary from HSK 3.0 Levels 1–2."
            },
            {
              "id": "ex-0146-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "你可以在这里看书。",
              "pinyin": "nǐ kěyǐ zài zhèlǐ kàn shū.",
              "english": "You can read books here.",
              "teaching_note": "Short beginner-level description illustrating 你 in context."
            }
          ],
          "learning_role": "reviewed",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 146
            }
          ]
        },
        {
          "id": "w-0200",
          "hanzi": "他",
          "pinyin": "tā",
          "meaning_en": "he",
          "primary_pos_id": "pronoun",
          "pos_ids": [
            "pronoun"
          ],
          "primary_topic_id": "reference-questions",
          "topic_ids": [
            "reference-questions"
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "examples": [
            {
              "id": "ex-0200-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "他是我的哥哥。",
              "pinyin": "tā shì wǒ de gēge.",
              "english": "He is my older brother.",
              "teaching_note": "他 is the third-person pronoun for a male person; 哥哥 is older brother."
            },
            {
              "id": "ex-0200-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "他每天坐火车上班。",
              "pinyin": "tā měitiān zuò huǒchē shàngbān.",
              "english": "He takes the train to work every day.",
              "teaching_note": "Short beginner-level description illustrating 他 in context."
            }
          ],
          "learning_role": "reviewed",
