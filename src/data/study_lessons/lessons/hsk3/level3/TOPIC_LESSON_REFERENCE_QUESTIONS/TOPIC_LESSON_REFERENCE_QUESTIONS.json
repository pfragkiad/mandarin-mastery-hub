      "questions": [
        {
          "id": "applied-reading",
          "kind": "comprehension",
          "prompt": "In the reading passage, why does Xiao Wang ask 怎么办?",
          "choices": [],
          "correct_choice_ids": [],
          "answer": "He wants to know what they will do if it rains on the weekend.",
          "explanation": "Xiao Wang asks 要是周末下雨怎么办？"
        },
        {
          "id": "applied-production",
          "kind": "production",
          "prompt": "Write one suggestion using 咱们 and one question using 别的 or 其他.",
          "choices": [],
          "correct_choice_ids": [],
          "answer": "咱们换一家饭馆吧，这家没有别的菜了吗？",
          "explanation": "Combine 咱们 for a shared suggestion with 别的/其他 for alternatives."
        },
        {
          "id": "recall-1",
          "kind": "selection",
          "prompt": "Which pronoun specifically includes the listener?",
          "choices": [
            {
              "id": "a",
              "hanzi": "咱们",
              "pinyin": "zánmen",
              "meaning_en": "we (inclusive)"
            },
            {
              "id": "b",
              "hanzi": "别的",
              "pinyin": "biéde",
              "meaning_en": "other"
            },
            {
              "id": "c",
              "hanzi": "其他",
              "pinyin": "qítā",
              "meaning_en": "others"
            }
          ],
          "correct_choice_ids": [
            "a"
          ],
          "explanation": "咱们 includes both the speaker and the listener."
        },
        {
          "id": "recall-2",
          "kind": "selection",
          "prompt": "Which expression asks \"what should we do?\"",
          "choices": [
