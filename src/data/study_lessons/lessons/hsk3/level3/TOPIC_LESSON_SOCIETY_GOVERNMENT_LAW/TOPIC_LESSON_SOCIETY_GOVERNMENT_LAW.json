    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Heading Home Late",
        "context_en": "Two friends say goodbye after dinner and remind each other to get home safely.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "天黑了，你一个人骑车回家安全吗？",
            "pinyin": "Tiān hēi le, nǐ yí ge rén qí chē huí jiā ānquán ma?",
            "english": "It’s dark—is it safe for you to ride your bike home alone?"
          },
          {
            "speaker": "B",
            "hanzi": "放心吧，这条路晚上灯很亮，非常安全。",
            "pinyin": "Fàngxīn ba, zhè tiáo lù wǎnshang dēng hěn liàng, fēicháng ānquán.",
            "english": "Don’t worry, the lights on this road are bright at night—it’s very safe."
          },
          {
            "speaker": "A",
            "hanzi": "那就好，过马路的时候还是要注意安全。",
            "pinyin": "Nà jiù hǎo, guò mǎlù de shíhou háishi yào zhùyì ānquán.",
            "english": "That’s good; still, be careful about safety when crossing the street."
          },
          {
            "speaker": "B",
            "hanzi": "好的，我安全到家以后给你发消息。",
            "pinyin": "Hǎode, wǒ ānquán dào jiā yǐhòu gěi nǐ fā xiāoxi.",
            "english": "Okay, I’ll send you a message after I get home safely."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Reminding someone to stay safe",
          "explanation_en": "注意安全 (zhùyì ānquán) is the standard everyday expression for \"be careful / stay safe\".",
          "pattern_hanzi": "<Activity> + 要注意安全",
          "pattern_pinyin": "<Activity> + yào zhùyì ānquán",
          "pattern_pseudo_translation": "<Activity> + need pay attention to safety",
          "examples": [
            {
              "hanzi": "下雨天开车，大家一定要注意安全。",
              "pinyin": "Xià yǔ tiān kāichē, dàjiā yídìng yào zhùyì ānquán.",
              "english": "When driving on rainy days, everyone must pay attention to safety."
            },
            {
              "hanzi": "孩子在公园玩儿时，家长要注意安全。",
              "pinyin": "Háizi zài gōngyuán wánr shí, jiāzhǎng yào zhùyì ānquán.",
              "english": "When children play in the park, parents should watch out for safety."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Doing something safely",
          "explanation_en": "Place 安全 before a verb like 到家 or 到达 to mean arriving safely.",
          "pattern_hanzi": "<Subject> + 安全 + <Verb>",
          "pattern_pinyin": "<Subject> + ānquán + <Verb>",
          "pattern_pseudo_translation": "<Subject> + safely + <Verb>",
          "examples": [
            {
              "hanzi": "飞机已经安全降落了。",
              "pinyin": "Fēijī yǐjīng ānquán jiàngluò le.",
              "english": "The plane has already landed safely."
            },
            {
              "hanzi": "坐地铁上班既快又安全。",
              "pinyin": "Zuò dìtiě shàngbān jì kuài yòu ānquán.",
              "english": "Taking the subway to work is both fast and safe."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Use 安全 as a noun, adjective, and adverb.",
        "model": {
          "hanzi": "这个小区晚上很安全。",
          "pinyin": "Zhège xiǎoqū wǎnshang hěn ānquán.",
          "english": "This neighborhood is very safe at night."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Remind a friend who is traveling to stay safe.",
            "model_answer": {
              "hanzi": "你路上一定要注意安全！",
              "pinyin": "Nǐ lùshang yídìng yào zhùyì ānquán!",
              "english": "Be sure to stay safe on the road!"
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say everyone arrived home safely.",
            "model_answer": {
              "hanzi": "大家都安全到家了。",
              "pinyin": "Dàjiā dōu ānquán dào jiā le.",
              "english": "Everyone arrived home safely."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say swimming in a deep river is not safe.",
            "model_answer": {
              "hanzi": "在很深的河里游泳不安全。",
              "pinyin": "Zài hěn shēn de hé lǐ yóuyǒng bù ānquán.",
              "english": "Swimming in a very deep river is not safe."
            }
          }
        ]
      },
      "reading": {
        "title": "School Safety Day",
        "paragraphs": [
          {
            "hanzi": "今天是学校的“安全日”，老师给大家讲了交通安全和网络安全。",
            "pinyin": "Jīntiān shì xuéxiào de “Ānquán Rì”, lǎoshī gěi dàjiā jiǎng le jiāotōng ānquán hé wǎngluò ānquán.",
            "english": "Today is the school’s “Safety Day,” and the teacher talked to everyone about traffic safety and internet safety."
          },
          {
            "hanzi": "同学们学到：过马路要看红绿灯，上网不要随便告诉别人自己的信息，这样才更安全。",
            "pinyin": "Tóngxuémen xuédào: guò mǎlù yào kàn hóng-lǜdēng, shàngwǎng búyào suíbiàn gàosu biérén zìjǐ de xìnxī, zhèyàng cái gèng ānquán.",
            "english": "The students learned: watch the traffic lights when crossing the street, and don’t casually tell others your personal information online—that way you’re safer."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "What two kinds of safety did the teacher talk about?",
            "answer_en": "Traffic safety and internet safety."
          },
          {
            "id": "reading-2",
            "prompt_en": "What should students avoid doing online?",
            "answer_en": "Casually telling others their personal information."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Say goodbye to a friend who is about to ride a bike or drive.",
          "model_answer": {
            "hanzi": "路上慢点儿，注意安全，到了告诉我一声。",
            "pinyin": "Lùshang màn diǎnr, zhùyì ānquán, dào le gàosu wǒ yì shēng.",
            "english": "Take it slow on the road, stay safe, and let me know when you arrive."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Say one place or habit that you think is very safe.",
          "model_answer": {
            "hanzi": "坐高铁去别的城市既舒服又安全。",
            "pinyin": "Zuò gāotiě qù biéde chéngshì jì shūfu yòu ānquán.",
            "english": "Taking the high-speed train to another city is both comfortable and safe."
          }
        }
      ],
      "common_pitfall": "Use 很安全 to describe something that is safe; do not say *是安全 without 的.",
      "pronunciation_focus": "安全 (ānquán) pairs a flat first tone ān with a rising second tone quán.",
      "review": {
        "can_do": [
          "Use 安全 as an adjective, noun, and adverb.",
          "Remind someone with 注意安全."
        ],
        "entry_ids": [
          505
        ]
      }
    }
