    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Reading an E-Book on the Train",
        "context_en": "Linlin asks her friend about the headphones and e-book he is using.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你戴着耳机在听什么呢？",
            "pinyin": "Nǐ dài zhe ěrjī zài tīng shénme ne?",
            "english": "What are you listening to with your headphones?"
          },
          {
            "speaker": "B",
            "hanzi": "我在听一本电子书的录音，这个网站上的资源很多。",
            "pinyin": "Wǒ zài tīng yì běn diànzǐshū de lùyīn, zhège wǎngzhàn shàng de zīyuán hěn duō.",
            "english": "I’m listening to the audio of an e-book; this website has lots of resources."
          },
          {
            "speaker": "A",
            "hanzi": "真不错！我的手机刚才没电关机了，正准备充电呢。",
            "pinyin": "Zhēn búcuò! Wǒ de shǒujī gāngcái méi diàn guānjī le, zhèng zhǔnbèi chōngdiàn ne.",
            "english": "Nice! My phone just ran out of battery and shut off, so I’m about to charge it."
          },
          {
            "speaker": "B",
            "hanzi": "充一会儿再开机吧，我有充电宝。",
            "pinyin": "Chōng yíhuìr zài kāijī ba, wǒ yǒu chōngdiànbǎo.",
            "english": "Charge it for a bit before turning it back on—I have a power bank."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Saying a device has no power",
          "explanation_en": "Use 没电了 (méi diàn le) after a device name to say its battery is dead or there is no electricity.",
          "pattern_hanzi": "<Device> + 没电了",
          "pattern_pinyin": "<Device> + méi diàn le",
          "pattern_pseudo_translation": "<Device> + has no electricity (now)",
          "examples": [
            {
              "hanzi": "我的耳机没电了，听不见声音。",
              "pinyin": "Wǒ de ěrjī méi diàn le, tīng bu jiàn shēngyīn.",
              "english": "My headphones ran out of battery; I can’t hear any sound."
            },
            {
              "hanzi": "电脑突然没电关机了。",
              "pinyin": "Diànnǎo tūrán méi diàn guānjī le.",
              "english": "The computer suddenly ran out of power and shut off."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Turning a device on or off",
          "explanation_en": "开机 (kāijī) and 关机 (guānjī) mean powering a device on or off; they usually stand without a separate object.",
          "pattern_hanzi": "把 + <Device> + 开机 / 关机",
          "pattern_pinyin": "bǎ + <Device> + kāijī / guānjī",
          "pattern_pseudo_translation": "take + <Device> + power on / power off",
          "examples": [
            {
              "hanzi": "请把手机关机，电影马上开始了。",
              "pinyin": "Qǐng bǎ shǒujī guānjī, diànyǐng mǎshàng kāishǐ le.",
              "english": "Please turn off your phone; the movie is about to start."
            },
            {
              "hanzi": "我早上到办公室以后才开机。",
              "pinyin": "Wǒ zǎoshang dào bàngōngshì yǐhòu cái kāijī.",
              "english": "I only turn on my computer after arriving at the office in the morning."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Talk about digital reading, headphones, and websites.",
        "model": {
          "hanzi": "我喜欢在这个网站上看电子书。",
          "pinyin": "Wǒ xǐhuan zài zhège wǎngzhàn shàng kàn diànzǐshū.",
          "english": "I like reading e-books on this website."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Say you wear headphones when studying in the library.",
            "model_answer": {
              "hanzi": "我在图书馆学习的时候会戴耳机。",
              "pinyin": "Wǒ zài túshūguǎn xuéxí de shíhou huì dài ěrjī.",
              "english": "I wear headphones when studying in the library."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say the plane is about to take off, so please power off.",
            "model_answer": {
              "hanzi": "飞机要起飞了，请大家关机。",
              "pinyin": "Fēijī yào qǐfēi le, qǐng dàjiā guānjī.",
              "english": "The plane is about to take off; please power off your devices."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say this website is very useful for learning Chinese.",
            "model_answer": {
              "hanzi": "这个网站对学汉语很有用。",
              "pinyin": "Zhège wǎngzhàn duì xué Hànyǔ hěn yǒuyòng.",
              "english": "This website is very useful for learning Chinese."
            }
          }
        ]
      },
      "reading": {
        "title": "Digital Study Habits",
        "paragraphs": [
          {
            "hanzi": "现在很多学生喜欢用电脑或手机看电子书，因为带起来很轻，找词也很快。",
            "pinyin": "Xiànzài hěn duō xuéshēng xǐhuan yòng diànnǎo huò shǒujī kàn diànzǐshū, yīnwèi dài qǐlái hěn qīng, zhǎo cí yě hěn kuài.",
            "english": "Nowadays many students like using a computer or phone to read e-books, because they are light to carry and quick for looking up words."
          },
          {
            "hanzi": "不过晚上休息以前，最好早点儿把手机关机，这样睡得更好。",
            "pinyin": "Búguò wǎnshang xiūxi yǐqián, zuìhǎo zǎodiǎnr bǎ shǒujī guānjī, zhèyàng shuì de gèng hǎo.",
            "english": "However, before resting at night, it is best to turn off your phone a little earlier so you sleep better."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "Why do many students like reading e-books?",
            "answer_en": "Because they are light to carry and quick for looking up words."
          },
          {
            "id": "reading-2",
            "prompt_en": "What advice does the passage give before sleeping?",
            "answer_en": "Turn off your phone earlier at night."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Say whether you prefer paper books or 电子书, and why.",
          "model_answer": {
            "hanzi": "出门的时候我喜欢看电子书，因为很方便。",
            "pinyin": "Chūmén de shíhou wǒ xǐhuan kàn diànzǐshū, yīnwèi hěn fāngbiàn.",
            "english": "When going out I like reading e-books because it is very convenient."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Explain when you use 耳机 or visit a useful 网站.",
          "model_answer": {
            "hanzi": "坐地铁的时候我常常戴耳机听音乐。",
            "pinyin": "Zuò dìtiě de shíhou wǒ chángcháng dài ěrjī tīng yīnyuè.",
            "english": "When taking the subway I often wear headphones to listen to music."
          }
        }
      ],
      "common_pitfall": "Do not say *关机手机 (*guānjī shǒujī). Since 机 already means \"device\", say 把手机关机 or 关掉手机.",
      "pronunciation_focus": "耳机 (ěrjī) starts with the retroflex third-tone ěr followed by high first-tone jī.",
      "review": {
        "can_do": [
          "Say a device is out of battery with 没电了.",
          "Use 开机 and 关机 naturally.",
          "Talk about e-books, headphones, and websites."
        ],
