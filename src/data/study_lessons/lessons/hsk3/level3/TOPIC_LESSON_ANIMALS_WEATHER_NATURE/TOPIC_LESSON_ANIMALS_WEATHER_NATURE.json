    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "A View from the Mountain",
        "context_en": "Two friends hike up a hill and enjoy the scenery at sunset.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你看山下那条河，一直流到东边的大海里。",
            "pinyin": "Nǐ kàn shānxià nà tiáo hé, yìzhí liú dào dōngbiān de dà hǎi lǐ.",
            "english": "Look at that river below the mountain—it flows all the way into the sea in the east."
          },
          {
            "speaker": "B",
            "hanzi": "这里的环境真好！山上有树，还有一大片绿色的草地。",
            "pinyin": "Zhèlǐ de huánjìng zhēn hǎo! Shānshàng yǒu shù, hái yǒu yí dà piàn lǜsè de cǎodì.",
            "english": "The environment here is wonderful! There are trees on the mountain and a huge green lawn."
          },
          {
            "speaker": "A",
            "hanzi": "春天的时候，路边的树还会开花呢。",
            "pinyin": "Chūntiān de shíhou, lùbiān de shù hái huì kāihuā ne.",
            "english": "In spring, the trees along the road even bloom!"
          },
          {
            "speaker": "B",
            "hanzi": "太阳快下山了，一会儿月亮就要出来了。",
            "pinyin": "Tàiyáng kuài xiàshān le, yíhuìr yuèliang jiù yào chūlái le.",
            "english": "The sun is about to set behind the mountains, and soon the moon will come out."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Protecting the environment",
          "explanation_en": "环境 (huánjìng) refers to both the natural environment and living surroundings; pair it with 保护 (protect) or 好.",
          "pattern_hanzi": "<Place> + 的 + 环境 + 很 + 好 / 干净",
          "pattern_pinyin": "<Place> + de + huánjìng + hěn + hǎo / gānjìng",
          "pattern_pseudo_translation": "<Place> + ’s + environment + very + good / clean",
          "examples": [
            {
              "hanzi": "这片海边的环境非常干净。",
              "pinyin": "Zhè piàn hǎibiān de huánjìng fēicháng gānjìng.",
              "english": "The environment at this seaside is very clean."
            },
            {
              "hanzi": "大家一起努力，这里的环境变得越来越好了。",
              "pinyin": "Dàjiā yìqǐ nǔlì, zhèlǐ de huánjìng biàn de yuèláiyuè hǎo le.",
              "english": "Everyone worked hard together, and the environment here became better and better."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Counting trees, rivers, and grass",
          "explanation_en": "Use 棵 (kē) for trees, 条 (tiáo) for rivers, and 座 (zuò) for mountains.",
          "pattern_hanzi": "一 + 座山 / 条河 / 棵树",
          "pattern_pinyin": "yí + zuò shān / tiáo hé / kē shù",
          "pattern_pseudo_translation": "one + mountain / river / tree",
          "examples": [
            {
              "hanzi": "河边种着很多高大的树。",
              "pinyin": "Hébiān zhòng zhe hěn duō gāodà de shù.",
              "english": "Many tall trees are planted along the river."
            },
            {
              "hanzi": "周末我们去爬那座山吧。",
              "pinyin": "Zhōumò wǒmen qù pá nà zuò shān ba.",
              "english": "Let’s go climb that mountain this weekend."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Describe natural scenes with sun, moon, plants, and water.",
        "model": {
          "hanzi": "太阳出来了，草地上的露水闪闪发光。",
          "pinyin": "Tàiyáng chūlái le, cǎodì shàng de lùshuǐ shǎnshǎn fāguāng.",
          "english": "The sun came out, and the dew on the grass sparkled."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Say tonight’s moon is very round and bright.",
            "model_answer": {
              "hanzi": "今晚的月亮又圆又亮。",
              "pinyin": "Jīnwǎn de yuèliang yòu yuán yòu liàng.",
              "english": "Tonight’s moon is both round and bright."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say don’t step on the grass.",
            "model_answer": {
              "hanzi": "请爱护小草，不要踩草地。",
              "pinyin": "Qǐng àihù xiǎocǎo, búyào cǎi cǎodì.",
              "english": "Please care for the grass and don’t step on the lawn."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say you want to go see the sea in summer.",
            "model_answer": {
              "hanzi": "夏天我想去海边看大海。",
              "pinyin": "Xiàtiān wǒ xiǎng qù hǎibiān kàn dàhǎi.",
              "english": "In summer I want to go to the beach to see the sea."
            }
          }
        ]
      },
      "reading": {
        "title": "Green Mountains and Clear Water",
        "paragraphs": [
          {
            "hanzi": "我的家乡有山有水，村子前面是一条清澈的小河，后面是一座绿油油的大山。",
            "pinyin": "Wǒ de jiāxiāng yǒu shān yǒu shuǐ, cūnzi qiánmiàn shì yì tiáo qīngchè de xiǎo hé, hòumiàn shì yí zuò lǜyóuyóu de dà shān.",
            "english": "My hometown has mountains and water: in front of the village is a clear little river, and behind is a lush green mountain."
          },
          {
            "hanzi": "每年春天，树枝上长出新叶，草地上的野花也开花了。大家都很爱护这里的自然环境。",
            "pinyin": "Měi nián chūntiān, shùzhī shàng zhǎng chū xīn yè, cǎodì shàng de yěhuā yě kāihuā le. Dàjiā dōu hěn àihù zhèlǐ de zìrán huánjìng.",
            "english": "Every spring, new leaves grow on the tree branches, and the wildflowers on the meadow bloom too. Everyone takes great care of the natural environment here."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "What is in front of and behind the village?",
            "answer_en": "A clear little river in front, and a green mountain behind."
          },
          {
            "id": "reading-2",
            "prompt_en": "What happens in spring in the village?",
            "answer_en": "New leaves grow on the trees and wildflowers bloom on the meadow."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Describe a natural place you visited using 山, 河, 海, or 草地.",
          "model_answer": {
            "hanzi": "我去过一个海边城市，那里的海很蓝，环境也特别好。",
            "pinyin": "Wǒ qù guò yí ge hǎibiān chéngshì, nàlǐ de hǎi hěn lán, huánjìng yě tèbié hǎo.",
            "english": "I’ve been to a seaside city; the sea there is very blue and the environment is great."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Say what you like about spring nature using 树 and 开花.",
          "model_answer": {
            "hanzi": "春天太阳暖洋洋的，很多树都开花了，非常好看。",
            "pinyin": "Chūntiān tàiyáng nuǎnyángyáng de, hěn duō shù dōu kāihuā le, fēicháng hǎokàn.",
            "english": "In spring the sun is warm and many trees bloom—it’s very pretty."
          }
        }
      ],
      "common_pitfall": "开花 is a separable verb (\"to bloom / blossom\"): say 花开了 (\"the flowers bloomed\") or 树开花了 (\"the trees bloomed\"), not *开花花.",
      "pronunciation_focus": "月亮 (yuèliang) ends with neutral-tone liang; 环境 (huánjìng) moves from second tone to fourth tone.",
      "review": {
        "can_do": [
          "Name landforms and water: 山, 河, 海.",
          "Name plants and sky: 草, 草地, 树, 开花, 太阳, 月亮.",
          "Talk about protecting the environment."
        ],
