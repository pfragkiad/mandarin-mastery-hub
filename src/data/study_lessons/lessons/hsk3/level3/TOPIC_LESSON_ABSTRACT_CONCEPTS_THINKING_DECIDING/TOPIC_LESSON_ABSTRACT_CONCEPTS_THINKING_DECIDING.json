    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Solving a Study Problem",
        "context_en": "Two classmates discuss how to improve and decide on a study method.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "我记生词总是记不住，你有什么好办法吗？",
            "pinyin": "Wǒ jì shēngcí zǒngshì jì bú zhù, nǐ yǒu shénme hǎo bànfǎ ma?",
            "english": "I can never remember new words—do you have a good way to handle this?"
          },
          {
            "speaker": "B",
            "hanzi": "我认为主要的问题是光背不造句。你得换一个学习方法。",
            "pinyin": "Wǒ rènwéi zhǔyào de wèntí shì guāng bèi bú zàojù. Nǐ děi huàn yí ge xuéxí fāngfǎ.",
            "english": "I think the main problem is memorizing without making sentences. You have to switch to a different study method."
          },
          {
            "speaker": "A",
            "hanzi": "我明白了！如果我有机会多和中国人聊天，也能更快解决这个难题。",
            "pinyin": "Wǒ míngbai le! Rúguǒ wǒ yǒu jīhuì duō hé Zhōngguórén liáotiān, yě néng gèng kuài jiějué zhège nántí.",
            "english": "I understand! If I have the chance to chat more with Chinese speakers, I can solve this hard problem faster too."
          },
          {
            "speaker": "B",
            "hanzi": "对，你已经决定这样做了，就选每天晚饭后练习二十分钟吧。",
            "pinyin": "Duì, nǐ yǐjīng juédìng zhèyàng zuò le, jiù xuǎn měitiān wǎnfàn hòu liànxí èrshí fēnzhōng ba.",
            "english": "Right—now that you’ve decided to do that, choose to practice for twenty minutes after dinner every day."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Sharing an opinion with 认为",
          "explanation_en": "Use <Person> + 认为 + <Clause> to state what someone thinks or believes.",
          "pattern_hanzi": "<Person> + 认为 + <Opinion Clause>",
          "pattern_pinyin": "<Person> + rènwéi + <Opinion Clause>",
          "pattern_pseudo_translation": "<Person> + thinks/believes + <Opinion Clause>",
          "examples": [
            {
              "hanzi": "老师认为每天朗读课文很有帮助。",
              "pinyin": "Lǎoshī rènwéi měitiān lǎngdú kèwén hěn yǒu bāngzhù.",
              "english": "The teacher thinks reading the lesson text aloud every day is very helpful."
            },
            {
              "hanzi": "很多人认为早睡早起对身体更好。",
              "pinyin": "Hěn duō rén rènwéi zǎo shuì zǎo qǐ duì shēntǐ gèng hǎo.",
              "english": "Many people believe going to bed early and waking early is better for health."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Solving a problem with 解决",
          "explanation_en": "Pair 解决 (jiějué) with 问题 (problem), 难题 (hard problem), or 办法.",
          "pattern_hanzi": "解决 + <Problem / Difficulty>",
          "pattern_pinyin": "jiějué + <Problem / Difficulty>",
          "pattern_pseudo_translation": "solve + <Problem / Difficulty>",
          "examples": [
            {
              "hanzi": "他们很快找到了解决问题的办法。",
              "pinyin": "Tāmen hěn kuài zhǎodào le jiějué wèntí de bànfǎ.",
              "english": "They quickly found a way to solve the problem."
            },
            {
              "hanzi": "这件事我已经想办法解决了。",
              "pinyin": "Zhè jiàn shì wǒ yǐjīng xiǎng bànfǎ jiějué le.",
              "english": "I have already figured out a way to resolve this matter."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Discuss decisions, choices, and understanding.",
        "model": {
          "hanzi": "她决定抓住这次去留学的机会。",
          "pinyin": "Tā juédìng zhuāzhù zhè cì qù liúxué de jīhuì.",
          "english": "She decided to seize this opportunity to study abroad."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Say you want to get to know Chinese history better.",
            "model_answer": {
              "hanzi": "我想多了解一点儿中国历史。",
              "pinyin": "Wǒ xiǎng duō liǎojiě yìdiǎnr Zhōngguó lìshǐ.",
              "english": "I want to learn more about Chinese history."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say he finally understood his parents’ care.",
            "model_answer": {
              "hanzi": "他终于懂得了父母的关心。",
              "pinyin": "Tā zhōngyú dǒngde le fùmǔ de guānxīn.",
              "english": "He finally came to understand his parents’ care."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say this is an important choice.",
            "model_answer": {
              "hanzi": "这是一个很重要的选择。",
              "pinyin": "Zhè shì yí ge hěn zhòngyào de xuǎnzé.",
              "english": "This is a very important choice."
            }
          }
        ]
      },
      "reading": {
        "title": "Making a New Choice",
        "paragraphs": [
          {
            "hanzi": "大学毕业以后，小周面临两个选择：一是留在北京工作，二是回老家帮家里办一家小店。",
            "pinyin": "Dàxué bìyè yǐhòu, Xiǎo Zhōu miànlín liǎng ge xuǎnzé: yī shì liú zài Běijīng gōngzuò, èr shì huí lǎojiā bāng jiālǐ bàn yì jiā xiǎo diàn.",
            "english": "After graduating from university, Xiao Zhou faced two choices: one was staying in Beijing to work, and the other was returning to his hometown to help his family run a small shop."
          },
          {
            "hanzi": "他先了解了两边的情况，又和父母商量了半天，最后决定先回老家试试。他认为只要方法对，在哪里都有发展的机会。",
            "pinyin": "Tā xiān liǎojiě le liǎngbiān de qíngkuàng, yòu hé fùmǔ shāngliang le bàntiān, zuìhòu juédìng xiān huí lǎojiā shìshi. Tā rènwéi zhǐyào fāngfǎ duì, zài nǎlǐ dōu yǒu fāzhǎn de jīhuì.",
            "english": "He first learned about the situation on both sides, discussed it with his parents for a long time, and finally decided to try returning home first. He believes that as long as the method is right, there are opportunities to develop anywhere."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "What two choices did Xiao Zhou face after graduation?",
            "answer_en": "Staying in Beijing to work or returning to his hometown to help run a family shop."
          },
          {
            "id": "reading-2",
            "prompt_en": "What does Xiao Zhou believe about opportunities?",
            "answer_en": "As long as the method is right, there are opportunities to develop anywhere."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Share an opinion about learning Chinese using 认为 and 方法.",
          "model_answer": {
            "hanzi": "我认为学汉语最好的方法是每天坚持听和说。",
            "pinyin": "Wǒ rènwéi xué Hànyǔ zuì hǎo de fāngfǎ shì měitiān jiānchí tīng hé shuō.",
            "english": "I think the best method for learning Chinese is sticking to listening and speaking every day."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Talk about a decision you made using 决定 or 选择.",
          "model_answer": {
            "hanzi": "今年我决定每天早起锻炼，这是个不错的选择。",
            "pinyin": "Jīnnián wǒ juédìng měitiān zǎoqǐ duànliàn, zhè shì ge búcuò de xuǎnzé.",
            "english": "This year I decided to wake up early every day to exercise—it’s a great choice."
          }
        }
      ],
      "common_pitfall": "了解 means to understand/know about a person, situation, or subject in depth; 明白 means to grasp/get the meaning of what someone just said.",
      "pronunciation_focus": "解决 (jiějué) moves from third tone to second tone; 决定 (juédìng) moves from second tone to fourth tone.",
