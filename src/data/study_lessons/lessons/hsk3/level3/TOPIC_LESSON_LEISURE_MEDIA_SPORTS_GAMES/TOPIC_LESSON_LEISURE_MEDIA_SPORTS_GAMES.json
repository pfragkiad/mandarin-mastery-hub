    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "After-Work Badminton",
        "context_en": "Two friends make plans to play badminton at the gym and talk about a school sports meet.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "下班以后咱们去体育馆打羽毛球吧？",
            "pinyin": "Xiàbān yǐhòu zánmen qù tǐyùguǎn dǎ yǔmáoqiú ba?",
            "english": "After work shall we go to the gym to play badminton?"
          },
          {
            "speaker": "B",
            "hanzi": "好啊！不过我最近也对网球很有兴趣，球场那边空着吗？",
            "pinyin": "Hǎo a! Búguò wǒ zuìjìn yě duì wǎngqiú hěn yǒu xìngqù, qiúchǎng nàbiān kōng zhe ma?",
            "english": "Sure! Though lately I’m also interested in tennis—is the court over there free?"
          },
          {
            "speaker": "A",
            "hanzi": "今天下午学校正在开运动会，球场可能有比赛。",
            "pinyin": "Jīntiān xiàwǔ xuéxiào zhèngzài kāi yùndònghuì, qiúchǎng kěnéng yǒu bǐsài.",
            "english": "The school is holding a sports meet this afternoon, so there might be a match on the court."
          },
          {
            "speaker": "B",
            "hanzi": "那咱们先去看比赛，看看哪个班得分最高！",
            "pinyin": "Nà zánmen xiān qù kàn bǐsài, kànkan nǎge bān défēn zuì gāo!",
            "english": "Then let’s go watch the match first and see which class scores the highest!"
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Playing racquet and ball sports with 打",
          "explanation_en": "Use 打 (dǎ) for sports played with hands or racquets (打羽毛球, 打网球).",
          "pattern_hanzi": "去 + <Venue> + 打 + 羽毛球 / 网球",
          "pattern_pinyin": "qù + <Venue> + dǎ + yǔmáoqiú / wǎngqiú",
          "pattern_pseudo_translation": "go + <Venue> + hit/play + badminton / tennis",
          "examples": [
            {
              "hanzi": "我每个星期六都和爸爸去球场打网球。",
              "pinyin": "Wǒ měi ge xīngqīliù dōu hé bàba qù qiúchǎng dǎ wǎngqiú.",
              "english": "Every Saturday I go to the court with my dad to play tennis."
            },
            {
              "hanzi": "她在大学时打羽毛球非常厉害。",
              "pinyin": "Tā zài dàxué shí dǎ yǔmáoqiú fēicháng lìhai.",
              "english": "She was very good at playing badminton in university."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Expressing interest with 有兴趣",
          "explanation_en": "Say 对 + topic + 有兴趣 (or 没兴趣) to express what interests you.",
          "pattern_hanzi": "<Subject> + 对 + <Topic> + 很 + 有兴趣",
          "pattern_pinyin": "<Subject> + duì + <Topic> + hěn + yǒu xìngqù",
          "pattern_pseudo_translation": "<Subject> + toward + <Topic> + very + have interest",
          "examples": [
            {
              "hanzi": "弟弟对体育比赛一直很有兴趣。",
              "pinyin": "Dìdi duì tǐyù bǐsài yìzhí hěn yǒu xìngqù.",
              "english": "My younger brother has always been very interested in sports matches."
            },
            {
              "hanzi": "你对这个新游戏有兴趣吗？",
              "pinyin": "Nǐ duì zhège xīn yóuxì yǒu xìngqù ma?",
              "english": "Are you interested in this new game?"
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Talk about sports meets, games, and weekend recreation.",
        "model": {
          "hanzi": "运动会上，我们班的运动员得分最多。",
          "pinyin": "Yùndònghuì shàng, wǒmen bān de yùndòngyuán défēn zuì duō.",
          "english": "At the sports meet, our class’s athletes scored the most points."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Say you like playing fun games with friends.",
            "model_answer": {
              "hanzi": "周末我喜欢和朋友一起玩儿有趣的游戏。",
              "pinyin": "Zhōumò wǒ xǐhuan hé péngyou yìqǐ wánr yǒuqù de yóuxì.",
              "english": "On weekends I like playing fun games with friends."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say the students went to the zoo on Friday.",
            "model_answer": {
              "hanzi": "星期五同学们一起去动物园玩儿了。",
              "pinyin": "Xīngqīwǔ tóngxuémen yìqǐ qù dòngwùyuán wánr le.",
              "english": "On Friday the classmates went to the zoo together."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say there is a basketball match in the gym tonight.",
            "model_answer": {
              "hanzi": "今天晚上体育馆里有一场篮球比赛。",
              "pinyin": "Jīntiān wǎnshang tǐyùguǎn lǐ yǒu yì chǎng lánqiú bǐsài.",
              "english": "Tonight there is a basketball match in the gym."
            }
          }
        ]
      },
      "reading": {
        "title": "School Sports Meet",
        "paragraphs": [
          {
            "hanzi": "上星期五，我们学校举行了秋季运动会。早上八点，同学们都来到体育馆和旁边的球场。",
            "pinyin": "Shàng xīngqīwǔ, wǒmen xuéxiào jǔxíng le qiūjì yùndònghuì. Zǎoshang bā diǎn, tóngxuémen dōu láidào tǐyùguǎn hé pángbiān de qiúchǎng.",
            "english": "Last Friday, our school held the autumn sports meet. At 8 a.m., the students all came to the gym and the court beside it."
          },
          {
            "hanzi": "上午有羽毛球和网球比赛，下午还有趣味游戏。我们班的同学配合得很好，最后总得分排在第一名！",
            "pinyin": "Shàngwǔ yǒu yǔmáoqiú hé wǎngqiú bǐsài, xiàwǔ hái yǒu qùwèi yóuxì. Wǒmen bān de tóngxué pèihé de hěn hǎo, zuìhòu zǒng défēn pái zài dì-yī míng!",
            "english": "In the morning there were badminton and tennis matches, and in the afternoon fun games. Our classmates worked together well, and in the end our total score ranked first!"
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "What matches were held in the morning?",
            "answer_en": "Badminton and tennis matches."
          },
          {
            "id": "reading-2",
            "prompt_en": "How did the narrator’s class place in the total score?",
            "answer_en": "First place."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Say what sport or game you have an interest in using 有兴趣.",
          "model_answer": {
            "hanzi": "我对打羽毛球很有兴趣，每周都会去体育馆打一次。",
            "pinyin": "Wǒ duì dǎ yǔmáoqiú hěn yǒu xìngqù, měi zhōu dōu huì qù tǐyùguǎn dǎ yí cì.",
            "english": "I’m very interested in playing badminton and go to the gym once a week."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Talk about a match or sports event you watched or joined.",
          "model_answer": {
            "hanzi": "去年秋天我参加了学校的网球比赛，虽然没得第一，但是很开心。",
            "pinyin": "Qùnián qiūtiān wǒ cānjiā le xuéxiào de wǎngqiú bǐsài, suīrán méi dé dì-yī, dànshì hěn kāixīn.",
            "english": "Last autumn I joined the school tennis match; although I didn’t win first place, I was very happy."
          }
        }
      ],
      "common_pitfall": "Say 对……有兴趣 (or 对……感兴趣), using the preposition 对 before the thing you are interested in.",
      "pronunciation_focus": "羽毛球 (yǔmáoqiú) moves from third tone to second tone to second tone; 体育馆 (tǐyùguǎn) has third + fourth + third.",
      "review": {
        "can_do": [
          "Name sports, courts, and gyms.",
          "Talk about matches, scores, and sports meets.",
          "Express personal interests with 有兴趣."
        ],
