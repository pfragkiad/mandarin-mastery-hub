  "sections": {
    "overview": {
      "topic_description": "Conversational verbs for welcoming, chatting, helping, recognizing, and agreeing.",
      "focus": "Use 聊天儿 for casual chatting and 同意 / 不行 to agree or politely decline."
    },
    "vocabulary": {
