    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Catching Up Over Tea",
        "context_en": "Xiao Gao welcomes an old friend at a teahouse and offers to treat him.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "欢迎欢迎！好久不见，你还是老样子，我一眼就认得你。",
            "pinyin": "Huānyíng huānyíng! Hǎojiǔ bú jiàn, nǐ háishi lǎo yàngzi, wǒ yì yǎn jiù rènde nǐ.",
            "english": "Welcome! Long time no see—you still look the same, I recognized you at a glance."
          },
          {
            "speaker": "B",
            "hanzi": "谢谢！最近一直忙着工作，真想找个时间好好聊天儿。",
            "pinyin": "Xièxie! Zuìjìn yìzhí máng zhe gōngzuò, zhēn xiǎng zhǎo ge shíjiān hǎohāo liáotiānr.",
            "english": "Thanks! I’ve been busy with work lately and really wanted time for a good chat."
          },
          {
            "speaker": "A",
            "hanzi": "今天我请客，你想喝什么茶？别客气！",
            "pinyin": "Jīntiān wǒ qǐngkè, nǐ xiǎng hē shénme chá? Bié kèqi!",
            "english": "Today it’s my treat—what tea would you like? Don’t be shy!"
          },
          {
            "speaker": "B",
            "hanzi": "那可不行，上次也是你请的。不过要是你同意，下次一定让我请！",
            "pinyin": "Nà kě bùxíng, shàng cì yě shì nǐ qǐng de. Búguò yàoshi nǐ tóngyì, xià cì yídìng ràng wǒ qǐng!",
            "english": "No way, you treated last time too! If you agree, definitely let me treat next time!"
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Chatting about something",
          "explanation_en": "Use 和 + person + 聊 + topic (or 聊天儿 without a topic object) to talk about having a casual chat.",
          "pattern_hanzi": "<Person A> + 和 + <Person B> + 聊 + <Topic>",
          "pattern_pinyin": "<Person A> + hé + <Person B> + liáo + <Topic>",
          "pattern_pseudo_translation": "<Person A> + with + <Person B> + chat about + <Topic>",
          "examples": [
            {
              "hanzi": "我们常常在午饭的时候聊电影。",
              "pinyin": "Wǒmen chángcháng zài wǔfàn de shíhou liáo diànyǐng.",
              "english": "We often chat about movies during lunch."
            },
            {
              "hanzi": "爷爷喜欢和老朋友在树下聊天儿。",
              "pinyin": "Yéye xǐhuan hé lǎo péngyou zài shù xià liáotiānr.",
              "english": "Grandpa likes chatting with old friends under the tree."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Explaining or telling with 讲",
          "explanation_en": "讲 (jiǎng) means to explain, tell (a story), or speak about a subject.",
          "pattern_hanzi": "给 + <Listener> + 讲 + <Story / Point>",
          "pattern_pinyin": "gěi + <Listener> + jiǎng + <Story / Point>",
          "pattern_pseudo_translation": "for + <Listener> + tell/explain + <Story / Point>",
          "examples": [
            {
              "hanzi": "老师给我们讲了一个有趣的故事。",
              "pinyin": "Lǎoshī gěi wǒmen jiǎng le yí ge yǒuqù de gùshi.",
              "english": "The teacher told us an interesting story."
            },
            {
              "hanzi": "这个问题他讲得很清楚，我听懂了。",
              "pinyin": "Zhège wèntí tā jiǎng de hěn qīngchu, wǒ tīngdǒng le.",
              "english": "He explained this question very clearly, and I understood."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Practice welcoming, helping, answering, and agreeing.",
        "model": {
          "hanzi": "谢谢你回答了我的问题，很有帮助。",
          "pinyin": "Xièxie nǐ huídá le wǒ de wèntí, hěn yǒu bāngzhù.",
          "english": "Thank you for answering my question; it was very helpful."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Say everyone agreed to the new plan.",
            "model_answer": {
              "hanzi": "大家都同意这个新计划。",
              "pinyin": "Dàjiā dōu tóngyì zhège xīn jìhuà.",
              "english": "Everyone agreed to this new plan."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say you follow the school’s news.",
            "model_answer": {
              "hanzi": "我一直很关注学校的新闻。",
              "pinyin": "Wǒ yìzhí hěn guānzhù xuéxiào de xīnwén.",
              "english": "I always follow the school’s news."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say that won’t work because it is too late.",
            "model_answer": {
              "hanzi": "太晚了，那样做不行。",
              "pinyin": "Tài wǎn le, nàyàng zuò bùxíng.",
              "english": "It’s too late; doing it that way won’t work."
            }
          }
        ]
      },
      "reading": {
        "title": "A Helpful Study Partner",
        "paragraphs": [
          {
            "hanzi": "小美和小文是好朋友，她们每天下午都在图书馆一起练习汉语对话。",
            "pinyin": "Xiǎo Měi hé Xiǎo Wén shì hǎo péngyou, tāmen měitiān xiàwǔ dōu zài túshūguǎn yìqǐ liànxí Hànyǔ duìhuà.",
            "english": "Xiao Mei and Xiao Wen are good friends; every afternoon they practice Chinese dialogues together in the library."
          },
          {
            "hanzi": "小文中文很好，总是耐心地帮助小美回答各种问题。小美非常感谢她，说星期六一定要请客喝奶茶。",
            "pinyin": "Xiǎo Wén Zhōngwén hěn hǎo, zǒngshì nàixīn de bāngzhù Xiǎo Měi huídá gè zhǒng wèntí. Xiǎo Měi fēicháng gǎnxiè tā, shuō xīngqīliù yídìng yào qǐngkè hē nǎichá.",
            "english": "Xiao Wen’s Chinese is very good, and she always patiently helps Xiao Mei answer all kinds of questions. Xiao Mei is very grateful and says she will definitely treat her to milk tea on Saturday."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "What do Xiao Mei and Xiao Wen practice together every afternoon?",
            "answer_en": "Chinese dialogues in the library."
          },
          {
            "id": "reading-2",
            "prompt_en": "How does Xiao Mei plan to thank Xiao Wen on Saturday?",
            "answer_en": "By treating her to milk tea."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Offer to treat a friend and say why.",
          "model_answer": {
            "hanzi": "今天你帮了我这么多，晚上我请客吃饭吧！",
            "pinyin": "Jīntiān nǐ bāng le wǒ zhème duō, wǎnshang wǒ qǐngkè chīfàn ba!",
            "english": "You helped me so much today—let me treat you to dinner tonight!"
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Say who you like chatting with and what you talk about.",
          "model_answer": {
            "hanzi": "我喜欢和室友聊天儿，我们常聊学校的事情。",
            "pinyin": "Wǒ xǐhuan hé shìyǒu liáotiānr, wǒmen cháng liáo xuéxiào de shìqing.",
            "english": "I like chatting with my roommate; we often talk about school matters."
          }
        }
      ],
      "common_pitfall": "聊天儿 already contains the object 儿/天 (\"chat\"), so do not put a topic after it (*聊天儿电影 is wrong; say 聊电影 or 聊一聊电影).",
      "pronunciation_focus": "聊天儿 (liáotiānr) combines rising liáo with flat first-tone tiānr; 同意 (tóngyì) moves from rising tóng to falling yì.",
      "review": {
        "can_do": [
          "Welcome guests and offer to treat them.",
          "Use 聊 / 聊天儿 and 讲 properly.",
          "Agree or refuse with 同意 and 不行."
        ],
