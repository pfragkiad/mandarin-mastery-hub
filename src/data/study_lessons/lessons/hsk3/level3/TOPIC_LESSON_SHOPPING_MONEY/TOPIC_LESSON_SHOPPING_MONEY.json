    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "At the Bank and Shop",
        "context_en": "Xiao Ming needs to go to the bank before buying a train ticket.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "请问，附近有银行吗？我要去办一张银行卡。",
            "pinyin": "Qǐngwèn, fùjìn yǒu yínháng ma? Wǒ yào qù bàn yì zhāng yínhángkǎ.",
            "english": "Excuse me, is there a bank nearby? I need to get a bank card."
          },
          {
            "speaker": "B",
            "hanzi": "往前走两百米就有一家银行，很方便。",
            "pinyin": "Wǎng qián zǒu liǎng bǎi mǐ jiù yǒu yì jiā yínháng, hěn fāngbiàn.",
            "english": "Walk 200 meters ahead and there is a bank; it’s very convenient."
          },
          {
            "speaker": "A",
            "hanzi": "谢谢！对了，买票的时候可以用信用卡吗？",
            "pinyin": "Xièxie! Duìle, mǎi piào de shíhou kěyǐ yòng xìnyòngkǎ ma?",
            "english": "Thanks! By the way, can I use a credit card when buying tickets?"
          },
          {
            "speaker": "B",
            "hanzi": "可以，银行卡和信用卡都能用。",
            "pinyin": "Kěyǐ, yínhángkǎ hé xìnyòngkǎ dōu néng yòng.",
            "english": "Yes, both bank cards and credit cards can be used."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Using a card to pay",
          "explanation_en": "Use 用 (yòng) + card + verb (such as 付钱 or 买) to say how you pay.",
          "pattern_hanzi": "用 + 银行卡 / 信用卡 + <Action>",
          "pattern_pinyin": "yòng + yínhángkǎ / xìnyòngkǎ + <Action>",
          "pattern_pseudo_translation": "using + bank card / credit card + <Action>",
          "examples": [
            {
              "hanzi": "我习惯用银行卡买东西。",
              "pinyin": "Wǒ xíguàn yòng yínhángkǎ mǎi dōngxi.",
              "english": "I am used to using a bank card to buy things."
            },
            {
              "hanzi": "在酒店可以用信用卡付钱吗？",
              "pinyin": "Zài jiǔdiàn kěyǐ yòng xìnyòngkǎ fù qián ma?",
              "english": "Can I pay with a credit card at the hotel?"
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Applying for or getting a card at the bank",
          "explanation_en": "Use 办 (bàn) with 一张银行卡 / 信用卡 to mean applying for or setting up a card.",
          "pattern_hanzi": "去银行办 + 一张 + 银行卡 / 信用卡",
          "pattern_pinyin": "qù yínháng bàn + yì zhāng + yínhángkǎ / xìnyòngkǎ",
          "pattern_pseudo_translation": "go to bank handle + one sheet + bank card / credit card",
          "examples": [
            {
              "hanzi": "明天上午我要去银行办一张新卡。",
              "pinyin": "Míngtiān shàngwǔ wǒ yào qù yínháng bàn yì zhāng xīn kǎ.",
              "english": "Tomorrow morning I need to go to the bank to get a new card."
            },
            {
              "hanzi": "这家银行办信用卡很快。",
              "pinyin": "Zhè jiā yínháng bàn xìnyòngkǎ hěn kuài.",
              "english": "Applying for a credit card at this bank is very fast."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Ask about banks and card payments.",
        "model": {
          "hanzi": "我忘了带信用卡，可以用手机付钱吗？",
          "pinyin": "Wǒ wàng le dài xìnyòngkǎ, kěyǐ yòng shǒujī fù qián ma?",
          "english": "I forgot to bring my credit card; can I pay with my phone?"
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Ask where the nearest bank is.",
            "model_answer": {
              "hanzi": "请问，最近的银行在哪里？",
              "pinyin": "Qǐngwèn, zuìjìn de yínháng zài nǎlǐ?",
              "english": "Excuse me, where is the nearest bank?"
            }
