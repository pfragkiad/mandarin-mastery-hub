    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Meeting a New Classmate",
        "context_en": "Linlin tells her friend about a new classmate who just joined their art club.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "那个男生是谁？他来自哪里？",
            "pinyin": "Nàge nánshēng shì shéi? Tā láizì nǎlǐ?",
            "english": "Who is that male student? Where is he from?"
          },
          {
            "speaker": "B",
            "hanzi": "他叫小陈，在广州出生，现在住在北京。",
            "pinyin": "Tā jiào Xiǎo Chén, zài Guǎngzhōu chūshēng, xiànzài zhù zài Běijīng.",
            "english": "He is Xiao Chen; he was born in Guangzhou and lives in Beijing now."
          },
          {
            "speaker": "A",
            "hanzi": "他的头发很长，看起来像一位年轻画家。",
            "pinyin": "Tā de tóufa hěn cháng, kàn qǐlái xiàng yí wèi niánqīng huàjiā.",
            "english": "His hair is quite long; he looks like a young painter."
          },
          {
            "speaker": "B",
            "hanzi": "没错，而且他以前还是学校的运动员呢。",
            "pinyin": "Méicuò, érqiě tā yǐqián hái shì xuéxiào de yùndòngyuán ne.",
            "english": "That’s right, and he used to be a school athlete too."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Stating where someone is from",
          "explanation_en": "Place 来自 (láizì) before a city or country to say where a person originates.",
          "pattern_hanzi": "<Person> + 来自 + <Place>",
          "pattern_pinyin": "<Person> + láizì + <Place>",
          "pattern_pseudo_translation": "<Person> + comes from + <Place>",
          "examples": [
            {
              "hanzi": "那位女老师来自上海。",
              "pinyin": "Nà wèi nǚ lǎoshī láizì Shànghǎi.",
              "english": "That female teacher comes from Shanghai."
            },
            {
              "hanzi": "我们班的留学生来自不同的国家。",
              "pinyin": "Wǒmen bān de liúxuéshēng láizì bù tóng de guójiā.",
              "english": "The international students in our class come from different countries."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Talking about birthplace",
          "explanation_en": "Put 在 + place before 出生 (chūshēng) to state where someone was born.",
          "pattern_hanzi": "<Person> + 在 + <Place> + 出生",
          "pattern_pinyin": "<Person> + zài + <Place> + chūshēng",
          "pattern_pseudo_translation": "<Person> + at + <Place> + was born",
          "examples": [
            {
              "hanzi": "我妹妹在成都出生。",
              "pinyin": "Wǒ mèimei zài Chéngdū chūshēng.",
              "english": "My younger sister was born in Chengdu."
            },
            {
              "hanzi": "这位老人是在南京出生的。",
              "pinyin": "Zhè wèi lǎorén shì zài Nánjīng chūshēng de.",
              "english": "This elderly person was born in Nanjing."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Introduce someone by swapping in a new role, birthplace, or origin.",
        "model": {
          "hanzi": "我的朋友来自杭州，她是一位有名的画家。",
          "pinyin": "Wǒ de péngyou láizì Hángzhōu, tā shì yí wèi yǒumíng de huàjiā.",
          "english": "My friend comes from Hangzhou; she is a famous painter."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Say that the athlete was born in Qingdao.",
            "model_answer": {
              "hanzi": "那位运动员在青岛出生。",
              "pinyin": "Nà wèi yùndòngyuán zài Qīngdǎo chūshēng.",
              "english": "That athlete was born in Qingdao."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say that female student has very short hair.",
            "model_answer": {
              "hanzi": "那个女生的头发很短。",
              "pinyin": "Nàge nǚshēng de tóufa hěn duǎn.",
              "english": "That female student has very short hair."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say that adults should help elderly people.",
            "model_answer": {
              "hanzi": "大人应该多帮助老人。",
              "pinyin": "Dàren yīnggāi duō bāngzhù lǎorén.",
              "english": "Adults should help elderly people more."
            }
          }
        ]
      },
      "reading": {
        "title": "Our Community Center",
        "paragraphs": [
          {
            "hanzi": "我们社区的活动室每天都有很多人。早上，几位老人一起来这里喝茶、聊天。",
            "pinyin": "Wǒmen shèqū de huódòngshì měitiān dōu yǒu hěn duō rén. Zǎoshang, jǐ wèi lǎorén yìqǐ lái zhèlǐ hē chá, liáotiān.",
            "english": "Our community activity room has many people every day. In the morning, several elderly people come here together to drink tea and chat."
          },
          {
            "hanzi": "周末的时候，很多男生和女生也来参加活动，还有一位来自西安的画家教大家画画儿。",
            "pinyin": "Zhōumò de shíhou, hěn duō nánshēng hé nǚshēng yě lái cānjiā huódòng, hái yǒu yí wèi láizì Xī’ān de huàjiā jiāo dàjiā huà huàr.",
            "english": "On weekends, many boys and girls also come to join activities, and a painter from Xi’an teaches everyone to paint."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "Who comes to the community room in the morning?",
            "answer_en": "Several elderly people come to drink tea and chat."
          },
          {
            "id": "reading-2",
            "prompt_en": "Where is the painter who teaches on weekends from?",
            "answer_en": "The painter is from Xi’an."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Introduce a friend: say where they are from and what they do.",
          "model_answer": {
            "hanzi": "我的朋友小王来自武汉，他现在是一名游泳运动员。",
            "pinyin": "Wǒ de péngyou Xiǎo Wáng láizì Wǔhàn, tā xiànzài shì yì míng yóuyǒng yùndòngyuán.",
            "english": "My friend Xiao Wang comes from Wuhan, and he is a swimming athlete now."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Describe a family member or neighbor using 大人, 老人, or 头发.",
          "model_answer": {
            "hanzi": "我爷爷是一位老人，他的头发已经全白了。",
            "pinyin": "Wǒ yéye shì yí wèi lǎorén, tā de tóufa yǐjīng quán bái le.",
            "english": "My grandfather is an elderly person, and his hair is already completely white."
          }
        }
      ],
      "common_pitfall": "Use 男生 / 女生 for students or young people, and 男人 / 女人 for adult men and women in general. Calling a classmate 男人 sounds unnatural.",
      "pronunciation_focus": "头发 (tóufa) uses a neutral tone on the second syllable; 来自 (láizì) pairs a rising second tone with a falling fourth tone.",
      "review": {
        "can_do": [
          "State where someone was born or comes from.",
          "Distinguish student and adult gender terms.",
          "Describe hair and roles like 画家 and 运动员."
        ],
