    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Checking Email",
        "context_en": "Two colleagues check whether an important email has arrived.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "我刚才给你发了一封邮件，你收到了吗？",
            "pinyin": "Wǒ gāngcái gěi nǐ fā le yì fēng yóujiàn, nǐ shōudào le ma?",
            "english": "I just sent you an email—did you receive it?"
          },
          {
            "speaker": "B",
            "hanzi": "等一下，我看看邮箱……收到了！不过声音怎么这么小？",
            "pinyin": "Děng yíxià, wǒ kànkan yóuxiāng… shōudào le! Búguò shēngyīn zěnme zhème xiǎo?",
            "english": "Wait a moment, let me check my inbox… Got it! Though why is the audio so quiet?"
          },
          {
            "speaker": "A",
            "hanzi": "听说这个文件有点儿问题，你注意看后面的说明。",
            "pinyin": "Tīngshuō zhège wénjiàn yǒudiǎnr wèntí, nǐ zhùyì kàn hòumiàn de shuōmíng.",
            "english": "I heard there’s a slight issue with this file—pay attention to the instructions at the end."
          },
          {
            "speaker": "B",
            "hanzi": "行，我相信很快就能弄好，你放心吧。",
            "pinyin": "Xíng, wǒ xiāngxìn hěn kuài jiù néng nòng hǎo, nǐ fàngxīn ba.",
            "english": "Okay, I’m sure we can sort it out soon—don’t worry."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Sending and receiving messages",
          "explanation_en": "Use 给 + recipient + 发 + message to send, and 收到 + message to confirm receipt.",
          "pattern_hanzi": "给 + <Recipient> + 发 + 邮件 / 信",
          "pattern_pinyin": "gěi + <Recipient> + fā + yóujiàn / xìn",
          "pattern_pseudo_translation": "to + <Recipient> + send + email / letter",
          "examples": [
            {
              "hanzi": "请把你的邮箱地址发给我。",
              "pinyin": "Qǐng bǎ nǐ de yóuxiāng dìzhǐ fā gěi wǒ.",
              "english": "Please send your email address to me."
            },
            {
              "hanzi": "昨天我收到了哥哥寄来的一封信。",
              "pinyin": "Zuótiān wǒ shōudào le gēge jì lái de yì fēng xìn.",
              "english": "Yesterday I received a letter sent by my older brother."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Reporting what you heard with 听说",
          "explanation_en": "Place 听说 (tīngshuō) at the start of a clause to introduce something you heard from others.",
          "pattern_hanzi": "听说 + <Clause>",
          "pattern_pinyin": "tīngshuō + <Clause>",
          "pattern_pseudo_translation": "heard that + <Clause>",
          "examples": [
            {
              "hanzi": "听说下周学校要放假两天。",
              "pinyin": "Tīngshuō xià zhōu xuéxiào yào fàngjià liǎng tiān.",
              "english": "I heard the school will have two days off next week."
            },
            {
              "hanzi": "我听说那家店的蛋糕特别好吃。",
              "pinyin": "Wǒ tīngshuō nà jiā diàn de dàngāo tèbié hǎochī.",
              "english": "I heard that shop’s cake is especially delicious."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Practice emails, warnings, and agreeing.",
        "model": {
          "hanzi": "我已经把作业发到老师的邮箱里了。",
          "pinyin": "Wǒ yǐjīng bǎ zuòyè fā dào lǎoshī de yóuxiāng lǐ le.",
          "english": "I have already sent the homework to the teacher’s email inbox."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Remind someone to be careful on the stairs.",
            "model_answer": {
              "hanzi": "走楼梯的时候请小心。",
              "pinyin": "Zǒu lóutī de shíhou qǐng xiǎoxīn.",
              "english": "Please be careful when walking on the stairs."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say you believe what your friend said.",
            "model_answer": {
              "hanzi": "我相信我朋友说的话。",
              "pinyin": "Wǒ xiāngxìn wǒ péngyou shuō de huà.",
              "english": "I believe what my friend said."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say the sound outside is too loud.",
            "model_answer": {
              "hanzi": "外面的声音太大了，我听不见。",
              "pinyin": "Wàimiàn de shēngyīn tài dà le, wǒ tīng bu jiàn.",
              "english": "The noise outside is too loud; I can’t hear."
            }
          }
        ]
      },
      "reading": {
        "title": "A Letter from Afar",
        "paragraphs": [
          {
            "hanzi": "现在大家习惯用手机发邮件，很少写信了。不过上个月，小兰却收到了一封老同学写来的信。",
            "pinyin": "Xiànzài dàjiā xíguàn yòng shǒujī fā yóujiàn, hěn shǎo xiě xìn le. Búguò shàng ge yuè, Xiǎo Lán què shōudào le yì fēng lǎo tóngxué xiě lái de xìn.",
            "english": "Nowadays everyone is used to sending emails by phone and rarely writes letters. However, last month Xiao Lan received a letter from an old classmate."
          },
          {
            "hanzi": "信里说她听说小兰换了新工作，提醒她工作再忙也要注意身体。小兰看完非常感动。",
            "pinyin": "Xìn lǐ shuō tā tīngshuō Xiǎo Lán huàn le xīn gōngzuò, tíxǐng tā gōngzuò zài máng yě yào zhùyì shēntǐ. Xiǎo Lán kàn wán fēicháng gǎndòng.",
            "english": "The letter said she heard Xiao Lan changed to a new job, reminding her to take care of her health no matter how busy work gets. Xiao Lan was deeply moved after reading it."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "What did Xiao Lan receive last month?",
            "answer_en": "A letter written by an old classmate."
          },
          {
            "id": "reading-2",
            "prompt_en": "What did the classmate remind Xiao Lan to pay attention to?",
            "answer_en": "Her health (注意身体), even when busy with her new job."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Confirm that you received an email and say it is okay.",
          "model_answer": {
            "hanzi": "你的邮件我收到了，时间安排很行，没问题。",
            "pinyin": "Nǐ de yóujiàn wǒ shōudào le, shíjiān ānpái hěn xíng, méi wèntí.",
            "english": "I received your email; the schedule works fine, no problem."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Give a friend a reminder using 注意 or 小心.",
          "model_answer": {
            "hanzi": "刚下过雨，路很滑，走路要小心一点儿。",
            "pinyin": "Gāng xià guò yǔ, lù hěn huá, zǒulù yào xiǎoxīn yìdiǎnr.",
            "english": "It just rained and the road is slippery—be a little careful when walking."
          }
        }
      ],
      "common_pitfall": "邮箱 is the email inbox or email address, while 邮件 is the email message itself. Say 查邮箱 (\"check inbox\") and 发邮件 (\"send an email\").",
      "pronunciation_focus": "声音 (shēngyīn) has two high flat first tones; 注意 (zhùyì) has two sharp fourth tones.",
      "review": {
        "can_do": [
          "Send and receive letters or emails.",
          "Report hearsay with 听说.",
          "Give reminders with 小心 and 注意."
        ],
