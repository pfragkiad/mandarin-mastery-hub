  "sections": {
    "overview": {
      "topic_description": "Communication verbs and nouns for written messages, voices, and everyday warnings.",
      "focus": "Use 发 for sending and 收到 for receiving; use 注意 / 小心 for careful reminders."
    },
    "vocabulary": {
