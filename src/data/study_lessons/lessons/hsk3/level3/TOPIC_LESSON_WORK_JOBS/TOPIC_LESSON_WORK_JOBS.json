  "sections": {
    "overview": {
      "topic_description": "Essential workplace nouns and verbs for office communication and scheduling.",
      "focus": "Use 开会 for holding or attending a meeting and 请假 for requesting time off."
    },
    "vocabulary": {
      "items": [
        {
          "id": "w-0512",
          "hanzi": "办公室",
          "pinyin": "bàngōngshì",
          "meaning_en": "office",
          "primary_pos_id": "noun",
          "pos_ids": [
            "noun"
          ],
          "primary_topic_id": "work-jobs",
          "topic_ids": [
            "work-jobs"
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "examples": [
            {
              "id": "ex-0512-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "办公室在哪儿？",
              "pinyin": "bàngōngshì zài nǎr?",
              "english": "Where is the office?",
              "teaching_note": "Short everyday spoken use of 办公室."
            },
            {
              "id": "ex-0512-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "老师正在办公室工作。",
              "pinyin": "lǎoshī zhèngzài bàngōngshì gōngzuò.",
              "english": "The teacher is working in the office.",
              "teaching_note": "Simple descriptive or narrative use of 办公室."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 512
            }
          ]
        },
        {
