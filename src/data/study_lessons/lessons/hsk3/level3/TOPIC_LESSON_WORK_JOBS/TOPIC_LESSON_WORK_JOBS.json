          "pos_ids": [
            "verb"
          ],
          "primary_topic_id": "work-jobs",
          "topic_ids": [
            "work-jobs"
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "examples": [
            {
              "id": "ex-0632-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "这里的服务很好。",
              "pinyin": "zhèlǐ de fúwù hěn hǎo.",
              "english": "The service here is very good.",
              "teaching_note": "Short everyday spoken use of 服务."
            },
            {
              "id": "ex-0632-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "这家宾馆的服务很好。",
              "pinyin": "zhè jiā bīnguǎn de fúwù hěn hǎo.",
              "english": "This hotel has good service.",
              "teaching_note": "Simple descriptive or narrative use of 服务."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 632
            }
          ]
        },
        {
          "id": "w-0683",
          "hanzi": "会",
          "pinyin": "huì",
          "meaning_en": "meeting; association (noun sense of 会)",
          "primary_pos_id": "noun",
          "pos_ids": [
            "noun"
          ],
          "primary_topic_id": "work-jobs",
          "topic_ids": [
            "work-jobs"
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "examples": [
            {
              "id": "ex-0683-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "今天有个会。",
              "pinyin": "jīntiān yǒu gè huì.",
              "english": "There's a meeting today.",
              "teaching_note": "会 here refers to a meeting as a noun; it is distinct from 会 (huì) the modal verb in Level 1."
            },
            {
              "id": "ex-0683-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "这个会下午三点开始。",
              "pinyin": "zhège huì xiàwǔ sān diǎn kāishǐ.",
              "english": "This meeting starts at three in the afternoon.",
              "teaching_note": "会 here refers to a meeting as a noun; it is distinct from 会 (huì) the modal verb in Level 1."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 683
            }
          ]
        },
        {
