    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Before the Morning Meeting",
        "context_en": "Two colleagues talk in the office before a meeting with their manager.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "请问，李经理在办公室吗？",
            "pinyin": "Qǐngwèn, Lǐ jīnglǐ zài bàngōngshì ma?",
            "english": "Excuse me, is Manager Li in the office?"
          },
          {
            "speaker": "B",
            "hanzi": "他去会议室开会了，一会儿才回来。",
            "pinyin": "Tā qù huìyìshì kāihuì le, yíhuìr cái huílai.",
            "english": "He went to the meeting room for a meeting and won’t be back for a bit."
          },
          {
            "speaker": "A",
            "hanzi": "那我等他开完会再找他，我想下周请假两天。",
            "pinyin": "Nà wǒ děng tā kāi wán huì zài zhǎo tā, wǒ xiǎng xià zhōu qǐngjià liǎng tiān.",
            "english": "Then I’ll look for him after his meeting ends; I’d like to ask for two days off next week."
          },
          {
            "speaker": "B",
            "hanzi": "没问题，不过记得提前告诉部门的同事。",
            "pinyin": "Méi wèntí, búguò jìde tíqián gàosu bùmén de tóngshì.",
            "english": "No problem, just remember to tell your department colleagues in advance."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Holding or attending a meeting",
          "explanation_en": "开会 (kāihuì) is a separable verb; insert duration or completion words like 完 between 开 and 会.",
          "pattern_hanzi": "开 + <Duration / Result> + 会",
          "pattern_pinyin": "kāi + <Duration / Result> + huì",
          "pattern_pseudo_translation": "hold + <Duration / Result> + meeting",
          "examples": [
            {
              "hanzi": "我们上午开了两个小时的会。",
              "pinyin": "Wǒmen shàngwǔ kāi le liǎng ge xiǎoshí de huì.",
              "english": "We had a two-hour meeting this morning."
            },
            {
              "hanzi": "经理一开完会就给我打电话了。",
              "pinyin": "Jīnglǐ yì kāi wán huì jiù gěi wǒ dǎ diànhuà le.",
              "english": "As soon as the manager finished the meeting, he called me."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Requesting leave for a period",
          "explanation_en": "State the reason or length of time off with 请假 (qǐngjià); duration follows 请假.",
          "pattern_hanzi": "向 + <Person> + 请假 + <Duration>",
          "pattern_pinyin": "xiàng + <Person> + qǐngjià + <Duration>",
          "pattern_pseudo_translation": "to + <Person> + ask for leave + <Duration>",
          "examples": [
            {
              "hanzi": "小刘感冒了，今天向经理请假一天。",
              "pinyin": "Xiǎo Liú gǎnmào le, jīntiān xiàng jīnglǐ qǐngjià yì tiān.",
              "english": "Xiao Liu caught a cold and asked the manager for one day of leave today."
            },
            {
              "hanzi": "下个月我想休假一个星期。",
              "pinyin": "Xià ge yuè wǒ xiǎng xiūjià yí ge xīngqī.",
              "english": "Next month I want to take a one-week vacation."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Practice workplace requests and scheduling.",
        "model": {
          "hanzi": "我明天上午要和同事一起去开会。",
          "pinyin": "Wǒ míngtiān shàngwǔ yào hé tóngshì yìqǐ qù kāihuì.",
          "english": "Tomorrow morning I need to go to a meeting with my colleagues."
        },
        "substitutions": [
          {
            "id": "build-1",
            "cue_en": "Say the driver is waiting outside the office.",
            "model_answer": {
              "hanzi": "司机正在办公室外面等着呢。",
              "pinyin": "Sījī zhèngzài bàngōngshì wàimiàn děng zhe ne.",
              "english": "The driver is waiting outside the office."
            }
          },
          {
            "id": "build-2",
            "cue_en": "Say the service staff are very friendly.",
            "model_answer": {
              "hanzi": "这里的服务员非常热情。",
              "pinyin": "Zhèlǐ de fúwùyuán fēicháng rèqíng.",
              "english": "The service staff here are very warm and friendly."
            }
          },
          {
            "id": "build-3",
            "cue_en": "Say there is an important meeting this afternoon.",
            "model_answer": {
              "hanzi": "今天下午有一个重要的会议。",
              "pinyin": "Jīntiān xiàwǔ yǒu yí ge zhòngyào de huìyì.",
              "english": "There is an important meeting this afternoon."
            }
          }
        ]
      },
      "reading": {
        "title": "A Busy Friday",
        "paragraphs": [
          {
            "hanzi": "星期五上午，张经理在办公室里看了看今天的安排。九点半有一个重要的会议，所有同事都要参加。",
            "pinyin": "Xīngqīwǔ shàngwǔ, Zhāng jīnglǐ zài bàngōngshì lǐ kàn le kan jīntiān de ānpái. Jiǔ diǎn bàn yǒu yí ge zhòngyào de huìyì, suǒyǒu tóngshì dōu yào cānjiā.",
            "english": "On Friday morning, Manager Zhang checked today’s schedule in his office. At 9:30 there is an important meeting that all colleagues must attend."
          },
          {
            "hanzi": "开完会以后，他还要见一位新来的司机，因为下周他要出差，之后才能休假。",
            "pinyin": "Kāi wán huì yǐhòu, tā hái yào jiàn yí wèi xīn lái de sījī, yīnwèi xià zhōu tā yào chūchāi, zhīhòu cái néng xiūjià.",
            "english": "After the meeting, he also needs to meet a newly arrived driver, because next week he has a business trip and only afterward can he take leave."
          }
        ],
        "questions": [
          {
            "id": "reading-1",
            "prompt_en": "When is the important meeting?",
            "answer_en": "At 9:30 on Friday morning."
          },
          {
            "id": "reading-2",
            "prompt_en": "Who does Manager Zhang need to meet after the meeting?",
            "answer_en": "A newly arrived driver."
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Tell a colleague that you are going to a meeting or asking for leave.",
          "model_answer": {
            "hanzi": "我下午两点去开会，四点回办公室。",
            "pinyin": "Wǒ xiàwǔ liǎng diǎn qù kāihuì, sì diǎn huí bàngōngshì.",
            "english": "I am going to a meeting at 2 p.m. and returning to the office at 4 p.m."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Say what job someone has using 服务, 经理, or 司机.",
          "model_answer": {
            "hanzi": "我哥哥是一家公司的经理，他每天工作很忙。",
            "pinyin": "Wǒ gēge shì yì jiā gōngsī de jīnglǐ, tā měitiān gōngzuò hěn máng.",
            "english": "My older brother is a manager at a company; he is very busy at work every day."
          }
        }
      ],
      "common_pitfall": "请假 means \"ask for leave\" (from work or school), while 休假 means \"be on leave / take vacation\".",
      "pronunciation_focus": "办公室 (bàngōngshì) ends with a falling fourth-tone shì; 会议 (huìyì) has two fourth tones in a row.",
      "review": {
        "can_do": [
          "Name office roles and places.",
          "Talk about meetings with 开会 and 会议.",
          "Distinguish 请假 and 休假."
        ],
