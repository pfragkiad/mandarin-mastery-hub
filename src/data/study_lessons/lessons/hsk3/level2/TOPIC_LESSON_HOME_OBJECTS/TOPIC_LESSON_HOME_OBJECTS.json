    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "My Room and My Belongings",
        "context_en": "Locate everyday possessions in a bedroom and describe what to bring to school.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "我的书包在哪儿？",
            "pinyin": "Wǒ de shūbāo zài nǎr?",
            "english": "Where is my schoolbag?"
          },
          {
            "speaker": "B",
            "hanzi": "在床上，旁边还有你的手表。",
            "pinyin": "Zài chuáng shang, pángbiān hái yǒu nǐ de shǒubiǎo.",
            "english": "On the bed, and your watch is next to it."
          },
          {
            "speaker": "A",
            "hanzi": "我的裤子呢？我今天要出门。",
            "pinyin": "Wǒ de kùzi ne? Wǒ jīntiān yào chūmén.",
            "english": "What about my trousers? I need to go out today."
          },
          {
