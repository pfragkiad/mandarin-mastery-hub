          },
          {
            "speaker": "B",
            "hanzi": "我头疼，眼睛也不舒服。",
            "pinyin": "Wǒ tóu téng, yǎnjing yě bù shūfu.",
            "english": "I have a headache, and my eyes feel uncomfortable too."
          },
          {
            "speaker": "A",
            "hanzi": "那你要去药店买药吗？",
            "pinyin": "Nà nǐ yào qù yàodiàn mǎi yào ma?",
            "english": "Then do you need to go to the pharmacy to buy medicine?"
          },
          {
            "speaker": "B",
            "hanzi": "我先休息一下，明天身体好了再去游泳。",
            "pinyin": "Wǒ xiān xiūxi yíxià, míngtiān shēntǐ hǎo le zài qù yóuyǒng.",
            "english": "I’ll rest first and go swimming tomorrow when I feel better."
          }
        ]
      },
