    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Sharing Opinions and Feelings",
        "context_en": "Say whether an activity is interesting, correct a mistake and express a personal hope.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你觉得今天的电影怎么样？",
            "pinyin": "Nǐ juéde jīntiān de diànyǐng zěnmeyàng?",
            "english": "What do you think of today’s film?"
          },
          {
            "speaker": "B",
            "hanzi": "我觉得很有意思！你呢？",
            "pinyin": "Wǒ juéde hěn yǒu yìsi! Nǐ ne?",
            "english": "I think it is very interesting! How about you?"
          },
          {
            "speaker": "A",
            "hanzi": "我觉得还不错，但是最后有点儿没意思。",
            "pinyin": "Wǒ juéde hái búcuò, dànshì zuìhòu yǒudiǎnr méi yìsi.",
            "english": "I think it is fairly good, but the end is a little boring."
          },
          {
            "speaker": "B",
            "hanzi": "没关系！希望下次我们能看更好的电影。",
            "pinyin": "Méi guānxi! Xīwàng xià cì wǒmen néng kàn gèng hǎo de diànyǐng.",
            "english": "No problem! I hope we can watch a better movie next time."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Evaluating an activity",
