    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Finding the Way in Town",
        "context_en": "Ask where places are and follow simple walking directions in an unfamiliar area.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "不好意思，请问洗手间在哪儿？",
            "pinyin": "Bù hǎoyìsi, qǐngwèn xǐshǒujiān zài nǎr?",
            "english": "Excuse me, where is the restroom?"
          },
          {
            "speaker": "B",
            "hanzi": "从这儿往前走，到门口再往右走。",
            "pinyin": "Cóng zhèr wǎng qián zǒu, dào ménkǒu zài wǎng yòu zǒu.",
            "english": "Walk forward from here, then turn right at the entrance."
          },
          {
            "speaker": "A",
            "hanzi": "是在这条路上吗？",
            "pinyin": "Shì zài zhè tiáo lù shang ma?",
            "english": "Is it on this road?"
          },
          {
