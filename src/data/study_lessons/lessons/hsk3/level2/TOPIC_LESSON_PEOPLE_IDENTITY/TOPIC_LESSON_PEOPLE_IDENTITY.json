    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Introducing People by Name",
        "context_en": "Introduce someone, ask about surnames and describe people in a friendly conversation.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你好！请问，你姓什么？",
            "pinyin": "Nǐ hǎo! Qǐngwèn, nǐ xìng shénme?",
            "english": "Hello! Excuse me, what is your surname?"
          },
          {
            "speaker": "B",
            "hanzi": "我姓王。我的姓名是王小明。",
            "pinyin": "Wǒ xìng Wáng. Wǒ de xìngmíng shì Wáng Xiǎomíng.",
            "english": "My surname is Wang. My full name is Wang Xiaoming."
          },
          {
            "speaker": "A",
            "hanzi": "那个男孩儿是你的朋友吗？",
            "pinyin": "Nà ge nánháir shì nǐ de péngyou ma?",
            "english": "Is that boy your friend?"
          },
          {
            "speaker": "B",
            "hanzi": "是的，他是我的朋友，个子很高。",
            "pinyin": "Shì de, tā shì wǒ de péngyou, gèzi hěn gāo.",
            "english": "Yes, he is my friend, and he is tall."
          }
        ]
      },
