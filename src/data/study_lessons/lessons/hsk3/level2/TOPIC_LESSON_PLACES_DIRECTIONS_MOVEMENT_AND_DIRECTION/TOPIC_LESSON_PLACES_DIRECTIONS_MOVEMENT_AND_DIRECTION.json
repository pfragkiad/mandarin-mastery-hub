  "sections": {
    "overview": {
      "topic_description": "Distinguish movement toward and away from the speaker when entering, exiting or returning.",
      "focus": "Use 进来 (jìnlái) and 进去 (jìnqù) appropriately."
    },
    "vocabulary": {
      "items": [
        {
          "id": "w-316",
          "hanzi": "出",
          "pinyin": "chū",
          "meaning_en": "to go out; to emerge",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb"
          ],
          "topic_ids": [
            "places-directions"
          ],
          "examples": [
            {
              "id": "ex-316-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "你什么时候出门？",
              "pinyin": "nǐ shénme shíhou chūmén?",
              "english": "When are you leaving home?",
              "teaching_note": "A short spoken example using 出."
            },
            {
              "id": "ex-316-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "学生们出了教室。",
              "pinyin": "xuéshēngmen chū le jiàoshì.",
              "english": "The students left the classroom.",
              "teaching_note": "出 is used independently as a verb, not only inside 出门 or 出来."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
