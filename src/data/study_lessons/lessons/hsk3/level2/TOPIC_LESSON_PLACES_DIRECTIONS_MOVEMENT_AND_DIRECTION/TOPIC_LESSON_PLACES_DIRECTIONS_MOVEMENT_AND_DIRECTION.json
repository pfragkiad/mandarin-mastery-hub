    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Entering, Leaving and Returning",
        "context_en": "Distinguish movement toward and away from the speaker when entering, exiting or returning.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你在里面吗？我可以进来吗？",
            "pinyin": "Nǐ zài lǐmiàn ma? Wǒ kěyǐ jìnlái ma?",
            "english": "Are you inside? May I come in?"
          },
          {
            "speaker": "B",
            "hanzi": "可以，进来吧！我正要出去。",
            "pinyin": "Kěyǐ, jìnlái ba! Wǒ zhèng yào chūqù.",
            "english": "Yes, come in! I’m just about to go out."
          },
          {
            "speaker": "A",
            "hanzi": "你出去以后，还回来吗？",
            "pinyin": "Nǐ chūqù yǐhòu, hái huílái ma?",
            "english": "Will you come back after you go out?"
          },
          {
            "speaker": "B",
            "hanzi": "我一会儿就回来。你先上去等我。",
            "pinyin": "Wǒ yíhuìr jiù huílái. Nǐ xiān shàngqù děng wǒ.",
            "english": "I’ll be back soon. Go upstairs and wait for me."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Movement toward the reference point",
          "explanation_en": "来 (lái) signals movement toward the speaker or chosen reference point: 进来 (jìnlái), 出来 (chūlái), 回来 (huílái).",
          "examples": [
            {
              "hanzi": "请你过来帮我一下。",
              "pinyin": "Qǐng nǐ guòlái bāng wǒ yíxià.",
              "english": "Please come over and help me."
            },
            {
              "hanzi": "可以，进来吧！我正要出去。",
              "pinyin": "Kěyǐ, jìnlái ba! Wǒ zhèng yào chūqù.",
              "english": "Yes, come in! I’m just about to go out."
            }
          ],
          "pattern_hanzi": "位移动词 + 来",
          "pattern_pinyin": "wèiyí dòngcí + lái",
          "pattern_pseudo_translation": "<movement verb> + 来"
        },
        {
          "id": "pattern-2",
          "title": "Movement away from the reference point",
          "explanation_en": "去 (qù) signals movement away from the speaker or chosen reference point: 进去 (jìnqù), 出去 (chūqù), 回去 (huíqù).",
          "examples": [
