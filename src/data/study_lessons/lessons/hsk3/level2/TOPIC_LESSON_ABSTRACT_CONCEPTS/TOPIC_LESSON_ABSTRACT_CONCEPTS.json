      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Talking About Meanings and Situations",
        "context_en": "Ask about a word’s meaning and explain an everyday situation or problem.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "不好意思，我有一件事情想问你。",
            "pinyin": "Bù hǎoyìsi, wǒ yǒu yí jiàn shìqing xiǎng wèn nǐ.",
            "english": "Excuse me, I have something to ask you."
          },
          {
            "speaker": "B",
            "hanzi": "好的，是什么事情？",
            "pinyin": "Hǎo de, shì shénme shìqing?",
            "english": "Okay, what is it about?"
          },
          {
            "speaker": "A",
            "hanzi": "我不明白老师说的那个词。",
            "pinyin": "Wǒ bù míngbai lǎoshī shuō de nà ge cí.",
            "english": "I do not understand the word the teacher said."
          },
          {
            "speaker": "B",
            "hanzi": "我告诉你它的意思，然后一起看看例子。",
            "pinyin": "Wǒ gàosu nǐ tā de yìsi, ránhòu yìqǐ kànkan lìzi.",
            "english": "I’ll tell you what it means, and then we’ll look at examples together."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Asking for a meaning",
          "explanation_en": "Use 什么意思 (shénme yìsi) to ask what a word or phrase means. 意思 (yìsi) has other conversational meanings, but here it is about meaning.",
          "examples": [
            {
              "hanzi": "我不明白这句话的意思。",
              "pinyin": "Wǒ bù míngbai zhè jù huà de yìsi.",
