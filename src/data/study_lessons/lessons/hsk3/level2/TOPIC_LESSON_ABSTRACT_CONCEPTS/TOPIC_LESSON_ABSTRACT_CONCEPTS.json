            },
            {
              "hanzi": "好的，是什么事情？",
              "pinyin": "Hǎo de, shì shénme shìqing?",
              "english": "Okay, what is it about?"
            }
          ],
          "pattern_hanzi": "词语 + 是什么意思？",
          "pattern_pinyin": "cíyǔ + shì shénme yìsi?",
          "pattern_pseudo_translation": "<word or phrase> + 是什么意思？"
