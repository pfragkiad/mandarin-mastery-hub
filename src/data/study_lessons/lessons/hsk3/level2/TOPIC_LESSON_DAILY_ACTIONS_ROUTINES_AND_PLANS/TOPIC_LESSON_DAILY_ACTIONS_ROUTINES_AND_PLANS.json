    "grammar_points": [
      {
        "id": "grammar-1",
        "title": "Remembering and forgetting",
        "explanation": "记得 (jìde) means remember; 忘 (wàng) means forget. Place a following verb phrase after them when describing what happened.",
        "example_id": "ex-319-1"
      },
      {
        "id": "grammar-2",
