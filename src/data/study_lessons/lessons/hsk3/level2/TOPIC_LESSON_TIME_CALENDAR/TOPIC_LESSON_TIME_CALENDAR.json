        "context_en": "Describe regular activities, birthdays, past habits and things about to happen.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你下周过生日吗？",
            "pinyin": "Nǐ xià zhōu guò shēngrì ma?",
            "english": "Is your birthday next week?"
          },
          {
            "speaker": "B",
            "hanzi": "对，我的生日快要到了！",
            "pinyin": "Duì, wǒ de shēngrì kuàiyào dào le!",
            "english": "Yes, my birthday is coming soon!"
          },
          {
            "speaker": "A",
            "hanzi": "你小时候经常怎么过生日？",
            "pinyin": "Nǐ xiǎoshíhou jīngcháng zěnme guò shēngrì?",
            "english": "How did you often celebrate birthdays as a child?"
          },
          {
            "speaker": "B",
            "hanzi": "我从小喜欢和家人一起吃饭。有时还唱歌。",
            "pinyin": "Wǒ cóngxiǎo xǐhuan hé jiārén yìqǐ chī fàn. Yǒushí hái chàng gē.",
            "english": "Since childhood I have liked eating with family. Sometimes we also sang."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Frequency in daily life",
          "explanation_en": "经常 (jīngcháng) means often; 有时 (yǒushí) means sometimes. Put the frequency word before the main action.",
          "formula_en": "Subject + frequency adverb + verb",
          "examples": [
            {
              "hanzi": "我经常星期六去运动。",
              "pinyin": "Wǒ jīngcháng xīngqīliù qù yùndòng.",
              "english": "I often exercise on Saturdays."
            },
            {
              "hanzi": "对，我的生日快要到了！",
              "pinyin": "Duì, wǒ de shēngrì kuàiyào dào le!",
              "english": "Yes, my birthday is coming soon!"
            }
          ]
        },
