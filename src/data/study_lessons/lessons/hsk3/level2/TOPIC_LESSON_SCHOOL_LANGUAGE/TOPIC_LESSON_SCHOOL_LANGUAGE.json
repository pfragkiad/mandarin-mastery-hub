        "title": "Words, Classes and Examinations",
        "context_en": "Talk about school, classrooms, word meanings, teachers, tests and stationery.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "老师，这个词是什么意思？",
            "pinyin": "Lǎoshī, zhè ge cí shì shénme yìsi?",
            "english": "Teacher, what does this word mean?"
          },
          {
            "speaker": "B",
            "hanzi": "你先看书；不懂的地方可以问我。",
            "pinyin": "Nǐ xiān kàn shū; bù dǒng de dìfang kěyǐ wèn wǒ.",
            "english": "Read the book first; you can ask me about what you do not understand."
          },
          {
            "speaker": "A",
            "hanzi": "我忘带笔和本子了。",
            "pinyin": "Wǒ wàng dài bǐ hé běnzi le.",
            "english": "I forgot to bring a pen and notebook."
          },
          {
            "speaker": "B",
            "hanzi": "没关系，我这儿有。考试前记得准备好！",
            "pinyin": "Méi guānxi, wǒ zhèr yǒu. Kǎoshì qián jìde zhǔnbèi hǎo!",
            "english": "No problem, I have some here. Remember to prepare before the exam!"
          }
        ]
      },
