          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "pos_note": "着 (zhe) marks a continuing state or manner."
        },
        {
          "id": "w-491",
          "hanzi": "正",
          "pinyin": "zhèng",
          "meaning_en": "just; right in the middle of an action",
          "primary_pos_id": "adverb",
          "pos_ids": [
            "adverb"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-491-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "我正吃饭呢。",
              "pinyin": "wǒ zhèng chīfàn ne.",
              "english": "I'm eating right now.",
              "teaching_note": "正 (zhèng) before a verb signals an action in progress."
            },
            {
              "id": "ex-491-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "老师正给学生上课。",
              "pinyin": "lǎoshī zhèng gěi xuéshēng shàngkè.",
              "english": "The teacher is teaching the students right now.",
              "teaching_note": "正 (zhèng) before a verb signals an action in progress."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
