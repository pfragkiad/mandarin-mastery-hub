        {
          "id": "w-490",
          "hanzi": "着",
          "pinyin": "zhe",
          "meaning_en": "durative aspect particle; ongoing state",
          "primary_pos_id": "particle",
          "pos_ids": [
            "particle"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-490-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "门开着呢。",
              "pinyin": "mén kāi zhe ne.",
              "english": "The door is open.",
              "teaching_note": "着 (zhe) marks a continuing state or manner."
            },
            {
              "id": "ex-490-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "老师站着跟学生说话。",
              "pinyin": "lǎoshī zhàn zhe gēn xuéshēng shuōhuà.",
              "english": "The teacher speaks to the students while standing.",
              "teaching_note": "着 (zhe) marks a continuing state or manner."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
