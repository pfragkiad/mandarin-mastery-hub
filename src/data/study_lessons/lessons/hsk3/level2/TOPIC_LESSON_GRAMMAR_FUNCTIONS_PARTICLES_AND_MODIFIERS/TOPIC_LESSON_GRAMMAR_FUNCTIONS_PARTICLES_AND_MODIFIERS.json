  "sections": {
    "overview": {
      "topic_description": "Add useful details to sentences with aspect markers, complements and negative instructions.",
      "focus": "Recognize 过 (guo) for experiences and 着 (zhe) for ongoing states."
    },
    "vocabulary": {
      "items": [
        {
          "id": "w-301",
          "hanzi": "啊",
          "pinyin": "a",
          "meaning_en": "sentence-final exclamation particle",
          "primary_pos_id": "particle",
          "pos_ids": [
            "particle"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-301-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "你来了啊！",
              "pinyin": "nǐ lái le a!",
              "english": "Oh, you're here!",
              "teaching_note": "Sentence-final 啊 is a particle, not an independent noun or verb."
            },
            {
              "id": "ex-301-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "“好啊，我们一起去！”她说。",
              "pinyin": "“hǎo a, wǒmen yìqǐ qù!” tā shuō.",
              "english": "\"Sure, let's go together!\" she said.",
              "teaching_note": "Sentence-final 啊 is a particle, not an independent noun or verb."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 301
            }
          ],
          "primary_topic_id": "grammar-functions",
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "pos_note": "Sentence-final 啊 is a particle, not an independent noun or verb."
        },
        {
          "id": "w-311",
          "hanzi": "别",
          "pinyin": "bié",
          "meaning_en": "do not; must not",
          "primary_pos_id": "adverb",
          "pos_ids": [
            "adverb"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-311-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "别走！",
              "pinyin": "bié zǒu!",
              "english": "Don't go!",
              "teaching_note": "The official 别1 label identifies the adverbial entry; the displayed Hanzi is 别."
            },
            {
              "id": "ex-311-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "上课的时候，别玩手机。",
              "pinyin": "shàngkè de shíhou, bié wán shǒujī.",
              "english": "Don't play with your phone during class.",
              "teaching_note": "The official 别1 label identifies the adverbial entry; the displayed Hanzi is 别."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 311
            }
          ],
          "primary_topic_id": "grammar-functions",
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "pos_note": "The official 别1 label identifies the adverbial entry; the displayed Hanzi is 别."
        },
        {
          "id": "w-332",
          "hanzi": "得",
          "pinyin": "de",
          "meaning_en": "structural particle introducing complements",
          "primary_pos_id": "particle",
          "pos_ids": [
            "particle"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-332-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "你说得很好！",
              "pinyin": "nǐ shuō de hěn hǎo!",
              "english": "You spoke very well!",
              "teaching_note": "得 (de) introduces a manner or degree complement after a verb."
            },
            {
              "id": "ex-332-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "他汉语说得很好。",
              "pinyin": "tā Hànyǔ shuō de hěn hǎo.",
              "english": "He speaks Chinese very well.",
              "teaching_note": "得 (de) introduces a manner or degree complement after a verb."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 333
            }
          ],
          "primary_topic_id": "grammar-functions",
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "pos_note": "得 (de) introduces a manner or degree complement after a verb."
        },
        {
          "id": "w-333",
          "hanzi": "地",
          "pinyin": "de",
          "meaning_en": "structural particle marking an adverbial",
          "primary_pos_id": "particle",
          "pos_ids": [
            "particle"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-333-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "你慢慢地说。",
              "pinyin": "nǐ mànmàn de shuō.",
              "english": "Speak slowly.",
              "teaching_note": "地 (de) connects a manner phrase to the following verb."
            },
            {
              "id": "ex-333-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "他慢慢地走进教室。",
              "pinyin": "tā mànmàn de zǒu jìn jiàoshì.",
              "english": "He walks slowly into the classroom.",
              "teaching_note": "地 (de) connects a manner phrase to the following verb."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 332
            }
          ],
          "primary_topic_id": "grammar-functions",
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "pos_note": "地 (de) connects a manner phrase to the following verb."
        },
        {
          "id": "w-351",
          "hanzi": "过",
          "pinyin": "guo",
          "meaning_en": "experiential aspect particle; have done",
          "primary_pos_id": "particle",
          "pos_ids": [
            "particle"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-351-1",
              "style": "conversational",
              "register": "neutral_spoken",
              "hanzi": "你去过中国吗？",
              "pinyin": "nǐ qù guo Zhōngguó ma?",
              "english": "Have you ever been to China?",
              "teaching_note": "Revised to exemplify the headword naturally using vocabulary from HSK 3.0 Levels 1–2."
            },
            {
              "id": "ex-351-2",
              "style": "written",
              "register": "plain_written",
              "hanzi": "我坐过飞机，但是没坐过火车。",
              "pinyin": "wǒ zuò guo fēijī, dànshì méi zuò guo huǒchē.",
              "english": "I have flown before, but I have never taken a train.",
              "teaching_note": "This 过 (guo) is the neutral-tone experiential aspect particle, distinct from ID 347."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 351
            }
          ],
          "primary_topic_id": "grammar-functions",
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "pos_note": "This 过 (guo) is the neutral-tone experiential aspect particle, distinct from ID 347."
        },
        {
