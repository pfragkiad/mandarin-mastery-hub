    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Describing Colors and Comparing Things",
        "context_en": "Describe the colors and physical qualities of objects, then compare two things.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你喜欢哪件衣服？红色的还是绿色的？",
            "pinyin": "Nǐ xǐhuan nǎ jiàn yīfu? Hóngsè de háishi lǜsè de?",
            "english": "Which outfit do you like, the red one or the green one?"
          },
          {
            "speaker": "B",
            "hanzi": "我喜欢绿色的，不过黑色的也不错。",
            "pinyin": "Wǒ xǐhuan lǜsè de, búguò hēisè de yě búcuò.",
            "english": "I like the green one, though the black one is also nice."
          },
          {
            "speaker": "A",
            "hanzi": "这条裤子比那条长吗？",
            "pinyin": "Zhè tiáo kùzi bǐ nà tiáo cháng ma?",
            "english": "Are these trousers longer than those?"
          },
          {
            "speaker": "B",
            "hanzi": "对，而且白色的那条比这条短。",
            "pinyin": "Duì, érqiě báisè de nà tiáo bǐ zhè tiáo duǎn.",
            "english": "Yes, and the white pair is shorter than this one."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Comparing two items",
          "explanation_en": "比 (bǐ) introduces the item used for comparison, followed by the relevant adjective.",
          "examples": [
            {
              "hanzi": "这条路比那条路长。",
              "pinyin": "Zhè tiáo lù bǐ nà tiáo lù cháng.",
              "english": "This road is longer than that road."
            },
            {
              "hanzi": "我喜欢绿色的，不过黑色的也不错。",
              "pinyin": "Wǒ xǐhuan lǜsè de, búguò hēisè de yě búcuò.",
              "english": "I like the green one, though the black one is also nice."
            }
          ],
          "pattern_hanzi": "甲 + 比 + 乙 + 形容词",
          "pattern_pinyin": "jiǎ + bǐ + yǐ + xíngróngcí",
          "pattern_pseudo_translation": "<A> + 比 + <B> + <adjective>"
        },
        {
          "id": "pattern-2",
          "title": "Describing colors",
          "explanation_en": "Use a color noun such as 红色 (hóngsè) before 的 (de) when modifying a noun.",
          "examples": [
            {
              "hanzi": "她走得很慢，我走得很快。",
              "pinyin": "Tā zǒu de hěn màn, wǒ zǒu de hěn kuài.",
              "english": "She walks slowly, and I walk quickly."
            },
            {
              "hanzi": "对，而且白色的那条比这条短。",
              "pinyin": "Duì, érqiě báisè de nà tiáo bǐ zhè tiáo duǎn.",
              "english": "Yes, and the white pair is shorter than this one."
            }
          ],
          "pattern_hanzi": "颜色 + 的 + 名词",
          "pattern_pinyin": "yánsè + de + míngcí",
          "pattern_pseudo_translation": "<color> + 的 + <noun>"
        }
      ],
