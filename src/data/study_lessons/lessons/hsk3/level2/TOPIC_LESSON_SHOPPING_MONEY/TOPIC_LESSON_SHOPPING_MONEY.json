    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Buying Tickets and Shopping",
        "context_en": "Ask about tickets, discuss shopping at the mall and describe spending money.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "这家商场很大，我们进去看看吧。",
            "pinyin": "Zhè jiā shāngchǎng hěn dà, wǒmen jìnqù kànkan ba.",
            "english": "This mall is big. Let’s go inside and look around."
          },
          {
            "speaker": "B",
            "hanzi": "好。你今天想买什么？",
            "pinyin": "Hǎo. Nǐ jīntiān xiǎng mǎi shénme?",
            "english": "Sure. What do you want to buy today?"
          },
          {
            "speaker": "A",
            "hanzi": "我想先问一下电影的门票多少钱。",
            "pinyin": "Wǒ xiǎng xiān wèn yíxià diànyǐng de ménpiào duōshao qián.",
            "english": "First I’d like to ask how much the movie tickets cost."
          },
          {
            "speaker": "B",
            "hanzi": "别花太多钱。我们还有别的事情要做。",
            "pinyin": "Bié huā tài duō qián. Wǒmen hái yǒu bié de shìqing yào zuò.",
            "english": "Don’t spend too much. We still have other things to do."
          }
        ]
      },
