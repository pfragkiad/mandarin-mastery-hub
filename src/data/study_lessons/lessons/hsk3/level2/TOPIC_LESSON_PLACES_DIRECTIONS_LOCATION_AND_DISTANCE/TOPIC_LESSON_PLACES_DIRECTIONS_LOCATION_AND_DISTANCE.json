          },
          {
            "speaker": "B",
            "hanzi": "在二楼。门就在左边。",
            "pinyin": "Zài èr lóu. Mén jiù zài zuǒbian.",
            "english": "On the second floor. The door is on the left."
          },
          {
            "speaker": "A",
            "hanzi": "从这儿走远吗？",
            "pinyin": "Cóng zhèr zǒu yuǎn ma?",
            "english": "Is it far to walk from here?"
          },
          {
            "speaker": "B",
            "hanzi": "不远，就在洗手间旁边，办公室前面。",
            "pinyin": "Bù yuǎn, jiù zài xǐshǒujiān pángbiān, bàngōngshì qiánmiàn.",
            "english": "Not far, next to the restroom, in front of the office."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Relative positions",
          "explanation_en": "Place 旁边 (pángbiān), 左边 (zuǒbian), 右边 (yòubian) or another position term after a landmark to describe a location.",
          "formula_en": "Landmark + position + 有/是 + place",
          "examples": [
            {
              "hanzi": "我的书在桌子下面。",
              "pinyin": "Wǒ de shū zài zhuōzi xiàmiàn.",
              "english": "My book is under the table."
            },
            {
              "hanzi": "在二楼。门就在左边。",
              "pinyin": "Zài èr lóu. Mén jiù zài zuǒbian.",
              "english": "On the second floor. The door is on the left."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Distance from a landmark",
          "explanation_en": "离 (lí) introduces a reference point; combine it with 近 (jìn) or 远 (yuǎn).",
          "formula_en": "Place A + 离 + place B + 近/远",
          "examples": [
            {
              "hanzi": "我们家离学校很近。",
              "pinyin": "Wǒmen jiā lí xuéxiào hěn jìn.",
              "english": "Our home is close to the school."
            },
            {
              "hanzi": "不远，就在洗手间旁边，办公室前面。",
              "pinyin": "Bù yuǎn, jiù zài xǐshǒujiān pángbiān, bàngōngshì qiánmiàn.",
              "english": "Not far, next to the restroom, in front of the office."
            }
          ]
        }
