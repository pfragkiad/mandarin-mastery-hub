    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Health and Rest",
        "context_en": "A student is unwell, explains symptoms simply, and asks for time to rest.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你今天怎么了？",
            "pinyin": "Nǐ jīntiān zěnme le?",
            "english": "What is wrong today?"
          },
          {
            "speaker": "B",
            "hanzi": "我生病了，想休息。",
            "pinyin": "Wǒ shēngbìng le, xiǎng xiūxi.",
            "english": "I am sick and want to rest."
