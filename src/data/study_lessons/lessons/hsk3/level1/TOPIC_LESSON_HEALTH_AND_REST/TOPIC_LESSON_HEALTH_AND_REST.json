    "vocabulary": {
      "items": [
        {
          "id": "w-012",
          "hanzi": "病",
          "pinyin": "bìng",
          "meaning_en": "illness",
          "primary_pos_id": "noun",
          "pos_ids": [
            "noun",
            "verb"
          ],
          "topic_ids": [
            "health-wellbeing"
          ],
          "examples": [
            {
              "id": "ex-012-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "他生病了。",
              "pinyin": "tā shēngbìng le.",
              "english": "He is ill.",
              "teaching_note": "生病 is the ordinary way to say someone is ill; 有病 can sound judgmental in conversation."
            },
            {
              "id": "ex-012-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "他的病好了。",
              "pinyin": "tā de bìng hǎo le.",
              "english": "His illness has gotten better.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 12
            }
          ],
          "pos_note": "Illness as a noun; also occurs in verbal uses.",
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "primary_topic_id": "health-wellbeing"
        },
        {
          "id": "w-100",
          "hanzi": "看病",
          "pinyin": "kànbìng",
          "meaning_en": "see a doctor",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb"
          ],
          "topic_ids": [
            "health-wellbeing",
            "daily-actions"
          ],
          "examples": [
            {
              "id": "ex-100-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我生病了，要去看病。",
              "pinyin": "wǒ shēngbìng le, yào qù kànbìng.",
              "english": "I am sick and need to see a doctor.",
              "teaching_note": "看病 means consult a doctor or seek medical care, not merely “look at illness.”"
            },
            {
              "id": "ex-100-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "医生上午九点开始看病。",
              "pinyin": "yīshēng shàngwǔ jiǔ diǎn kāishǐ kànbìng.",
              "english": "The doctor starts seeing patients at nine in the morning.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 100
            }
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "primary_topic_id": "health-wellbeing"
        },
        {
          "id": "w-104",
          "hanzi": "口",
          "pinyin": "kǒu",
          "meaning_en": "mouth",
          "primary_pos_id": "noun",
          "pos_ids": [
            "noun",
            "classifier"
          ],
          "topic_ids": [
            "health-wellbeing"
          ],
          "examples": [
            {
              "id": "ex-104-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我喝了一口水。",
              "pinyin": "wǒ hē le yì kǒu shuǐ.",
              "english": "I took a sip of water.",
              "teaching_note": "口 acts as a measure word for a sip or mouthful, not the noun “mouth” here."
            },
            {
              "id": "ex-104-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "天气很热，他回家后喝了三口水。",
              "pinyin": "tiānqì hěn rè, tā huí jiā hòu hē le sān kǒu shuǐ.",
              "english": "It was hot. After he got home, he took three sips of water.",
              "teaching_note": "The measure word counts mouthfuls of water."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 104
            }
          ],
          "pos_note": "Noun for mouth; also classifier in expressions such as population count.",
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "primary_topic_id": "health-wellbeing"
        },
        {
          "id": "w-161",
          "hanzi": "起床",
          "pinyin": "qǐchuáng",
          "meaning_en": "get up",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb"
          ],
          "topic_ids": [
            "health-wellbeing",
            "daily-actions"
          ],
          "examples": [
            {
              "id": "ex-161-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我早上七点起床。",
              "pinyin": "wǒ zǎoshang qī diǎn qǐchuáng.",
              "english": "I get up at seven in the morning.",
              "teaching_note": "起床 refers to getting out of bed; 七点 gives the hour."
            },
            {
              "id": "ex-161-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学生们每天早上七点起床，八点上课。",
              "pinyin": "xuéshengmen měitiān zǎoshang qī diǎn qǐchuáng, bā diǎn shàngkè.",
              "english": "The students get up at seven and start class at eight every morning.",
              "teaching_note": "The two time expressions describe a daily routine."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 161
            }
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "primary_topic_id": "health-wellbeing"
        },
        {
          "id": "w-183",
          "hanzi": "生病",
          "pinyin": "shēngbìng",
          "meaning_en": "fall ill",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb"
          ],
          "topic_ids": [
            "health-wellbeing"
          ],
          "examples": [
            {
              "id": "ex-183-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我昨天生病了。",
              "pinyin": "wǒ zuótiān shēngbìng le.",
              "english": "I became ill yesterday.",
              "teaching_note": "生病了 describes a change to an ill state; 昨天 puts it in the past."
            },
            {
              "id": "ex-183-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "她昨天生病，没有上课。",
              "pinyin": "tā zuótiān shēngbìng, méiyǒu shàngkè.",
              "english": "She was sick yesterday and didn't go to class.",
              "teaching_note": ""
