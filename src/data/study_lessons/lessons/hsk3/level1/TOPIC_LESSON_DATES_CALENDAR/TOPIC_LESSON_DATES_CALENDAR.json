        {
          "id": "w-076",
          "hanzi": "号",
          "pinyin": "hào",
          "meaning_en": "number; date",
          "primary_pos_id": "classifier",
          "pos_ids": [
            "classifier",
            "noun"
          ],
          "topic_ids": [
            "time-calendar",
            "numbers-quantities"
          ],
          "examples": [
            {
              "id": "ex-076-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "今天是十月十四号。",
              "pinyin": "jīntiān shì shí yuè shísì hào.",
              "english": "Today is October 14.",
              "teaching_note": "号 is a common spoken way to state a day of the month; 月 identifies the month."
            },
            {
              "id": "ex-076-2",
              "style": "written",
              "register": "written_dialogue",
              "hanzi": "老师说：“十月五号不上课。”",
              "pinyin": "lǎoshī shuō: “shí yuè wǔ hào bú shàngkè.”",
              "english": "The teacher said, “There’s no class on October 5.”",
              "teaching_note": "The day of the month uses hào in the teacher’s speech."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 76
