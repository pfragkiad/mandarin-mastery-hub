    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Days, Months and Years",
        "context_en": "Make a simple plan by naming today, tomorrow and the date.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "今天星期几？",
            "pinyin": "Jīntiān xīngqī jǐ?",
            "english": "What day of the week is it today?"
          },
          {
            "speaker": "B",
            "hanzi": "今天星期三。",
            "pinyin": "Jīntiān xīngqī sān.",
            "english": "It is Wednesday."
          },
          {
            "speaker": "A",
            "hanzi": "明天是几月几号？",
            "pinyin": "Míngtiān shì jǐ yuè jǐ hào?",
            "english": "What month and day is tomorrow?"
          },
          {
            "speaker": "B",
            "hanzi": "明天五月十号。",
            "pinyin": "Míngtiān wǔ yuè shí hào.",
            "english": "Tomorrow is May 10."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Dates: year, month, day",
          "explanation_en": "Chinese calendar dates move from larger to smaller units: 年 (nián), 月 (yuè), and 号 (hào) or 日 (rì). In speech, 号 (hào) is very common for the date.",
          "examples": [
            {
              "hanzi": "今天是八月三号。",
              "pinyin": "Jīntiān shì bā yuè sān hào.",
              "english": "Today is August 3."
            },
            {
              "hanzi": "明天是星期六。",
              "pinyin": "Míngtiān shì xīngqī liù.",
              "english": "Tomorrow is Saturday."
            }
          ],
          "pattern_hanzi": "年份 + 年 + 月份 + 月 + 日期 + 号",
          "pattern_pinyin": "niánfèn + nián + yuèfèn + yuè + rìqī + hào",
          "pattern_pseudo_translation": "<year> + 年 + <month> + 月 + <day> + 号"
        },
        {
          "id": "pattern-2",
          "title": "Relative days versus calendar days",
          "explanation_en": "昨天 (zuótiān), 今天 (jīntiān), 明天 (míngtiān) depend on when you speak. 星期 (xīngqī) names a week or a weekday according to context.",
          "examples": [
            {
              "hanzi": "我昨天上课。",
              "pinyin": "Wǒ zuótiān shàngkè.",
              "english": "I attended class yesterday."
            },
            {
              "hanzi": "我们明天见。",
              "pinyin": "Wǒmen míngtiān jiàn.",
              "english": "See you tomorrow."
            }
          ],
          "pattern_hanzi": "主语 + 时间 + 动词",
          "pattern_pinyin": "zhǔyǔ + shíjiān + dòngcí",
          "pattern_pseudo_translation": "<subject> + <time> + <verb>"
        }
      ],
      "guided_building": {
        "instruction_en": "Replace the date in a scheduling statement.",
        "model": {
          "hanzi": "我们五月十号见。",
          "pinyin": "Wǒmen wǔ yuè shí hào jiàn.",
          "english": "We will meet on May 10."
        },
        "substitutions": [
          {
            "cue_en": "May 12",
            "model_answer": {
              "hanzi": "我们五月十二号见。",
              "pinyin": "Wǒmen wǔ yuè shí èr hào jiàn.",
              "english": "We will meet on May 12."
            },
            "id": "build-sub-01"
          },
          {
            "cue_en": "June 2",
            "model_answer": {
              "hanzi": "我们六月二号见。",
              "pinyin": "Wǒmen liù yuè èr hào jiàn.",
              "english": "We will meet on June 2."
            },
            "id": "build-sub-02"
          }
        ]
      },
      "reading": {
        "title": "A short connected story",
        "paragraphs": [
          {
            "hanzi": "今天是星期五。小李明天不上班，想和朋友去看电影。星期日他要在家学习。",
            "pinyin": "Jīntiān shì xīngqī wǔ. Xiǎo Lǐ míngtiān bú shàngbān, xiǎng hé péngyou qù kàn diànyǐng. Xīngqīrì tā yào zài jiā xuéxí.",
            "english": "Today is Friday. Xiao Li does not work tomorrow and wants to see a movie with a friend. On Sunday he plans to study at home."
          }
        ],
        "questions": [
          {
            "prompt_en": "What does Xiao Li want to do on Saturday?",
            "answer_en": "Watch a movie with a friend.",
            "id": "reading-q-01"
          },
          {
            "prompt_en": "What will he do on Sunday?",
            "answer_en": "Study at home.",
            "id": "reading-q-02"
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Ask someone what day of the week it is.",
          "model_answer": {
            "hanzi": "今天星期几？",
            "pinyin": "Jīntiān xīngqī jǐ?",
            "english": "What day is today?"
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Say what day you will study.",
          "model_answer": {
            "hanzi": "我星期六学习汉语。",
            "pinyin": "Wǒ xīngqī liù xuéxí Hànyǔ.",
            "english": "I study Chinese on Saturday."
          }
        }
      ],
      "common_pitfall": "Do not reverse the English month/day order: 十号五月 is not a normal calendar date. Say 五月十号 (wǔ yuè shí hào).",
      "pronunciation_focus": "Use 号 (hào) for an everyday spoken date; 日 (rì) is also used in written dates and formal contexts.",
      "review": {
        "can_do": [
          "Use day, month, year and week words.",
          "Talk about last, this and next year.",
          "Understand simple dates and ages."
