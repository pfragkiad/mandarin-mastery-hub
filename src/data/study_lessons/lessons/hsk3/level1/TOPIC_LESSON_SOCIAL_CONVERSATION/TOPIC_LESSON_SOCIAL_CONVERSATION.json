    "vocabulary": {
      "items": [
        {
          "id": "w-014",
          "hanzi": "不客气",
          "pinyin": "bú kèqi",
          "meaning_en": "you're welcome",
          "primary_pos_id": "fixed-expression",
          "pos_ids": [
            "fixed-expression"
          ],
          "topic_ids": [
            "communication-social"
          ],
          "examples": [
            {
              "id": "ex-014-1",
              "style": "conversational",
              "register": "polite",
              "hanzi": "不客气！",
              "pinyin": "bú kèqi!",
              "english": "You're welcome!",
              "teaching_note": "不客气 is a standard spoken response to thanks; the short answer is a complete utterance."
            },
            {
              "id": "ex-014-2",
              "style": "written",
              "register": "written_dialogue",
              "hanzi": "她说：“不客气。”",
              "pinyin": "tā shuō: “bú kèqi.”",
              "english": "She said, \"You're welcome.\"",
              "teaching_note": "Written dialogue: 不客气 is used naturally in a spoken exchange, rather than forced into formal prose."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 14
            }
          ],
          "pos_note": "Conventional response to thanks; classify as a fixed expression, not by the characters separately."
        },
        {
          "id": "w-024",
          "hanzi": "打电话",
          "pinyin": "dǎ diànhuà",
          "meaning_en": "make a phone call",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb"
          ],
          "topic_ids": [
            "communication-social",
            "daily-actions"
          ],
          "examples": [
            {
              "id": "ex-024-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我要给妈妈打电话。",
              "pinyin": "wǒ yào gěi māma dǎ diànhuà.",
              "english": "I want to call my mother.",
              "teaching_note": "给妈妈 identifies the recipient of the phone call; 打电话 is a verb-object expression."
            },
            {
              "id": "ex-024-2",
              "style": "written",
              "register": "polite_instruction",
              "hanzi": "请明天上午给老师打电话。",
              "pinyin": "qǐng míngtiān shàngwǔ gěi lǎoshī dǎ diànhuà.",
              "english": "Please call the teacher tomorrow morning.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 24
            }
          ]
        },
        {
          "id": "w-045",
          "hanzi": "对不起",
          "pinyin": "duìbuqǐ",
          "meaning_en": "sorry",
          "primary_pos_id": "fixed-expression",
          "pos_ids": [
            "fixed-expression"
          ],
          "topic_ids": [
            "communication-social"
          ],
          "examples": [
            {
              "id": "ex-045-1",
              "style": "conversational",
              "register": "polite",
              "hanzi": "对不起，我来晚了。",
              "pinyin": "duìbuqǐ, wǒ lái wǎn le.",
              "english": "Sorry, I came late.",
              "teaching_note": "对不起 is an apology; 来晚了 means arriving late, with 了 indicating the completed situation."
            },
            {
              "id": "ex-045-2",
              "style": "written",
              "register": "written_dialogue",
              "hanzi": "“对不起，我没有看见你。”她说。",
              "pinyin": "“duìbuqǐ, wǒ méiyǒu kànjiàn nǐ.” tā shuō.",
              "english": "\"I'm sorry, I didn't see you,\" she said.",
              "teaching_note": "Written dialogue: 对不起 is used naturally in a spoken exchange, rather than forced into formal prose."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 45
            }
          ],
          "pos_note": "Conventional apology; can be analyzed as a verb phrase, but functions as a fixed social expression."
        },
        {
          "id": "w-120",
          "hanzi": "没关系",
