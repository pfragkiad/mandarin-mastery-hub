    "vocabulary": {
      "items": [
        {
          "id": "w-041",
          "hanzi": "都",
          "pinyin": "dōu",
          "meaning_en": "all; both",
          "primary_pos_id": "adverb",
          "pos_ids": [
            "adverb"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-041-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我们都是学生。",
              "pinyin": "wǒmen dōu shì xuéshēng.",
              "english": "We are all students.",
              "teaching_note": "都 applies to everyone in the subject group; omit it and the “all” nuance disappears."
            },
            {
              "id": "ex-041-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学生们都在教室里。",
              "pinyin": "xuéshēngmen dōu zài jiàoshì lǐ.",
              "english": "All the students are in the classroom.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 41
            }
          ]
        },
        {
          "id": "w-053",
          "hanzi": "非常",
          "pinyin": "fēicháng",
          "meaning_en": "extremely",
          "primary_pos_id": "adverb",
          "pos_ids": [
            "adverb"
          ],
          "topic_ids": [
            "grammar-functions",
            "qualities-feelings"
          ],
          "examples": [
            {
              "id": "ex-053-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我今天非常高兴。",
              "pinyin": "wǒ jīntiān fēicháng gāoxìng.",
              "english": "I am extremely happy today.",
              "teaching_note": "非常 intensifies 高兴 more strongly than the common degree word 很."
            },
            {
              "id": "ex-053-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "这件衣服非常漂亮。",
              "pinyin": "zhè jiàn yīfu fēicháng piàoliang.",
              "english": "This piece of clothing is very pretty.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 53
            }
          ]
        },
        {
          "id": "w-067",
          "hanzi": "还",
          "pinyin": "hái",
          "meaning_en": "still; also",
          "primary_pos_id": "adverb",
          "pos_ids": [
            "adverb"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-067-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "他还在学校。",
              "pinyin": "tā hái zài xuéxiào.",
              "english": "He is still at school.",
              "teaching_note": "还 means “still,” showing that the school situation continues."
            },
            {
              "id": "ex-067-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "这家店还没有开门。",
              "pinyin": "zhè jiā diàn hái méiyǒu kāimén.",
              "english": "This shop hasn't opened yet.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 67
            }
          ]
        },
        {
          "id": "w-078",
          "hanzi": "和",
          "pinyin": "hé",
          "meaning_en": "and; with",
          "primary_pos_id": "conjunction",
          "pos_ids": [
            "conjunction",
            "preposition"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-078-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我和你一起去。",
              "pinyin": "wǒ hé nǐ yìqǐ qù.",
              "english": "I will go with you.",
              "teaching_note": "和 joins two people; 一起 clarifies that they go together."
            },
            {
              "id": "ex-078-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "我们和老师一起学习。",
              "pinyin": "wǒmen hé lǎoshī yìqǐ xuéxí.",
              "english": "We study together with the teacher.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 78
            }
          ],
          "pos_note": "Connects nouns and nominal phrases as and; with is a prepositional use."
        },
        {
          "id": "w-079",
          "hanzi": "很",
          "pinyin": "hěn",
          "meaning_en": "very",
          "primary_pos_id": "adverb",
          "pos_ids": [
            "adverb"
          ],
          "topic_ids": [
            "grammar-functions",
            "qualities-feelings"
          ],
          "examples": [
            {
              "id": "ex-079-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "他很高兴。",
              "pinyin": "tā hěn gāoxìng.",
              "english": "He is very happy.",
              "teaching_note": "很 often functions as a natural degree linker before adjectives, not an emphatic “very.”"
            },
            {
              "id": "ex-079-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "这家商店很大。",
              "pinyin": "zhè jiā shāngdiàn hěn dà.",
              "english": "This shop is very big.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 79
            }
          ]
        },
        {
          "id": "w-206",
          "hanzi": "太",
          "pinyin": "tài",
          "meaning_en": "too; very",
          "primary_pos_id": "adverb",
          "pos_ids": [
            "adverb"
          ],
          "topic_ids": [
            "grammar-functions",
            "qualities-feelings"
          ],
          "examples": [
            {
              "id": "ex-206-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "这本书太贵了。",
              "pinyin": "zhè běn shū tài guì le.",
              "english": "This book is too expensive.",
              "teaching_note": "太…了 indicates an excessive degree, not simply a high price."
            },
            {
              "id": "ex-206-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "今天天气太热了。",
              "pinyin": "jīntiān tiānqì tài rè le.",
              "english": "The weather is too hot today.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 206
            }
          ]
        },
        {
          "id": "w-253",
          "hanzi": "也",
          "pinyin": "yě",
          "meaning_en": "also",
          "primary_pos_id": "adverb",
          "pos_ids": [
            "adverb"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-253-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我也喜欢茶。",
              "pinyin": "wǒ yě xǐhuan chá.",
              "english": "I also like tea.",
              "teaching_note": "也 means also; it normally appears before the verb or adjective predicate."
            },
            {
              "id": "ex-253-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学生也可以在这里看书。",
              "pinyin": "xuéshēng yě kěyǐ zài zhèlǐ kàn shū.",
              "english": "Students can also read books here.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 253
            }
          ]
        },
        {
          "id": "w-270",
          "hanzi": "再",
          "pinyin": "zài",
          "meaning_en": "again",
          "primary_pos_id": "adverb",
          "pos_ids": [
            "adverb"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-270-1",
              "style": "conversational",
              "register": "polite",
              "hanzi": "请再说一次。",
              "pinyin": "qǐng zài shuō yí cì.",
              "english": "Please say it again.",
              "teaching_note": "再 indicates repetition; 一次 is one occurrence, and 一 is pronounced yí before 次."
            },
            {
              "id": "ex-270-2",
              "style": "written",
              "register": "polite_instruction",
              "hanzi": "请明天再来。",
              "pinyin": "qǐng míngtiān zài lái.",
              "english": "Please come back tomorrow.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 270
            }
          ]
        },
        {
          "id": "w-271",
          "hanzi": "在",
          "pinyin": "zài",
          "meaning_en": "at; in",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb",
            "preposition",
            "adverb"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-271-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我在家。",
              "pinyin": "wǒ zài jiā.",
              "english": "I am at home.",
              "teaching_note": "在 + location states where the speaker is, not what they are doing."
            },
            {
              "id": "ex-271-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "我们在学校上课。",
              "pinyin": "wǒmen zài xuéxiào shàngkè.",
              "english": "We have class at school.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 271
            }
          ],
          "pos_note": "Three common functions: verb of location (我在家), preposition/coverb introducing a place (我们在学校上课), and progressive adverb before a verb (我在看书). The first two are illustrated here; the primary lexicographic POS remains Verb."
        },
        {
          "id": "w-285",
          "hanzi": "真",
          "pinyin": "zhēn",
          "meaning_en": "really",
          "primary_pos_id": "adverb",
          "pos_ids": [
            "adverb",
            "adjective"
          ],
          "topic_ids": [
            "grammar-functions",
            "qualities-feelings"
          ],
          "examples": [
            {
              "id": "ex-285-1",
              "style": "conversational",
              "register": "informal",
              "hanzi": "今天天气真好！",
              "pinyin": "jīntiān tiānqì zhēn hǎo!",
              "english": "The weather is really nice today!",
              "teaching_note": "真 adds strong, spontaneous positive emphasis to 好."
            },
            {
              "id": "ex-285-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "这家饭店的菜真好吃！",
              "pinyin": "zhè jiā fàndiàn de cài zhēn hǎochī!",
              "english": "The food at this restaurant is really delicious!",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 285
            }
          ],
          "pos_note": "Degree adverb truly/really, sometimes adjectival."
        },
        {
          "id": "w-286",
          "hanzi": "正在",
          "pinyin": "zhèngzài",
          "meaning_en": "currently; in progress",
          "primary_pos_id": "adverb",
          "pos_ids": [
            "adverb"
          ],
          "topic_ids": [
            "grammar-functions"
          ],
          "examples": [
            {
              "id": "ex-286-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我正在看书。",
              "pinyin": "wǒ zhèngzài kàn shū.",
              "english": "I am reading a book right now.",
              "teaching_note": "正在 makes the ongoing action explicit: reading right now."
            },
            {
              "id": "ex-286-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学生们正在上课。",
              "pinyin": "xuéshēngmen zhèngzài shàngkè.",
              "english": "The students are having class right now.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
