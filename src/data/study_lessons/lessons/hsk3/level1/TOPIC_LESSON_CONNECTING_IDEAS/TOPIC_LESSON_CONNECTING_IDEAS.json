            {
              "id": "ex-286-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学生们正在上课。",
              "pinyin": "xuéshēngmen zhèngzài shàngkè.",
              "english": "The students are having class right now.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 286
            }
          ],
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "primary_topic_id": "grammar-functions"
        }
      ],
