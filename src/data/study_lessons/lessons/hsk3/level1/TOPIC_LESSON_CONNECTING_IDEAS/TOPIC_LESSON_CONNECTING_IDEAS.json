    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Connecting and Emphasizing Ideas",
        "context_en": "Two students compare their activities. Practise linkers, emphasis, and the difference between 在 (zài) and 正在 (zhèngzài).",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你在看书吗？",
            "pinyin": "Nǐ zài kàn shū ma?",
            "english": "Are you reading?"
          },
          {
            "speaker": "B",
            "hanzi": "是，我也在听歌。",
            "pinyin": "Shì, wǒ yě zài tīng gē.",
            "english": "Yes, and I am also listening to music."
          },
          {
            "speaker": "A",
            "hanzi": "你今天很忙吗？",
            "pinyin": "Nǐ jīntiān hěn máng ma?",
            "english": "Are you busy today?"
          },
          {
            "speaker": "B",
            "hanzi": "很忙，但是我还想看电影。",
            "pinyin": "Hěn máng, dànshì wǒ hái xiǎng kàn diànyǐng.",
            "english": "Very busy, but I still want to watch a movie."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Adding and combining information",
          "explanation_en": "也 (yě) means “also” and usually goes before the verb. 都 (dōu) means “all/both” when applied to an established group; 和 (hé) connects nouns or noun phrases.",
          "examples": [
            {
              "hanzi": "妹妹也喜欢喝茶。",
              "pinyin": "Mèimei yě xǐhuan hē chá.",
              "english": "My younger sister also likes drinking tea."
            },
            {
              "hanzi": "我们都喜欢中文。",
              "pinyin": "Wǒmen dōu xǐhuan Zhōngwén.",
              "english": "We all like Chinese."
            }
          ],
          "pattern_hanzi": "主语 + 也 + 动词; 一群人 + 都 + 动词",
          "pattern_pinyin": "zhǔyǔ + yě + dòngcí; yì qún rén + dōu + dòngcí",
          "pattern_pseudo_translation": "<subject> + 也 + <verb>; <group> + 都 + <verb>"
        },
        {
          "id": "pattern-2",
          "title": "Degree and ongoing actions",
          "explanation_en": "很 (hěn), 非常 (fēicháng), 真 (zhēn) and 太 (tài) modify degree with different nuance. 正在 (zhèngzài) explicitly signals an activity in progress.",
          "examples": [
            {
              "hanzi": "她正在做饭。",
              "pinyin": "Tā zhèngzài zuò fàn.",
              "english": "She is cooking right now."
            },
            {
              "hanzi": "今天真热！",
              "pinyin": "Jīntiān zhēn rè!",
              "english": "It is really hot today!"
            }
          ],
          "pattern_hanzi": "主语 + 正在 + 动词",
          "pattern_pinyin": "zhǔyǔ + zhèngzài + dòngcí",
          "pattern_pseudo_translation": "<subject> + 正在 + <verb>"
        }
      ],
      "guided_building": {
        "instruction_en": "Use 也 to add another person doing the activity.",
        "model": {
          "hanzi": "我看书。她也看书。",
          "pinyin": "Wǒ kàn shū. Tā yě kàn shū.",
          "english": "I read. She reads too."
        },
        "substitutions": [
          {
            "cue_en": "studying",
            "model_answer": {
              "hanzi": "我学习。他也学习。",
              "pinyin": "Wǒ xuéxí. Tā yě xuéxí.",
              "english": "I study. He studies too."
            },
            "id": "build-sub-01"
          },
          {
            "cue_en": "drinking water",
            "model_answer": {
              "hanzi": "我喝水。你也喝水。",
              "pinyin": "Wǒ hē shuǐ. Nǐ yě hē shuǐ.",
              "english": "I drink water. You drink water too."
            },
            "id": "build-sub-02"
          }
        ]
      },
      "reading": {
        "title": "A short connected story",
        "paragraphs": [
          {
            "hanzi": "哥哥和妹妹都在家。哥哥正在看书，妹妹在写字。他们也听歌。",
            "pinyin": "Gēge hé mèimei dōu zài jiā. Gēge zhèngzài kàn shū, mèimei zài xiě zì. Tāmen yě tīng gē.",
            "english": "The older brother and younger sister are both at home. He is reading while she is writing. They also listen to songs."
          }
        ],
        "questions": [
          {
            "prompt_en": "Where are the brother and sister?",
            "answer_en": "Both are at home.",
            "id": "reading-q-01"
          },
          {
            "prompt_en": "Who is writing?",
            "answer_en": "The younger sister.",
            "id": "reading-q-02"
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Explain what you and a friend both like.",
          "model_answer": {
            "hanzi": "我们都喜欢看电影。",
            "pinyin": "Wǒmen dōu xǐhuan kàn diànyǐng.",
            "english": "We both like watching movies."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Describe what someone is doing right now.",
          "model_answer": {
            "hanzi": "他正在写字。",
            "pinyin": "Tā zhèngzài xiě zì.",
            "english": "He is writing characters right now."
          }
        }
      ],
      "common_pitfall": "和 (hé) normally joins nouns, not two independent clauses in the way English “and” does. Use a comma or appropriate connector instead.",
      "pronunciation_focus": "Distinguish 在 (zài) as a location preposition from 在 (zài) as an aspect marker; word order supplies the interpretation.",
      "review": {
        "can_do": [
          "Express degree and emphasis.",
          "Recognize coordination and repetition.",
          "Understand ongoing actions in simple sentences."
        ],
