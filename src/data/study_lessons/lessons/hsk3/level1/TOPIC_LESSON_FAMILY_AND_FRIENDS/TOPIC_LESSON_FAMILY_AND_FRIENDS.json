          "examples": [
            {
              "id": "ex-001-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我爱我的家。",
              "pinyin": "wǒ ài wǒ de jiā.",
              "english": "I love my family.",
              "teaching_note": "爱 expresses strong affection here; 家 can refer both to the home and to one’s family."
            },
