      "items": [
        {
          "id": "w-082",
          "hanzi": "会",
          "pinyin": "huì",
          "meaning_en": "can; know how",
          "primary_pos_id": "modal-verb",
          "pos_ids": [
            "modal-verb"
          ],
          "topic_ids": [
            "daily-actions"
          ],
          "examples": [
            {
              "id": "ex-082-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我会说汉语。",
              "pinyin": "wǒ huì shuō Hànyǔ.",
              "english": "I can speak Chinese.",
              "teaching_note": "会 refers to an acquired skill, such as speaking a language."
            },
            {
              "id": "ex-082-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "她会写很多汉字。",
              "pinyin": "tā huì xiě hěn duō hànzì.",
              "english": "She can write many Chinese characters.",
              "teaching_note": "The modal expresses a learned skill."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 82
            }
          ],
          "pos_note": "Modal use for learned ability; the full word has other uses.",
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "primary_topic_id": "daily-actions"
        },
        {
          "id": "w-096",
