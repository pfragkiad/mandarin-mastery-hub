    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "What I Can and Want to Do",
        "context_en": "Two classmates are planning what to do after class. Notice how ability and desire lead to different answers.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你会唱歌吗？",
            "pinyin": "Nǐ huì chàng gē ma?",
            "english": "Can you sing?"
          },
          {
            "speaker": "B",
            "hanzi": "我会唱，但是我今天不想唱。",
            "pinyin": "Wǒ huì chàng, dànshì wǒ jīntiān bù xiǎng chàng.",
            "english": "I can sing, but I don't want to today."
          },
          {
            "speaker": "A",
            "hanzi": "那你想看电影吗？",
            "pinyin": "Nà nǐ xiǎng kàn diànyǐng ma?",
            "english": "Then would you like to watch a movie?"
          },
          {
            "speaker": "B",
            "hanzi": "想！我们一起去吧。",
            "pinyin": "Xiǎng! Wǒmen yìqǐ qù ba.",
            "english": "Yes! Let's go together."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Ability: 会 (huì) versus 能 (néng)",
          "explanation_en": "会 (huì) often refers to a learned skill; 能 (néng) refers to capability or what circumstances permit. They can overlap in some situations.",
          "formula_en": "Subject + 会/能 + verb",
          "examples": [
            {
              "hanzi": "我也会说一点儿汉语。",
              "pinyin": "Wǒ yě huì shuō yìdiǎnr Hànyǔ.",
              "english": "I can also speak a little Chinese."
            },
            {
              "hanzi": "我今天能去。",
              "pinyin": "Wǒ jīntiān néng qù.",
              "english": "I can go today (circumstances allow)."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Desire: 想 (xiǎng) versus 要 (yào)",
          "explanation_en": "想 (xiǎng) generally makes a wish softer; 要 (yào) can express a firmer desire, intention or need. Neither is an automatic substitute for 会 (huì).",
          "formula_en": "Subject + 想/要 + verb/noun",
          "examples": [
            {
              "hanzi": "我想喝茶。",
              "pinyin": "Wǒ xiǎng hē chá.",
              "english": "I would like some tea."
            },
            {
              "hanzi": "我要看这本书。",
              "pinyin": "Wǒ yào kàn zhè běn shū.",
              "english": "I want to read this book."
            }
          ]
        }
      ],
