        {
          "id": "w-102",
          "hanzi": "可以",
          "pinyin": "kěyǐ",
          "meaning_en": "may; can",
          "primary_pos_id": "modal-verb",
          "pos_ids": [
            "modal-verb",
            "adjective"
          ],
          "topic_ids": [
            "daily-actions"
          ],
          "examples": [
            {
              "id": "ex-102-1",
              "style": "conversational",
              "register": "polite",
              "hanzi": "我可以坐这儿吗？",
              "pinyin": "wǒ kěyǐ zuò zhèr ma?",
              "english": "May I sit here?",
              "teaching_note": "可以…吗 requests permission. 坐这儿 is natural colloquial Mandarin; 坐在这里 is an alternative."
            },
            {
              "id": "ex-102-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "这里可以看书，也可以休息。",
              "pinyin": "zhèlǐ kěyǐ kàn shū, yě kěyǐ xiūxi.",
              "english": "You can read books and rest here.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 102
            }
          ],
          "pos_note": "Modal/verb expressing permission or possibility; some lexical sources also label adjectival use.",
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "primary_topic_id": "daily-actions"
        },
        {
