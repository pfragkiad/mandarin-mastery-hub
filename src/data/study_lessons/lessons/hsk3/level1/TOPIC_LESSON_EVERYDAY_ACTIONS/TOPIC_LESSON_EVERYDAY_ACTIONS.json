    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Things We Do Every Day",
        "context_en": "Two people are getting ready to go out. Follow the order of activities and the difference between 看 (kàn) and 看见 (kànjiàn).",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你在做什么？",
            "pinyin": "Nǐ zài zuò shénme?",
            "english": "What are you doing?"
          },
          {
            "speaker": "B",
            "hanzi": "我正在找我的手机。",
            "pinyin": "Wǒ zhèngzài zhǎo wǒ de shǒujī.",
            "english": "I am looking for my phone right now."
          },
          {
            "speaker": "A",
            "hanzi": "你看见了吗？",
            "pinyin": "Nǐ kànjiàn le ma?",
            "english": "Have you seen it?"
          },
          {
            "speaker": "B",
            "hanzi": "看见了，在桌子上。",
            "pinyin": "Kànjiàn le, zài zhuōzi shàng.",
            "english": "Yes, I have; it is on the table."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Looking versus seeing",
          "explanation_en": "看 (kàn) is the act of looking; 看见 (kànjiàn) expresses the result of perceiving visually. Searching with 找 (zhǎo) does not guarantee you find the object.",
          "formula_en": "look/search → result",
          "examples": [
            {
              "hanzi": "我在看外边。",
              "pinyin": "Wǒ zài kàn wàibian.",
              "english": "I am looking outside."
            },
            {
              "hanzi": "我看见那只猫了。",
              "pinyin": "Wǒ kànjiàn nà zhī māo le.",
              "english": "I spotted that cat."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Give and receive",
          "explanation_en": "给 (gěi) can introduce a recipient before a noun phrase or, in simple requests, act as a verb meaning “give”.",
          "formula_en": "给 + person + object",
          "examples": [
            {
              "hanzi": "请给我那本书。",
              "pinyin": "Qǐng gěi wǒ nà běn shū.",
              "english": "Please give me that book."
            },
            {
              "hanzi": "我给朋友打电话。",
              "pinyin": "Wǒ gěi péngyou dǎ diànhuà.",
              "english": "I call a friend."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Switch the searched-for item while keeping the question and answer natural.",
        "model": {
          "hanzi": "你看见我的书了吗？",
          "pinyin": "Nǐ kànjiàn wǒ de shū le ma?",
          "english": "Have you seen my book?"
        },
        "substitutions": [
          {
            "cue_en": "phone",
            "model_answer": {
              "hanzi": "你看见我的手机了吗？",
              "pinyin": "Nǐ kànjiàn wǒ de shǒujī le ma?",
              "english": "Have you seen my phone?"
            },
            "id": "build-sub-01"
          },
          {
            "cue_en": "bag",
            "model_answer": {
              "hanzi": "你看见我的包了吗？",
              "pinyin": "Nǐ kànjiàn wǒ de bāo le ma?",
              "english": "Have you seen my bag?"
            },
            "id": "build-sub-02"
          }
        ]
      },
      "reading": {
        "title": "A short connected story",
        "paragraphs": [
          {
            "hanzi": "小红今天要去学校。她找不到书，所以给同学打电话。同学说书在教室里。",
            "pinyin": "Xiǎo Hóng jīntiān yào qù xuéxiào. Tā zhǎo bú dào shū, suǒyǐ gěi tóngxué dǎ diànhuà. Tóngxué shuō shū zài jiàoshì lǐ.",
            "english": "Xiao Hong is going to school today. She cannot find her book, so she calls a classmate. The classmate says it is in the classroom."
          }
        ],
        "questions": [
          {
            "prompt_en": "Why does Xiao Hong call a classmate?",
            "answer_en": "She cannot find her book.",
            "id": "reading-q-01"
          },
          {
            "prompt_en": "Where is the book?",
            "answer_en": "In the classroom.",
            "id": "reading-q-02"
          }
        ]
      },
      "speaking_tasks": [
        {
