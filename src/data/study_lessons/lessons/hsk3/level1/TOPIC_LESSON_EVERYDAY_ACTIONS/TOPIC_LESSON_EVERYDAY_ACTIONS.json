          "id": "w-023",
          "hanzi": "穿",
          "pinyin": "chuān",
          "meaning_en": "wear",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb"
          ],
          "topic_ids": [
            "daily-actions"
          ],
          "examples": [
            {
              "id": "ex-023-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "今天我穿新衣服。",
              "pinyin": "jīntiān wǒ chuān xīn yīfu.",
              "english": "I am wearing new clothes today.",
              "teaching_note": "穿 refers to wearing clothes; Chinese does not need a progressive form for the current outfit."
            },
            {
              "id": "ex-023-2",
              "style": "written",
              "register": "polite_instruction",
              "hanzi": "天气冷的时候，请多穿衣服。",
              "pinyin": "tiānqì lěng de shíhou, qǐng duō chuān yīfu.",
              "english": "When it is cold, please wear more clothes.",
              "teaching_note": ""
            }
          ],
