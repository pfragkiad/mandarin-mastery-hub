      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Learning Chinese",
        "context_en": "Two classmates plan how to practise listening, speaking, reading and writing in Mandarin.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你今天学什么？",
            "pinyin": "Nǐ jīntiān xué shénme?",
            "english": "What are you studying today?"
          },
          {
            "speaker": "B",
            "hanzi": "我学汉语，也喜欢说汉语。",
            "pinyin": "Wǒ xué Hànyǔ, yě xǐhuan shuō Hànyǔ.",
            "english": "I study Chinese and also enjoy speaking it."
          },
          {
            "speaker": "A",
            "hanzi": "你会写汉字吗？",
            "pinyin": "Nǐ huì xiě Hànzì ma?",
            "english": "Can you write Chinese characters?"
          },
          {
            "speaker": "B",
            "hanzi": "会一点儿，但是我写得很慢。",
            "pinyin": "Huì yìdiǎnr, dànshì wǒ xiě de hěn màn.",
            "english": "A little, but I write slowly."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Learning versus a class session",
          "explanation_en": "学习 (xuéxí) means studying or learning; 上课 (shàngkè) means attending class; 下课 (xiàkè) means finishing class or the class period ending.",
          "examples": [
            {
              "hanzi": "我在学习中文。",
              "pinyin": "Wǒ zài xuéxí Zhōngwén.",
              "english": "I am studying Chinese."
            },
            {
              "hanzi": "我们上午九点上课。",
              "pinyin": "Wǒmen shàngwǔ jiǔ diǎn shàngkè.",
              "english": "We have class at 9 a.m."
            }
          ],
          "pattern_hanzi": "人 + 在 + 动词 + 宾语",
          "pattern_pinyin": "rén + zài + dòngcí + bīnyǔ",
          "pattern_pseudo_translation": "<person> + 在 + <verb> + <object>"
        },
        {
          "id": "pattern-2",
          "title": "Four basic language skills",
          "explanation_en": "听 (tīng) is the act of listening and 听见 (tīngjiàn) is the result of hearing. Read with 读 (dú), speak with 说 (shuō), write with 写 (xiě).",
          "examples": [
            {
              "hanzi": "我喜欢听汉语。",
              "pinyin": "Wǒ xǐhuan tīng Hànyǔ.",
              "english": "I like listening to Chinese."
            },
            {
              "hanzi": "她每天读中文书。",
              "pinyin": "Tā měi tiān dú Zhōngwén shū.",
              "english": "She reads Chinese books every day."
            }
          ],
          "pattern_hanzi": "我 + 技能动词 + 宾语",
          "pattern_pinyin": "wǒ + jìnéng dòngcí + bīnyǔ",
          "pattern_pseudo_translation": "我 + <skill verb> + <object>"
        }
      ],
      "guided_building": {
