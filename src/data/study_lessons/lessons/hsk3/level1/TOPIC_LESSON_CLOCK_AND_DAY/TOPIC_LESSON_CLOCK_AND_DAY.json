    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Talking About the Clock",
        "context_en": "A classmate asks about a meeting time. Learn to distinguish a clock reading from a duration.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "现在几点了？",
            "pinyin": "Xiànzài jǐ diǎn le?",
            "english": "What time is it now?"
          },
          {
            "speaker": "B",
            "hanzi": "上午九点半。",
            "pinyin": "Shàngwǔ jiǔ diǎn bàn.",
            "english": "Half past nine in the morning."
          },
          {
            "speaker": "A",
            "hanzi": "我们几点上课？",
            "pinyin": "Wǒmen jǐ diǎn shàngkè?",
            "english": "What time does class start?"
          },
          {
            "speaker": "B",
            "hanzi": "十点，还有半个小时。",
            "pinyin": "Shí diǎn, hái yǒu bàn ge xiǎoshí.",
            "english": "At ten; there is another half hour."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Asking and stating clock time",
          "explanation_en": "几点 (jǐ diǎn) asks for a clock time; put the time before the action to say when something happens. 半 (bàn) gives half past.",
          "examples": [
            {
              "hanzi": "我们下午三点见。",
              "pinyin": "Wǒmen xiàwǔ sān diǎn jiàn.",
              "english": "Let’s meet at 3 p.m."
            },
            {
              "hanzi": "现在八点十五分。",
              "pinyin": "Xiànzài bā diǎn shíwǔ fēn.",
              "english": "It is 8:15 now."
            }
          ],
          "pattern_hanzi": "时间 + 主语 + 动词 / 主语 + 时间 + 动词",
          "pattern_pinyin": "shíjiān + zhǔyǔ + dòngcí / zhǔyǔ + shíjiān + dòngcí",
          "pattern_pseudo_translation": "<time> + <subject> + <verb> / <subject> + <time> + <verb>"
        },
        {
          "id": "pattern-2",
          "title": "Time point versus duration",
          "explanation_en": "点 (diǎn) is a clock hour. 小时 (xiǎoshí) expresses hours of duration; 分钟 (fēnzhōng) expresses minutes of duration. The left side is a clock time. The right side is a duration.",
          "examples": [
            {
              "hanzi": "我九点上班。",
              "pinyin": "Wǒ jiǔ diǎn shàngbān.",
              "english": "I start work at nine."
            },
            {
              "hanzi": "我学习两个小时。",
              "pinyin": "Wǒ xuéxí liǎng ge xiǎoshí.",
              "english": "I study for two hours."
            }
          ],
          "pattern_hanzi": "九点 ≠ 九个小时",
          "pattern_pinyin": "jiǔ diǎn ≠ jiǔ ge xiǎoshí",
          "pattern_pseudo_translation": "九点 ≠ 九个小时"
        }
      ],
      "guided_building": {
        "instruction_en": "Change the meeting time in a complete invitation.",
        "model": {
          "hanzi": "我们三点见。",
          "pinyin": "Wǒmen sān diǎn jiàn.",
          "english": "Let us meet at three."
        },
        "substitutions": [
          {
            "cue_en": "four",
            "model_answer": {
              "hanzi": "我们四点见。",
              "pinyin": "Wǒmen sì diǎn jiàn.",
              "english": "Let us meet at four."
            },
            "id": "build-sub-01"
          },
          {
            "cue_en": "half past five",
            "model_answer": {
              "hanzi": "我们五点半见。",
              "pinyin": "Wǒmen wǔ diǎn bàn jiàn.",
              "english": "Let us meet at five thirty."
            },
            "id": "build-sub-02"
          }
        ]
      },
      "reading": {
        "title": "A short connected story",
        "paragraphs": [
          {
            "hanzi": "妈妈下午两点下班，三点到家。她晚上七点吃晚饭。",
            "pinyin": "Māma xiàwǔ liǎng diǎn xiàbān, sān diǎn dào jiā. Tā wǎnshang qī diǎn chī wǎnfàn.",
            "english": "Mom finishes work at 2 p.m. and arrives home at three. She eats dinner at 7 p.m."
          }
        ],
        "questions": [
          {
            "prompt_en": "At what time does Mom finish work?",
            "answer_en": "2 p.m.",
            "id": "reading-q-01"
          },
          {
            "prompt_en": "At what time does she eat dinner?",
            "answer_en": "7 p.m.",
            "id": "reading-q-02"
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Ask the current time and answer.",
          "model_answer": {
            "hanzi": "现在几点？现在十点。",
            "pinyin": "Xiànzài jǐ diǎn? Xiànzài shí diǎn.",
            "english": "What time is it? It is ten."
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Say how many hours you study, not when you study.",
          "model_answer": {
            "hanzi": "我学习两个小时。",
            "pinyin": "Wǒ xuéxí liǎng ge xiǎoshí.",
            "english": "I study for two hours."
          }
        }
      ],
      "common_pitfall": "Do not confuse 三点 (sān diǎn, 3 o’clock) with 三个小时 (sān ge xiǎoshí, three hours).",
      "pronunciation_focus": "Read 点 (diǎn) as third tone; in two third tones, 九点 (jiǔ diǎn) is pronounced with third-tone sandhi in connected speech.",
