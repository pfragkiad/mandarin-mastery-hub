    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "School and University",
        "context_en": "A younger student and an older student compare which schools they attend.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你在哪儿上学？",
            "pinyin": "Nǐ zài nǎr shàngxué?",
            "english": "Where do you go to school?"
          },
          {
            "speaker": "B",
            "hanzi": "我在中学上学。",
            "pinyin": "Wǒ zài zhōngxué shàngxué.",
            "english": "I go to middle school."
          },
          {
            "speaker": "A",
            "hanzi": "你姐姐呢？",
            "pinyin": "Nǐ jiějie ne?",
            "english": "What about your older sister?"
          },
          {
            "speaker": "B",
            "hanzi": "她是大学生，也学汉语。",
            "pinyin": "Tā shì dàxuéshēng, yě xué Hànyǔ.",
            "english": "She is a university student and studies Chinese too."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "School versus student",
          "explanation_en": "学校 (xuéxiào) is a school or educational institution; 学生 (xuéshēng) is a learner. Combining 小学/中学/大学 with 生 specifies the student level.",
          "formula_en": "school name + 生 → student type",
          "examples": [
            {
              "hanzi": "我弟弟是小学生。",
              "pinyin": "Wǒ dìdi shì xiǎoxuéshēng.",
              "english": "My younger brother is a primary-school pupil."
            },
            {
              "hanzi": "她在大学学习。",
              "pinyin": "Tā zài dàxué xuéxí.",
              "english": "She studies at university."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Attending school: 上学 (shàngxué)",
          "explanation_en": "上学 (shàngxué) describes attending school; 上课 (shàngkè) describes having/attending a class. The two do not mean exactly the same thing.",
          "formula_en": "subject + 在 + place + 上学",
          "examples": [
            {
              "hanzi": "我在北京上学。",
              "pinyin": "Wǒ zài Běijīng shàngxué.",
              "english": "I attend school in Beijing."
            },
            {
              "hanzi": "我们上午上课。",
              "pinyin": "Wǒmen shàngwǔ shàngkè.",
              "english": "We have class in the morning."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Change only the school level while keeping the identity sentence.",
        "model": {
          "hanzi": "我是中学生。",
          "pinyin": "Wǒ shì zhōngxuéshēng.",
          "english": "I am a middle-school student."
        },
