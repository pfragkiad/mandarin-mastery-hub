    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Animals and Weather",
        "context_en": "Two friends decide whether to go outside and talk about the weather and a pet.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "今天天气怎么样？",
            "pinyin": "Jīntiān tiānqì zěnmeyàng?",
            "english": "How is the weather today?"
          },
          {
            "speaker": "B",
            "hanzi": "很冷，还下雨。",
