      "dialogue": {
        "title": "Making Basic Statements",
        "context_en": "Listen to how small particles change the *function* of a sentence, not its main vocabulary.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你是老师吗？",
            "pinyin": "Nǐ shì lǎoshī ma?",
            "english": "Are you a teacher?"
          },
          {
            "speaker": "B",
            "hanzi": "不是，我是学生。",
            "pinyin": "Bú shì, wǒ shì xuéshēng.",
            "english": "No, I am a student."
          },
          {
            "speaker": "A",
            "hanzi": "你有电脑吗？",
            "pinyin": "Nǐ yǒu diànnǎo ma?",
            "english": "Do you have a computer?"
          },
          {
