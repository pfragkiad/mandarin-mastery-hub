            "classifier"
          ],
          "topic_ids": [
            "numbers-quantities"
          ],
          "examples": [
            {
              "id": "ex-010-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我买了两本书。",
              "pinyin": "wǒ mǎi le liǎng běn shū.",
              "english": "I bought two books.",
              "teaching_note": "本 is the standard classifier for books; 两 normally precedes classifiers rather than 二."
            },
            {
              "id": "ex-010-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学生每人有一本书。",
              "pinyin": "xuéshēng měi rén yǒu yì běn shū.",
              "english": "Every student has one book.",
              "teaching_note": ""
