    "vocabulary": {
      "items": [
        {
          "id": "w-007",
          "hanzi": "半",
          "pinyin": "bàn",
          "meaning_en": "half",
          "primary_pos_id": "numeral",
          "pos_ids": [
            "numeral",
            "adverb"
          ],
          "topic_ids": [
            "numbers-quantities",
            "time-calendar"
          ],
          "examples": [
            {
              "id": "ex-007-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "现在是八点半。",
              "pinyin": "xiànzài shì bā diǎn bàn.",
              "english": "It is half past eight now.",
              "teaching_note": "八点半 is the ordinary way to say 8:30; 半 means half an hour."
            },
            {
              "id": "ex-007-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学校上午八点半上课。",
              "pinyin": "xuéxiào shàngwǔ bā diǎn bàn shàngkè.",
              "english": "Classes at the school start at 8:30 a.m.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 7
            }
          ],
          "pos_note": "Primarily the numeral “half” (半个小时, 八点半). Also has a restricted adverbial role meaning partly/half- in advanced patterns; that secondary role is not a Level 1 teaching priority.",
          "primary_subtopic_id": null,
          "subtopic_ids": [],
          "primary_topic_id": "numbers-quantities"
        },
        {
          "id": "w-010",
          "hanzi": "本",
          "pinyin": "běn",
