              "id": "ex-060-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "这个班有二十个学生。",
              "pinyin": "zhège bān yǒu èr shí gè xuéshēng.",
              "english": "There are twenty students in this class.",
              "teaching_note": ""
            }
          ],
