    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Counting Real Things",
        "context_en": "A shopper chooses books and clothing. Practise different classifiers and small amounts.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你要买几本书？",
            "pinyin": "Nǐ yào mǎi jǐ běn shū?",
            "english": "How many books do you want to buy?"
          },
          {
            "speaker": "B",
            "hanzi": "我要买两本。",
            "pinyin": "Wǒ yào mǎi liǎng běn.",
            "english": "I want to buy two."
          },
          {
            "speaker": "A",
            "hanzi": "你还要衣服吗？",
            "pinyin": "Nǐ hái yào yīfu ma?",
            "english": "Do you want clothes too?"
          },
          {
            "speaker": "B",
            "hanzi": "要，我想买一件。",
            "pinyin": "Yào, wǒ xiǎng mǎi yí jiàn.",
            "english": "Yes, I want to buy one item."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Classifiers for countable objects",
          "explanation_en": "Chinese normally uses a measure word between a numeral and a noun. 本 (běn) counts bound books; 件 (jiàn) counts many items of clothing; 个 (gè) is common but not universal.",
          "examples": [
            {
              "hanzi": "桌子上有两本书。",
              "pinyin": "Zhuōzi shàng yǒu liǎng běn shū.",
              "english": "There are two books on the table."
            },
            {
              "hanzi": "我买了三件衣服。",
              "pinyin": "Wǒ mǎi le sān jiàn yīfu.",
              "english": "I bought three items of clothing."
            }
          ],
          "pattern_hanzi": "数字 + 量词 + 名词",
          "pattern_pinyin": "shùzì + liàngcí + míngcí",
          "pattern_pseudo_translation": "<number> + <classifier> + <noun>"
        },
        {
          "id": "pattern-2",
          "title": "两 (liǎng), 几 (jǐ), and 多少 (duōshao)",
          "explanation_en": "两 (liǎng) generally precedes classifiers for two items; 几 (jǐ) is natural for small expected numbers; 多少 (duōshao) has a broader numerical range.",
          "examples": [
            {
              "hanzi": "你有几个好朋友？",
              "pinyin": "Nǐ yǒu jǐ ge hǎo péngyou?",
              "english": "How many close friends do you have?"
            },
            {
              "hanzi": "这本书多少钱？",
              "pinyin": "Zhè běn shū duōshao qián?",
              "english": "How much does this book cost?"
            }
          ],
          "pattern_hanzi": "几 + 量词 + 名词？",
          "pattern_pinyin": "jǐ + liàngcí + míngcí?",
          "pattern_pseudo_translation": "几 + <classifier> + <noun>？"
        }
      ],
      "guided_building": {
        "instruction_en": "Use the appropriate classifier for different objects.",
        "model": {
          "hanzi": "我有两本书。",
          "pinyin": "Wǒ yǒu liǎng běn shū.",
          "english": "I have two books."
        },
        "substitutions": [
          {
            "cue_en": "three pieces of clothing",
            "model_answer": {
              "hanzi": "我有三件衣服。",
              "pinyin": "Wǒ yǒu sān jiàn yīfu.",
              "english": "I have three pieces of clothing."
            },
            "id": "build-sub-01"
          },
          {
            "cue_en": "two cats",
            "model_answer": {
              "hanzi": "我有两只猫。",
              "pinyin": "Wǒ yǒu liǎng zhī māo.",
              "english": "I have two cats."
            },
            "id": "build-sub-02"
          }
        ]
      },
      "reading": {
        "title": "A short connected story",
        "paragraphs": [
          {
            "hanzi": "桌子上有五本书，两本是我的。姐姐买了三件衣服，妹妹只买了一件。",
            "pinyin": "Zhuōzi shàng yǒu wǔ běn shū, liǎng běn shì wǒ de. Jiějie mǎi le sān jiàn yīfu, mèimei zhǐ mǎi le yí jiàn.",
            "english": "There are five books on the table; two are mine. The older sister bought three pieces of clothing; the younger sister bought only one."
          }
        ],
        "questions": [
          {
            "prompt_en": "How many books belong to the speaker?",
            "answer_en": "Two.",
            "id": "reading-q-01"
          },
          {
            "prompt_en": "Who bought more clothing?",
            "answer_en": "The older sister.",
            "id": "reading-q-02"
          }
        ]
      },
      "speaking_tasks": [
        {
          "id": "speaking-1",
          "scenario_en": "Ask how many books someone has.",
          "model_answer": {
            "hanzi": "你有几本书？",
            "pinyin": "Nǐ yǒu jǐ běn shū?",
            "english": "How many books do you have?"
          }
        },
        {
          "id": "speaking-2",
          "scenario_en": "Say you need a little water.",
          "model_answer": {
            "hanzi": "我想喝一点儿水。",
            "pinyin": "Wǒ xiǎng hē yìdiǎnr shuǐ.",
            "english": "I would like a little water."
          }
        }
      ],
      "common_pitfall": "Do not use the same classifier for all nouns. For a book use 本 (běn), not 件 (jiàn).",
      "pronunciation_focus": "The contrast 二 (èr) versus 两 (liǎng) is especially important before classifiers: 两本 (liǎng běn).",
      "review": {
        "can_do": [
          "Use common classifiers with familiar nouns.",
          "Differentiate exact and approximate quantities.",
          "Understand expressions of halves, a little and some."
        ],
        "entry_ids": [
          10,
          60,
          85,
          89,
          111,
          287
        ]
      }
    }
  },
