    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Buying Everyday Things",
        "context_en": "A shopper compares prices and decides what to buy for a room.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "这个杯子多少钱？",
            "pinyin": "Zhège bēizi duōshao qián?",
            "english": "How much is this cup?"
          },
          {
            "speaker": "B",
            "hanzi": "二十块。",
            "pinyin": "Èr shí kuài.",
            "english": "Twenty yuan."
          },
          {
            "speaker": "A",
            "hanzi": "有便宜一点儿的吗？",
            "pinyin": "Yǒu piányi yìdiǎnr de ma?",
            "english": "Do you have a slightly cheaper one?"
          },
          {
            "speaker": "B",
            "hanzi": "有，那个十五块。",
            "pinyin": "Yǒu, nàge shíwǔ kuài.",
            "english": "Yes, that one is fifteen yuan."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Prices: 元 (yuán) and 块 (kuài)",
          "explanation_en": "元 (yuán) names the currency unit; 块 (kuài) is a common colloquial word for yuan. Use 多少钱 (duōshao qián) to ask price.",
          "examples": [
            {
              "hanzi": "这件衣服五十元。",
              "pinyin": "Zhè jiàn yīfu wǔ shí yuán.",
              "english": "This item of clothing is fifty yuan."
            },
            {
              "hanzi": "那张桌子一百块。",
              "pinyin": "Nà zhāng zhuōzi yì bǎi kuài.",
              "english": "That table is one hundred yuan."
            }
          ],
          "pattern_hanzi": "物品 + 多少钱？ / 数字 + 块",
          "pattern_pinyin": "wùpǐn + duōshao qián? / shùzì + kuài",
          "pattern_pseudo_translation": "<item> + 多少钱？ / <number> + 块"
        },
        {
          "id": "pattern-2",
          "title": "Buying versus selling",
          "explanation_en": "买 (mǎi) means “buy” and 卖 (mài) means “sell”. Their tone difference changes the meaning. 贵 (guì) and 便宜 (piányi) describe price.",
          "examples": [
            {
              "hanzi": "这家商店卖手机。",
              "pinyin": "Zhè jiā shāngdiàn mài shǒujī.",
              "english": "This shop sells mobile phones."
            },
            {
              "hanzi": "我想买新电脑。",
              "pinyin": "Wǒ xiǎng mǎi xīn diànnǎo.",
              "english": "I want to buy a new computer."
            }
          ],
          "pattern_hanzi": "商店 + 卖 + 物品; 顾客 + 买 + 物品",
          "pattern_pinyin": "shāngdiàn + mài + wùpǐn; gùkè + mǎi + wùpǐn",
          "pattern_pseudo_translation": "<shop> + 卖 + <item>; <customer> + 买 + <item>"
        }
      ],
      "guided_building": {
        "instruction_en": "Change the item and ask its price.",
