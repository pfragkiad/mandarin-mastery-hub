  "sections": {
    "overview": {
      "topic_description": "Talk about travelling, moving between places and locating people and objects.",
      "focus": "Name common modes of transport."
    },
    "vocabulary": {
      "items": [
        {
          "id": "w-020",
          "hanzi": "车",
          "pinyin": "chē",
          "meaning_en": "vehicle",
          "primary_pos_id": "noun",
          "pos_ids": [
            "noun"
          ],
          "topic_ids": [
            "travel-transport"
          ],
          "examples": [
            {
              "id": "ex-020-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "这是我爸爸的车。",
              "pinyin": "zhè shì wǒ bàba de chē.",
              "english": "This is my dad's car.",
              "teaching_note": ""
            },
            {
              "id": "ex-020-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学校门口有很多车。",
              "pinyin": "xuéxiào ménkǒu yǒu hěn duō chē.",
              "english": "There are many cars at the school entrance.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 20
            }
          ]
        },
        {
          "id": "w-022",
          "hanzi": "出租车",
          "pinyin": "chūzūchē",
          "meaning_en": "taxi",
          "primary_pos_id": "noun",
          "pos_ids": [
            "noun"
          ],
          "topic_ids": [
            "travel-transport"
          ],
          "examples": [
            {
              "id": "ex-022-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我坐出租车去学校。",
              "pinyin": "wǒ zuò chūzūchē qù xuéxiào.",
              "english": "I take a taxi to school.",
              "teaching_note": "坐出租车 means travel by taxi, rather than literally sit in a taxi."
            },
            {
              "id": "ex-022-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "从学校到医院可以坐出租车。",
              "pinyin": "cóng xuéxiào dào yīyuàn kěyǐ zuò chūzūchē.",
              "english": "You can take a taxi from the school to the hospital.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 22
            }
          ]
        },
        {
          "id": "w-029",
          "hanzi": "到",
          "pinyin": "dào",
          "meaning_en": "arrive",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb"
          ],
          "topic_ids": [
            "travel-transport"
          ],
          "examples": [
            {
              "id": "ex-029-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "他九点到学校。",
              "pinyin": "tā jiǔ diǎn dào xuéxiào.",
              "english": "He arrives at school at nine.",
              "teaching_note": "九点 gives the arrival time; 到 indicates reaching the school."
            },
            {
              "id": "ex-029-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "从家到学校可以坐车。",
              "pinyin": "cóng jiā dào xuéxiào kěyǐ zuò chē.",
              "english": "You can go from home to school by car.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 29
            }
          ]
        },
        {
          "id": "w-054",
          "hanzi": "飞机",
          "pinyin": "fēijī",
          "meaning_en": "airplane",
          "primary_pos_id": "noun",
          "pos_ids": [
            "noun"
          ],
          "topic_ids": [
            "travel-transport"
          ],
          "examples": [
            {
              "id": "ex-054-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "他坐飞机去中国。",
              "pinyin": "tā zuò fēijī qù Zhōngguó.",
              "english": "He takes a plane to China.",
              "teaching_note": "坐飞机 means to travel by plane; 去中国 specifies the destination."
            },
            {
              "id": "ex-054-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "飞机下午三点到机场。",
              "pinyin": "fēijī xiàwǔ sān diǎn dào jīchǎng.",
              "english": "The plane arrives at the airport at three in the afternoon.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 54
            }
          ]
        },
        {
          "id": "w-081",
          "hanzi": "回",
          "pinyin": "huí",
          "meaning_en": "return",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb",
            "classifier"
          ],
          "topic_ids": [
            "travel-transport"
          ],
          "examples": [
            {
              "id": "ex-081-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我明天回家。",
              "pinyin": "wǒ míngtiān huí jiā.",
              "english": "I will go home tomorrow.",
              "teaching_note": "回家 means return home; 明天 indicates the future without a future-tense ending."
            },
            {
              "id": "ex-081-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "他下午六点回家。",
              "pinyin": "tā xiàwǔ liù diǎn huí jiā.",
              "english": "He goes home at six in the afternoon.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 81
            }
          ]
        },
        {
          "id": "w-083",
          "hanzi": "火车",
          "pinyin": "huǒchē",
          "meaning_en": "train",
          "primary_pos_id": "noun",
          "pos_ids": [
            "noun"
          ],
          "topic_ids": [
            "travel-transport"
          ],
          "examples": [
            {
              "id": "ex-083-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我坐火车去看朋友。",
              "pinyin": "wǒ zuò huǒchē qù kàn péngyou.",
              "english": "I take the train to visit a friend.",
              "teaching_note": ""
            },
            {
              "id": "ex-083-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "火车上午九点到。",
              "pinyin": "huǒchē shàngwǔ jiǔ diǎn dào.",
              "english": "The train arrives at nine in the morning.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 83
            }
          ]
        },
        {
          "id": "w-098",
          "hanzi": "开车",
          "pinyin": "kāichē",
          "meaning_en": "drive",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb"
          ],
          "topic_ids": [
            "travel-transport",
            "daily-actions"
          ],
          "examples": [
            {
              "id": "ex-098-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我爸爸会开车。",
              "pinyin": "wǒ bàba huì kāichē.",
              "english": "My father can drive.",
              "teaching_note": "会 marks the skill of driving rather than permission to drive."
            },
            {
              "id": "ex-098-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "今天爸爸开车去公司。",
              "pinyin": "jīntiān bàba kāichē qù gōngsī.",
              "english": "Dad drives to the company today.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 98
            }
          ]
        },
        {
          "id": "w-106",
          "hanzi": "来",
          "pinyin": "lái",
          "meaning_en": "come",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb"
          ],
          "topic_ids": [
            "travel-transport"
          ],
          "examples": [
            {
              "id": "ex-106-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "你明天来吗？",
              "pinyin": "nǐ míngtiān lái ma?",
              "english": "Are you coming tomorrow?",
              "teaching_note": "来 indicates movement toward the speaker’s place or point of reference."
            },
            {
              "id": "ex-106-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学生们明天上午来学校。",
              "pinyin": "xuéshēngmen míngtiān shàngwǔ lái xuéxiào.",
              "english": "The students will come to school tomorrow morning.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 106
            }
          ]
        },
        {
          "id": "w-167",
          "hanzi": "去",
          "pinyin": "qù",
          "meaning_en": "go",
          "primary_pos_id": "verb",
          "pos_ids": [
            "verb"
          ],
          "topic_ids": [
            "travel-transport"
          ],
          "examples": [
            {
              "id": "ex-167-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我们现在去学校。",
              "pinyin": "wǒmen xiànzài qù xuéxiào.",
              "english": "We are going to school now.",
              "teaching_note": "去 indicates movement away from the speaker’s present location."
            },
            {
              "id": "ex-167-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学生们明天去电影院。",
              "pinyin": "xuéshēngmen míngtiān qù diànyǐngyuàn.",
              "english": "The students will go to the cinema tomorrow.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 167
            }
          ]
        },
        {
          "id": "w-011",
          "hanzi": "边",
          "pinyin": "biān",
          "meaning_en": "side; edge",
          "primary_pos_id": "suffix",
          "pos_ids": [
            "suffix",
            "noun"
          ],
          "topic_ids": [
            "places-directions"
          ],
          "examples": [
            {
              "id": "ex-011-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "你来这边坐吧。",
              "pinyin": "nǐ lái zhèbiān zuò ba.",
              "english": "Come sit over here.",
              "teaching_note": ""
            },
            {
              "id": "ex-011-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学校在那边。",
              "pinyin": "xuéxiào zài nàbiān.",
              "english": "The school is over there.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 11
            }
          ],
          "pos_note": "Primarily a bound locative suffix in 这边、那边、前边; also a noun meaning side or edge in other constructions."
        },
        {
          "id": "w-066",
          "hanzi": "国",
          "pinyin": "guó",
          "meaning_en": "country",
          "primary_pos_id": "noun",
          "pos_ids": [
            "noun"
          ],
          "topic_ids": [
            "places-directions"
          ],
          "examples": [
            {
              "id": "ex-066-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "中国是一个大国。",
              "pinyin": "Zhōngguó shì yí ge dàguó.",
              "english": "China is a large country.",
              "teaching_note": "大国 means a large or major country; 个 is a general classifier."
