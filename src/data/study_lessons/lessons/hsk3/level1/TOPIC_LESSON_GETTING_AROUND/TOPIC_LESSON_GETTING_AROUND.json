          "pos_ids": [
            "localizer",
            "verb",
            "noun"
          ],
          "topic_ids": [
            "places-directions"
          ],
          "examples": [
            {
              "id": "ex-175-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "书在桌子上。",
