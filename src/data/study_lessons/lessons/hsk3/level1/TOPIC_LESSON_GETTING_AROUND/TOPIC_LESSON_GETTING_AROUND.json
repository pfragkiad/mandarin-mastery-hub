            {
              "id": "ex-066-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "我哥哥在外国工作。",
              "pinyin": "wǒ gēge zài wàiguó gōngzuò.",
              "english": "My older brother works abroad.",
              "teaching_note": "外国 (“foreign country/abroad”) is a common compound containing 国."
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 66
            }
          ]
        },
        {
          "id": "w-080",
          "hanzi": "后",
          "pinyin": "hòu",
          "meaning_en": "after; behind",
          "primary_pos_id": "localizer",
          "pos_ids": [
            "localizer",
            "noun"
          ],
          "topic_ids": [
            "places-directions",
            "time-calendar"
          ],
          "examples": [
            {
              "id": "ex-080-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "我坐在你后边。",
              "pinyin": "wǒ zuò zài nǐ hòubian.",
              "english": "I am sitting behind you.",
              "teaching_note": "后边 is a positional noun meaning behind; 在 + person + 后边 locates the speaker."
            },
            {
              "id": "ex-080-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "我们下课后去书店。",
              "pinyin": "wǒmen xiàkè hòu qù shūdiàn.",
              "english": "We go to the bookstore after class.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 80
            }
          ],
          "pos_note": "After/behind: temporal or spatial localizer; can also be nominal."
        },
        {
          "id": "w-110",
          "hanzi": "里",
          "pinyin": "lǐ",
          "meaning_en": "inside",
          "primary_pos_id": "localizer",
          "pos_ids": [
            "localizer",
            "noun"
          ],
          "topic_ids": [
            "places-directions"
          ],
          "examples": [
            {
              "id": "ex-110-1",
              "style": "conversational",
              "register": "neutral",
              "hanzi": "书在包里。",
              "pinyin": "shū zài bāo lǐ.",
              "english": "The book is in the bag.",
              "teaching_note": "里 is a location word, showing that the book is inside the bag."
            },
            {
              "id": "ex-110-2",
              "style": "written",
              "register": "neutral_written",
              "hanzi": "学生们在教室里上课。",
              "pinyin": "xuéshēngmen zài jiàoshì lǐ shàngkè.",
              "english": "The students are having class in the classroom.",
              "teaching_note": ""
            }
          ],
          "learning_role": "introduced",
          "syllabus_refs": [
            {
              "curriculum_id": "hsk3-2025",
              "entry_id": 110
            }
          ],
          "pos_note": "Localizer meaning inside, traditionally also categorized as a location noun."
        },
        {
          "id": "w-163",
