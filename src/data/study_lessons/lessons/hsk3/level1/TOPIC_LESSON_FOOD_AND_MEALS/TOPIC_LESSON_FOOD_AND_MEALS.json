    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Food and Drink",
        "context_en": "Two friends order lunch and discuss what they do and do not want to eat.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你想吃什么？",
            "pinyin": "Nǐ xiǎng chī shénme?",
            "english": "What would you like to eat?"
          },
          {
            "speaker": "B",
            "hanzi": "我想吃饺子，喝一杯茶。",
            "pinyin": "Wǒ xiǎng chī jiǎozi, hē yì bēi chá.",
            "english": "I would like dumplings and a cup of tea."
          },
          {
            "speaker": "A",
            "hanzi": "你还要米饭吗？",
            "pinyin": "Nǐ hái yào mǐfàn ma?",
            "english": "Would you like rice as well?"
          },
          {
            "speaker": "B",
            "hanzi": "不要了，谢谢！",
            "pinyin": "Bú yào le, xièxie!",
            "english": "No more, thank you!"
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Food and drink verbs",
          "explanation_en": "Use 吃 (chī) for eating and 喝 (hē) for drinking. 想 (xiǎng) makes a polite expression of what you would like.",
          "formula_en": "我想 + 吃/喝 + food/drink",
          "examples": [
            {
              "hanzi": "我晚上想吃面条儿。",
              "pinyin": "Wǒ wǎnshang xiǎng chī miàntiáor.",
              "english": "I would like noodles this evening."
            },
            {
              "hanzi": "她想喝牛奶。",
              "pinyin": "Tā xiǎng hē niúnǎi.",
              "english": "She would like milk."
            }
          ]
        },
        {
          "id": "pattern-2",
          "title": "Offering and declining",
          "explanation_en": "要 (yào) can indicate wanting an item. Adding 还 (hái) asks whether someone wants more; 不要了 (bú yào le) politely closes an offer.",
          "formula_en": "还要 + item + 吗?",
          "examples": [
            {
              "hanzi": "你还要水吗？",
              "pinyin": "Nǐ hái yào shuǐ ma?",
              "english": "Would you like more water?"
            },
            {
              "hanzi": "我不要了，谢谢。",
              "pinyin": "Wǒ bú yào le, xièxie.",
              "english": "I do not want any more, thank you."
            }
          ]
        }
      ],
      "guided_building": {
        "instruction_en": "Keep the request frame, but change what is being ordered.",
        "model": {
          "hanzi": "我想喝一杯茶。",
          "pinyin": "Wǒ xiǎng hē yì bēi chá.",
          "english": "I would like a cup of tea."
        },
        "substitutions": [
          {
            "cue_en": "water",
