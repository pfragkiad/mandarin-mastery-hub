    "teaching_plan": {
      "vocabulary_display": "reference_only",
      "dialogue": {
        "title": "Counting from One Upward",
        "context_en": "Use prices, ages and quantities to practise number structure without memorizing an isolated list.",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "这本书多少钱？",
            "pinyin": "Zhè běn shū duōshao qián?",
            "english": "How much is this book?"
          },
          {
            "speaker": "B",
            "hanzi": "一百二十元。",
            "pinyin": "Yì bǎi èr shí yuán.",
            "english": "One hundred and twenty yuan."
          },
          {
            "speaker": "A",
            "hanzi": "那本呢？",
            "pinyin": "Nà běn ne?",
            "english": "What about that one?"
          },
          {
            "speaker": "B",
            "hanzi": "九十八元。",
            "pinyin": "Jiǔ shí bā yuán.",
            "english": "Ninety-eight yuan."
          }
        ]
      },
      "patterns": [
        {
          "id": "pattern-1",
          "title": "Building larger numbers",
          "explanation_en": "Chinese number order follows thousands, hundreds, tens and ones. 零 (líng) marks a missing internal place where needed, as in 一百零五 (yì bǎi líng wǔ). The slots show place values up to the thousands. Use 零 (líng) where required for a gap. For 10–19, the initial one before 十 (shí) is normally omitted.",
          "examples": [
            {
              "hanzi": "二百三十六。",
              "pinyin": "Èr bǎi sān shí liù.",
              "english": "Two hundred and thirty-six."
            },
            {
              "hanzi": "一千零二。",
              "pinyin": "Yì qiān líng èr.",
              "english": "One thousand and two."
            }
          ],
          "pattern_hanzi": "(千位数字 + 千) + (百位数字 + 百) + (十位数字 + 十) + 个位数字",
          "pattern_pinyin": "(qiānwèi shùzì + qiān) + (bǎiwèi shùzì + bǎi) + (shíwèi shùzì + shí) + gèwèi shùzì",
          "pattern_pseudo_translation": "(<number of thousands> + 千) + (<number of hundreds> + 百) + (<number of tens> + 十) + <number of ones>"
        },
        {
          "id": "pattern-2",
          "title": "Numbers with nouns",
          "explanation_en": "Use a suitable classifier when counting most nouns. Do not put an English-style plural ending on the noun.",
          "examples": [
            {
              "hanzi": "三本书。",
              "pinyin": "Sān běn shū.",
              "english": "Three books."
            },
            {
              "hanzi": "十个人。",
              "pinyin": "Shí ge rén.",
              "english": "Ten people."
            }
          ],
          "pattern_hanzi": "数字 + 量词 + 名词",
          "pattern_pinyin": "shùzì + liàngcí + míngcí",
          "pattern_pseudo_translation": "<number> + <classifier> + <noun>"
        }
      ],
