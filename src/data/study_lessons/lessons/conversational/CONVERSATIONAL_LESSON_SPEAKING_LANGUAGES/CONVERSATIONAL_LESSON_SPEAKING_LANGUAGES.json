  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to ask which languages someone speaks and describe what you can and cannot say. Use the model conversation to notice the expressions, then practice the patterns and speak aloud.\n\nPronunciation note: This course uses some northern-style 儿化 (érhuà) forms. The final -r belongs to the preceding syllable, not a separate syllable. For “a little,” 一点儿 (yìdiǎnr) is common in northern-influenced Mandarin; 一点 (yìdiǎn) is a non-erhua alternative."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "请问，你会说英文吗？",
            "pinyin": "Qǐngwèn, nǐ huì shuō Yīngwén ma?",
            "english": "Excuse me, can you speak English?"
          },
          {
            "speaker": "B",
            "hanzi": "不会，我不会说英文。",
            "pinyin": "Bú huì, wǒ bú huì shuō Yīngwén.",
            "english": "No, I cannot speak English."
          },
          {
            "speaker": "B",
            "hanzi": "我会说一点普通话。",
            "pinyin": "Wǒ huì shuō yìdiǎn Pǔtōnghuà.",
            "english": "I can speak a little Mandarin."
          },
          {
            "speaker": "A",
            "hanzi": "你普通话说得很好。",
            "pinyin": "Nǐ Pǔtōnghuà shuō de hěn hǎo.",
            "english": "You speak Mandarin very well."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "主语 + 会 + 说 + 语言",
        "pattern_pinyin": "zhǔyǔ + huì + shuō + yǔyán",
        "function_en": "会 (huì) expresses acquired ability; add a language after 说 (shuō).",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "我会说普通话。",
          "pinyin": "wǒ huì shuō Pǔtōnghuà.",
          "english": "I can speak Mandarin.",
          "teaching_note": "Use this to describe a language you can speak, even if your ability is limited."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "主语 + 说 + 得 + 程度",
        "pattern_pinyin": "zhǔyǔ + shuō + de + chéngdù",
        "function_en": "得 (de) introduces how well the action is performed.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "你说得很好。",
          "pinyin": "nǐ shuō de hěn hǎo.",
          "english": "You speak very well.",
          "teaching_note": "This form can compliment someone on how well they speak a language."
        }
      },
