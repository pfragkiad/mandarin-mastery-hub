  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to ask whether somebody speaks a language. Use the model conversation to notice the expressions, then practise the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "请问，你会说英文吗？",
            "pinyin": "Qǐngwèn, nǐ huì shuō Yīngwén ma?",
            "english": "Excuse me, can you speak English?"
          },
          {
            "speaker": "B",
            "hanzi": "不会，我不会说英文。",
            "pinyin": "Bú huì, wǒ bú huì shuō Yīngwén.",
            "english": "No, I cannot speak English."
          },
          {
            "speaker": "B",
            "hanzi": "我会说一点普通话。",
            "pinyin": "Wǒ huì shuō yìdiǎn Pǔtōnghuà.",
            "english": "I can speak a little Mandarin."
          },
          {
            "speaker": "A",
            "hanzi": "你普通话说得很好。",
            "pinyin": "Nǐ Pǔtōnghuà shuō de hěn hǎo.",
            "english": "You speak Mandarin very well."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "会 + 说 + 语言",
        "pattern_pinyin": "huì shuō",
        "function_en": "会 (huì) expresses acquired ability; add a language after 说 (shuō).",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "我会说普通话。",
          "pinyin": "wǒ huì shuō Pǔtōnghuà.",
          "english": "I can speak Mandarin.",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "动词 + 得 + 评价",
        "pattern_pinyin": "dòngcí de",
        "function_en": "得 (de) introduces how well the action is performed.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "你说得很好。",
          "pinyin": "nǐ shuō de hěn hǎo.",
          "english": "You speak very well.",
          "teaching_note": "Use this construction in your own dialogue."
