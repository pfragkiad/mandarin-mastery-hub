      {
        "id": "source-coverage-dialogue",
        "kind": "dialogue",
        "title": "Speaking a Little and Encouraging Someone",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你会说普通话吗？",
            "pinyin": "Nǐ huì shuō Pǔtōnghuà ma?",
            "english": "Can you speak Mandarin?"
          },
          {
            "speaker": "B",
            "hanzi": "我会说一点儿，可是说得不好。",
            "pinyin": "Wǒ huì shuō yìdiǎnr, kěshì shuō de bù hǎo.",
            "english": "A little, but I do not speak it well."
          },
          {
            "speaker": "A",
            "hanzi": "我觉得你说得很好。",
            "pinyin": "Wǒ juéde nǐ shuō de hěn hǎo.",
            "english": "I think you speak it very well."
          },
          {
            "speaker": "B",
            "hanzi": "谢谢！我还想多练习。",
            "pinyin": "Xièxie! Wǒ hái xiǎng duō liànxí.",
            "english": "Thanks! I still want to practice more."
          }
        ]
      },
      {
        "id": "source-coverage-grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "主语 + 说得 + 不太好",
        "pattern_pinyin": "zhǔyǔ + shuō de + bú tài hǎo",
        "function_en": "The result complement 得 (de) describes how well an action is performed; do not confuse it with 的 (de).",
        "example": {
          "id": "source-coverage-grammar-1--example",
          "hanzi": "我说得不太好。",
          "pinyin": "Wǒ shuō de bú tài hǎo.",
          "english": "I do not speak very well.",
          "teaching_note": "A modest reply acknowledges limited ability without claiming you cannot speak at all."
        }
      },
      {
        "id": "source-coverage-grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "可是 + 对比的句子",
        "pattern_pinyin": "kěshì + duìbǐ de jùzi",
        "function_en": "可是 (kěshì) introduces a contrast; 一点儿 (yìdiǎnr) has optional northern rhotic pronunciation.",
        "example": {
          "id": "source-coverage-grammar-2--example",
          "hanzi": "可是我听得懂一点儿。",
          "pinyin": "Kěshì wǒ tīng de dǒng yìdiǎnr.",
          "english": "But I understand a little.",
          "teaching_note": "The speaker contrasts one limitation with something they can still do."
        }
      }
    ],
