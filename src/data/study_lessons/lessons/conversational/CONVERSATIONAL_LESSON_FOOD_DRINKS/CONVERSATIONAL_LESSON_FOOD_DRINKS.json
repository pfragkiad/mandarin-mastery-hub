        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Topic lesson based on Conversational Mandarin, tracks 1–16. Dialogue is an editorial teaching exchange using source-attested expressions; it is not presented as a verbatim audio transcript."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你想喝茶还是啤酒？",
            "pinyin": "Nǐ xiǎng hē chá háishi píjiǔ?",
            "english": "Would you like tea or beer?"
          },
          {
            "speaker": "B",
            "hanzi": "我想喝一点茶。",
            "pinyin": "Wǒ xiǎng hē yìdiǎn chá.",
            "english": "I would like some tea."
          },
          {
            "speaker": "A",
            "hanzi": "你想吃午饭吗？",
            "pinyin": "Nǐ xiǎng chī wǔfàn ma?",
            "english": "Do you want to have lunch?"
          },
          {
            "speaker": "B",
            "hanzi": "好，我们去饭店吧。",
            "pinyin": "Hǎo, wǒmen qù fàndiàn ba.",
            "english": "Yes, let us go to a restaurant."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "A 还是 B",
        "pattern_pinyin": "A háishi B",
        "function_en": "Use 还是 (háishi) to present alternatives in a question.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "你想喝茶还是啤酒？",
          "pinyin": "nǐ xiǎng hē chá háishi píjiǔ?",
          "english": "Would you like tea or beer?",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "数量 + 杯 + 饮料",
        "pattern_pinyin": "shùliàng bēi yǐnliào",
        "function_en": "杯 (bēi) counts cups or glasses of drinks.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "我要两杯茶。",
          "pinyin": "wǒ yào liǎng bēi chá.",
