  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to say when you do not understand and ask someone to clarify their meaning. Use the model conversation to notice the expressions, then practice the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你明白吗？",
            "pinyin": "Nǐ míngbai ma?",
            "english": "Do you understand?"
          },
          {
            "speaker": "B",
            "hanzi": "我不明白。",
            "pinyin": "Wǒ bù míngbai.",
            "english": "I do not understand."
          },
          {
            "speaker": "B",
            "hanzi": "你说什么？",
            "pinyin": "Nǐ shuō shénme?",
            "english": "What did you say?"
          },
          {
            "speaker": "A",
            "hanzi": "我说普通话。",
            "pinyin": "Wǒ shuō Pǔtōnghuà.",
            "english": "I am speaking Mandarin."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "主语 + 不 + 心理动词",
        "pattern_pinyin": "zhǔyǔ + bù + xīnlǐ dòngcí",
        "function_en": "Negate a mental state using 不 (bù); the next syllable is not fourth tone here.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "我不明白。",
          "pinyin": "wǒ bù míngbai.",
          "english": "I do not understand.",
          "teaching_note": "This is a natural way to signal difficulty following what someone says."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "主语 + 说 + 什么？",
        "pattern_pinyin": "zhǔyǔ + shuō + shénme?",
        "function_en": "什么 (shénme) occupies the position of the unknown thing in the sentence.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "你说什么？",
          "pinyin": "nǐ shuō shénme?",
          "english": "What did you say?",
          "teaching_note": "In a conversation, this asks the other person to clarify their words."
        }
      },
      {
