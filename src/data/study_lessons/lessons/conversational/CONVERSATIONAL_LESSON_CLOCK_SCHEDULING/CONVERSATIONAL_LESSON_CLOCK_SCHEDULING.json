  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Topic lesson based on Conversational Mandarin, tracks 1–16. Dialogue is an editorial teaching exchange using source-attested expressions; it is not presented as a verbatim audio transcript."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你想几点钟吃晚饭？",
            "pinyin": "Nǐ xiǎng jǐ diǎn zhōng chī wǎnfàn?",
            "english": "What time do you want to have dinner?"
          },
          {
            "speaker": "B",
            "hanzi": "六点钟，好吗？",
            "pinyin": "Liù diǎn zhōng, hǎo ma?",
            "english": "Is six o’clock okay?"
          },
          {
            "speaker": "A",
            "hanzi": "六点钟不行。",
            "pinyin": "Liù diǎn zhōng bù xíng.",
            "english": "Six o’clock does not work."
          },
          {
            "speaker": "B",
            "hanzi": "那么七点钟吧。",
            "pinyin": "Nàme qī diǎn zhōng ba.",
            "english": "Then let’s say seven o’clock."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "几点钟",
        "pattern_pinyin": "jǐ diǎn zhōng",
        "function_en": "几点钟 (jǐ diǎn zhōng) asks for a clock time, not a duration.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "现在几点钟？",
          "pinyin": "xiànzài jǐ diǎn zhōng?",
          "english": "What time is it now?",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "时间 + 好吗 / 不行",
        "pattern_pinyin": "shíjiān hǎo ma / bù xíng",
        "function_en": "Suggest a time with 好吗 (hǎo ma); reject an unsuitable time with 不行 (bù xíng).",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "八点钟不行。",
          "pinyin": "bā diǎn zhōng bù xíng.",
          "english": "Eight o’clock does not work.",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
      {
