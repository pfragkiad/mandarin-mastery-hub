            "meaning_en": "two o’clock"
          },
          {
            "hanzi": "三点钟",
            "pinyin": "sān diǎn zhōng",
            "meaning_en": "three o’clock"
          },
          {
            "hanzi": "四点",
            "pinyin": "sì diǎn",
            "meaning_en": "four o’clock"
          },
          {
            "hanzi": "五点钟",
            "pinyin": "wǔ diǎn zhōng",
            "meaning_en": "five o’clock"
          },
          {
            "hanzi": "六点钟",
            "pinyin": "liù diǎn zhōng",
            "meaning_en": "six o’clock"
          },
          {
