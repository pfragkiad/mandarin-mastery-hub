            "pinyin": "bù xíng",
            "meaning_en": "that will not work; cannot"
          },
          {
            "hanzi": "是十点钟吗",
            "pinyin": "shì shí diǎn zhōng ma",
            "meaning_en": "is it ten o’clock?"
          }
        ]
      },
      {
        "id": "guided-speaking",
        "kind": "explanation",
        "text": "Speaking task: Negotiate a dinner time by proposing six, seven or eight o’clock."
      },
      {
        "id": "source-coverage-dialogue",
        "kind": "dialogue",
        "title": "Negotiating Another Time",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "我们九点钟见面，可以吗？",
            "pinyin": "Wǒmen jiǔ diǎn zhōng jiànmiàn, kěyǐ ma?",
            "english": "Can we meet at nine?"
          },
          {
            "speaker": "B",
            "hanzi": "九点不行。十点钟怎么样？",
            "pinyin": "Jiǔ diǎn bù xíng. Shí diǎn zhōng zěnmeyàng?",
            "english": "Nine will not work. How about ten?"
          },
          {
            "speaker": "A",
            "hanzi": "十点太晚了。八点钟呢？",
            "pinyin": "Shí diǎn tài wǎn le. Bā diǎn zhōng ne?",
            "english": "Ten is too late. What about eight?"
          },
          {
            "speaker": "B",
            "hanzi": "八点也不行。我们明天六点见吧。",
            "pinyin": "Bā diǎn yě bù xíng. Wǒmen míngtiān liù diǎn jiàn ba.",
            "english": "Eight does not work either. Let us meet at six tomorrow."
          },
          {
            "speaker": "A",
            "hanzi": "好，明天六点钟见。",
            "pinyin": "Hǎo, míngtiān liù diǎn zhōng jiàn.",
            "english": "All right, see you at six tomorrow."
          }
        ]
      },
      {
        "id": "source-coverage-grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "时间 + 不行；另一个时间 + 可以",
        "pattern_pinyin": "shíjiān + bù xíng; lìng yí ge shíjiān + kěyǐ",
        "function_en": "不行 (bù xíng) rejects a proposal; 可以 (kěyǐ) accepts an alternative.",
        "example": {
          "id": "source-coverage-grammar-1--example",
          "hanzi": "八点不行，九点可以。",
          "pinyin": "Bā diǎn bù xíng, jiǔ diǎn kěyǐ.",
          "english": "Eight does not work; nine works.",
          "teaching_note": "This keeps negotiations moving by supplying an acceptable alternative."
        },
        "pattern_pseudo_translation": "<proposed time> + 不行；<another time> + 可以"
      },
      {
        "id": "source-coverage-grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "太 + 形容词 + 了",
        "pattern_pinyin": "tài + xíngróngcí + le",
        "function_en": "太 (tài) + adjective + 了 (le) expresses an excessive degree or a strong judgment.",
        "example": {
          "id": "source-coverage-grammar-2--example",
          "hanzi": "十点太晚了。",
          "pinyin": "Shí diǎn tài wǎn le.",
          "english": "Ten o’clock is too late.",
          "teaching_note": "In scheduling, it explains why a proposed time is unsuitable."
        },
        "pattern_pseudo_translation": "太 + <describing word> + 了"
      }
    ],
