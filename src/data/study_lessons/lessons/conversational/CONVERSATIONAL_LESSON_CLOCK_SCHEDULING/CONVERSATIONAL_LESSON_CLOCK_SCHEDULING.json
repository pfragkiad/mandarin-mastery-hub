          },
          {
            "hanzi": "六点钟好吗",
            "pinyin": "liù diǎn zhōng hǎo ma",
            "meaning_en": "Does six o'clock work?"
          },
          {
            "hanzi": "六点钟不行",
            "pinyin": "liù diǎn zhōng bù xíng",
            "meaning_en": "Six o'clock doesn't work."
          },
          {
            "hanzi": "三点钟不行",
            "pinyin": "sān diǎn zhōng bù xíng",
            "meaning_en": "Three o'clock doesn't work."
          },
          {
            "hanzi": "九点钟不行",
            "pinyin": "jiǔ diǎn zhōng bù xíng",
