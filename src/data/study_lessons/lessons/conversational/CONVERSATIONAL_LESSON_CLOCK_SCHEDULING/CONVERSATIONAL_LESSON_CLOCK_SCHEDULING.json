          },
          {
            "hanzi": "五点钟不行",
            "pinyin": "wǔ diǎn zhōng bù xíng",
            "meaning_en": "Five o'clock doesn't work."
          },
          {
            "hanzi": "十点钟",
            "pinyin": "shí diǎn zhōng",
            "meaning_en": "ten o’clock"
          },
          {
            "hanzi": "八点钟",
            "pinyin": "bā diǎn zhōng",
