  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to propose a time for dinner, reject a conflicting time, and agree on another. Use the model conversation to notice the expressions, then practice the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你想几点钟吃晚饭？",
            "pinyin": "Nǐ xiǎng jǐ diǎn zhōng chī wǎnfàn?",
            "english": "What time do you want to have dinner?"
          },
          {
            "speaker": "B",
            "hanzi": "六点钟，好吗？",
            "pinyin": "Liù diǎn zhōng, hǎo ma?",
            "english": "Is six o’clock okay?"
          },
          {
            "speaker": "A",
            "hanzi": "六点钟不行。",
            "pinyin": "Liù diǎn zhōng bù xíng.",
            "english": "Six o’clock does not work."
          },
          {
            "speaker": "B",
            "hanzi": "那么七点钟吧。",
            "pinyin": "Nàme qī diǎn zhōng ba.",
            "english": "Then let’s say seven o’clock."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "现在 + 几点钟？",
        "pattern_pinyin": "xiànzài + jǐ diǎn zhōng?",
        "function_en": "几点钟 (jǐ diǎn zhōng) asks for a clock time, not a duration.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "现在几点钟？",
          "pinyin": "xiànzài jǐ diǎn zhōng?",
          "english": "What time is it now?",
          "teaching_note": "Ask for the current clock time before arranging a meeting."
        },
        "pattern_pseudo_translation": "现在 + 几点钟？"
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "时间 + 不行",
        "pattern_pinyin": "shíjiān + bù xíng",
        "function_en": "Reject a proposed time with 不行 (bù xíng), then suggest an alternative.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "八点钟不行。",
          "pinyin": "bā diǎn zhōng bù xíng.",
          "english": "Eight o’clock does not work.",
          "teaching_note": "Give an alternative time after declining the first suggestion."
        },
        "pattern_pseudo_translation": "<proposed time> + 不行"
      },
      {
        "id": "key-expressions",
        "kind": "review_set",
        "items": [
          {
            "hanzi": "现在几点钟",
            "pinyin": "xiànzài jǐ diǎn zhōng",
            "meaning_en": "What time is it now?"
          },
          {
            "hanzi": "是九点钟吗",
            "pinyin": "shì jiǔ diǎn zhōng ma",
            "meaning_en": "Is it nine o’clock?"
          },
          {
            "hanzi": "八点钟还是九点钟",
            "pinyin": "bā diǎn zhōng háishi jiǔ diǎn zhōng",
            "meaning_en": "Eight or nine o’clock?"
          },
          {
            "hanzi": "一点钟好吗",
            "pinyin": "yì diǎn zhōng hǎo ma",
            "meaning_en": "Is one o’clock okay?"
          },
          {
            "hanzi": "两点钟好吗",
            "pinyin": "liǎng diǎn zhōng hǎo ma",
            "meaning_en": "Is two o’clock okay?"
