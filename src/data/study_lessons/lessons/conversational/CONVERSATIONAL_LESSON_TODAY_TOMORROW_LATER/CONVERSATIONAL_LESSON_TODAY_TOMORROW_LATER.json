  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Topic lesson based on Conversational Mandarin, tracks 1–16. Dialogue is an editorial teaching exchange using source-attested expressions; it is not presented as a verbatim audio transcript."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你想现在吃吗？",
            "pinyin": "Nǐ xiǎng xiànzài chī ma?",
            "english": "Do you want to eat now?"
          },
          {
            "speaker": "B",
            "hanzi": "现在不行。",
            "pinyin": "Xiànzài bù xíng.",
            "english": "Now does not work."
          },
          {
            "speaker": "A",
            "hanzi": "那么明天晚上，好吗？",
            "pinyin": "Nàme míngtiān wǎnshang, hǎo ma?",
            "english": "Then tomorrow evening, okay?"
          },
          {
            "speaker": "B",
            "hanzi": "好，明天见！",
            "pinyin": "Hǎo, míngtiān jiàn!",
            "english": "Okay, see you tomorrow!"
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "今天 / 明天",
        "pattern_pinyin": "jīntiān / míngtiān",
        "function_en": "Time words often precede the main verb or follow the topic.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "明天我想去。",
          "pinyin": "míngtiān wǒ xiǎng qù.",
          "english": "I want to go tomorrow.",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "过一会儿",
        "pattern_pinyin": "guò yíhuìr",
        "function_en": "This phrase means after a short while; 一 (yī) is pronounced yí before fourth-tone 会 (huì).",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "过一会儿见。",
          "pinyin": "guò yíhuìr jiàn.",
          "english": "See you in a little while.",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
      {
