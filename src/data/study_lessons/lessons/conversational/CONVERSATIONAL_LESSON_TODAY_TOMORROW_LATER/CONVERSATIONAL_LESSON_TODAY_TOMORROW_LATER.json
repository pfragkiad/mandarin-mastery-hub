  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to postpone an activity until later today or suggest meeting tomorrow instead. Use the model conversation to notice the expressions, then practice the patterns and speak aloud.\n\nPronunciation note: This course uses some northern-style 儿化 (érhuà) forms. The final -r belongs to the preceding syllable, not a separate syllable. In 一会儿 (yíhuìr), the -r is attached to 会 (huì); do not read 儿 (ér) as an extra syllable."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你想现在吃吗？",
            "pinyin": "Nǐ xiǎng xiànzài chī ma?",
            "english": "Do you want to eat now?"
          },
          {
            "speaker": "B",
            "hanzi": "现在不行。",
            "pinyin": "Xiànzài bù xíng.",
            "english": "Now does not work."
          },
          {
            "speaker": "A",
            "hanzi": "那么明天晚上，好吗？",
            "pinyin": "Nàme míngtiān wǎnshang, hǎo ma?",
            "english": "Then tomorrow evening, okay?"
          },
          {
            "speaker": "B",
            "hanzi": "好，明天见！",
            "pinyin": "Hǎo, míngtiān jiàn!",
            "english": "Okay, see you tomorrow!"
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "时间词 + 主语 + 动词",
        "pattern_pinyin": "shíjiāncí + zhǔyǔ + dòngcí",
        "function_en": "Time words often precede the main verb or follow the topic.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "明天我想去。",
          "pinyin": "míngtiān wǒ xiǎng qù.",
          "english": "I want to go tomorrow.",
          "teaching_note": "Mentioning tomorrow first highlights when the planned action will happen."
        },
        "pattern_pseudo_translation": "<time word or phrase> + <who or what> + <action word>"
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "过 + 一会儿 + 动词",
        "pattern_pinyin": "guò + yíhuìr + dòngcí",
        "function_en": "This phrase means after a short while; 一 (yī) is pronounced yí before fourth-tone 会 (huì).",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "过一会儿见。",
          "pinyin": "guò yíhuìr jiàn.",
          "english": "See you in a little while.",
          "teaching_note": "Use this when proposing to meet shortly rather than immediately."
        },
        "pattern_pseudo_translation": "过 + 一会儿 + <action word>"
      },
      {
        "id": "key-expressions",
        "kind": "review_set",
        "items": [
          {
            "hanzi": "现在",
            "pinyin": "xiànzài",
            "meaning_en": "Now."
          },
          {
            "hanzi": "什么时候",
            "pinyin": "shénme shíhou",
            "meaning_en": "When?"
          },
          {
            "hanzi": "过一会儿",
            "pinyin": "guò yíhuìr",
            "meaning_en": "In a little while; later."
          },
          {
            "hanzi": "今天",
            "pinyin": "jīntiān",
            "meaning_en": "Today."
          },
          {
            "hanzi": "今天晚上",
            "pinyin": "jīntiān wǎnshang",
            "meaning_en": "Tonight."
          },
          {
            "hanzi": "明天",
            "pinyin": "míngtiān",
            "meaning_en": "Tomorrow."
          },
          {
            "hanzi": "明天晚上",
            "pinyin": "míngtiān wǎnshang",
            "meaning_en": "Tomorrow evening."
          },
          {
            "hanzi": "现在还是过一会儿",
            "pinyin": "xiànzài háishi guò yíhuìr",
            "meaning_en": "Now or a little later?"
          },
          {
            "hanzi": "明天好吗",
            "pinyin": "míngtiān hǎo ma",
            "meaning_en": "Would tomorrow be okay?"
          },
          {
            "hanzi": "明天见",
            "pinyin": "míngtiān jiàn",
            "meaning_en": "See you tomorrow."
          },
          {
            "hanzi": "明天呢",
            "pinyin": "míngtiān ne",
            "meaning_en": "What about tomorrow?"
          },
          {
            "hanzi": "现在吗",
            "pinyin": "xiànzài ma",
            "meaning_en": "Now?"
          },
          {
            "hanzi": "过一会儿好吗",
            "pinyin": "guò yíhuìr hǎo ma",
            "meaning_en": "Would a little later be okay?"
          },
          {
            "hanzi": "过一会儿不好",
            "pinyin": "guò yíhuìr bù hǎo",
            "meaning_en": "Later is not a good time.",
            "expression_id": "CMX-143FCD826472",
            "usage_label": "Context",
            "usage_note": "In the source scheduling exchange, this means that a slightly later time is not good. A more explicit way to say that the time is inconvenient is 过一会儿不方便 (guò yíhuìr bù fāngbiàn). The 儿化 (érhuà) ending in 一会儿 (yíhuìr) reflects northern-leaning spoken usage."
          },
          {
            "hanzi": "我想现在喝",
            "pinyin": "wǒ xiǎng xiànzài hē",
            "meaning_en": "I want to drink now."
          },
          {
            "hanzi": "今天晚上我不想吃东西",
            "pinyin": "jīntiān wǎnshang wǒ bù xiǎng chī dōngxi",
            "meaning_en": "I do not want to eat anything tonight."
          },
          {
            "hanzi": "明天晚上不行",
            "pinyin": "míngtiān wǎnshang bù xíng",
            "meaning_en": "Tomorrow evening doesn't work."
          },
          {
            "hanzi": "太晚",
            "pinyin": "tài wǎn",
            "meaning_en": "too late"
          },
          {
            "hanzi": "现在太晚了",
            "pinyin": "xiànzài tài wǎn le",
            "meaning_en": "it is too late now"
          },
          {
            "hanzi": "十点钟",
            "pinyin": "shí diǎn zhōng",
            "meaning_en": "ten o’clock"
          }
        ]
      },
      {
        "id": "guided-speaking",
        "kind": "explanation",
        "text": "Speaking task: Postpone plans from tonight to tomorrow, or from now to later."
      },
      {
        "id": "source-coverage-dialogue",
        "kind": "dialogue",
        "title": "Dinner Tonight or Tomorrow",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "今天晚上一起吃晚饭，好吗？",
            "pinyin": "Jīntiān wǎnshang yìqǐ chī wǎnfàn, hǎo ma?",
            "english": "Shall we have dinner together tonight?"
          },
          {
            "speaker": "B",
            "hanzi": "对不起，我今天晚上没时间。",
            "pinyin": "Duìbuqǐ, wǒ jīntiān wǎnshang méi shíjiān.",
            "english": "Sorry, I do not have time tonight."
          },
          {
            "speaker": "A",
            "hanzi": "那么明天晚上七点呢？",
            "pinyin": "Nàme míngtiān wǎnshang qī diǎn ne?",
            "english": "Then how about seven tomorrow evening?"
          },
          {
            "speaker": "B",
            "hanzi": "七点很好，十点就太晚了。",
            "pinyin": "Qī diǎn hěn hǎo, shí diǎn jiù tài wǎn le.",
            "english": "Seven is great; ten would be too late."
          }
        ]
      }
    ],
