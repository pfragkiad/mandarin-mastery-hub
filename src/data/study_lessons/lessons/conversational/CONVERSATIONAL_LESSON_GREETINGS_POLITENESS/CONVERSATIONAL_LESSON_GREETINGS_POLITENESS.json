        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Practice start a polite conversation. Transcript-referenced conversational Mandarin study organized by communicative goal rather than audio track. Use the model conversation to notice the expressions, then practise the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你好！",
            "pinyin": "Nǐ hǎo!",
            "english": "Hello!"
          },
          {
            "speaker": "B",
            "hanzi": "你好！",
            "pinyin": "Nǐ hǎo!",
            "english": "Hello!"
          },
          {
            "speaker": "A",
            "hanzi": "你好吗？",
            "pinyin": "Nǐ hǎo ma?",
            "english": "How are you?"
          },
          {
            "speaker": "B",
            "hanzi": "很好，谢谢！",
            "pinyin": "Hěn hǎo, xièxie!",
            "english": "Very well, thank you!"
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "你好吗？",
        "pattern_pinyin": "nǐ hǎo ma",
        "function_en": "The neutral-tone question particle 吗 (ma) can form a yes–no question.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "你好吗？",
          "pinyin": "nǐ hǎo ma?",
          "english": "How are you?",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "请问……",
        "pattern_pinyin": "qǐngwèn",
        "function_en": "A polite way to introduce a request for information.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "请问，你会说英文吗？",
          "pinyin": "qǐngwèn, nǐ huì shuō Yīngwén ma?",
          "english": "Excuse me, do you speak English?",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
