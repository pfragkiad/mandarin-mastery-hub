    "practice": {
      "enabled": true,
      "questions": [
        {
          "id": "q-dialogue",
          "kind": "comprehension",
          "prompt": "Why does speaker B refuse the first invitation?",
          "choices": [],
          "correct_choice_ids": [],
          "answer": "今天不行，我有事。 (Jīntiān bù xíng, wǒ yǒu shì.) — Today does not work because B has something to do.",
          "explanation": "The response gives a reason and proposes an alternative."
        },
        {
          "id": "q-translation",
          "kind": "production",
          "prompt": "Say politely on the telephone: “Is Miss Chen there?”",
          "choices": [],
          "correct_choice_ids": [],
          "answer": "请问陈小姐在吗？ (Qǐngwèn Chén xiǎojiě zài ma?) — May I speak to Miss Chen?",
          "explanation": "Use 请问 (qǐngwèn) before asking for someone."
        },
        {
          "id": "q-grammar",
          "kind": "production",
          "prompt": "Reject ten o’clock as too late, then suggest seven.",
          "choices": [],
          "correct_choice_ids": [],
          "answer": "十点太晚了，七点可以吗？ (Shí diǎn tài wǎn le, qī diǎn kěyǐ ma?) — Ten is too late; would seven work?",
          "explanation": "Give both the objection and an alternative."
        },
        {
          "id": "q-speaking",
          "kind": "production",
          "prompt": "Call a friend, identify yourself, invite them to dinner, negotiate a time, and end the call.",
          "choices": [],
          "correct_choice_ids": [],
          "answer": "A: 喂，你好！我是小林。今天晚上一起吃晚饭，好吗？ (Wèi, nǐ hǎo! Wǒ shì Xiǎo Lín. Jīntiān wǎnshang yìqǐ chī wǎnfàn, hǎo ma?) — Hello! This is Xiao Lin. Shall we have dinner tonight?\nB: 今天不行，明天晚上怎么样？ (Jīntiān bù xíng, míngtiān wǎnshang zěnmeyàng?) — Today does not work. How about tomorrow evening?\nA: 明天七点可以吗？ (Míngtiān qī diǎn kěyǐ ma?) — Would seven tomorrow work?\nB: 可以，明天见！ (Kěyǐ, míngtiān jiàn!) — Yes, see you tomorrow!\nA: 好，再见！ (Hǎo, zàijiàn!) — Okay, goodbye!",
          "explanation": "The answer includes every step: calling, identifying, inviting, negotiating and closing."
        }
      ]
    }
