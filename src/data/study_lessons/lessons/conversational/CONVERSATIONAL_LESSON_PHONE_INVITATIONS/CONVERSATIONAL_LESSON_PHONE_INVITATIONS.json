  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to identify yourself on a call, invite someone to dinner, and negotiate a convenient time. practice the new dialogue and the examples, then complete the role-play."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "喂，您好！请问陈小姐在吗？",
            "pinyin": "Wèi, nín hǎo! Qǐngwèn Chén xiǎojiě zài ma?",
            "english": "Hello! Excuse me, is Miss Chen there?"
          },
          {
            "speaker": "B",
            "hanzi": "我就是。请问您是哪位？",
            "pinyin": "Wǒ jiù shì. Qǐngwèn nín shì nǎ wèi?",
            "english": "Speaking. May I ask who is calling?"
          },
          {
            "speaker": "A",
            "hanzi": "我是李明。今天晚上可以一起吃饭吗？",
            "pinyin": "Wǒ shì Lǐ Míng. Jīntiān wǎnshang kěyǐ yìqǐ chīfàn ma?",
            "english": "This is Li Ming. Could we have dinner together tonight?"
          },
          {
            "speaker": "B",
            "hanzi": "今天不行，我有事。明天怎么样？",
            "pinyin": "Jīntiān bù xíng, wǒ yǒu shì. Míngtiān zěnmeyàng?",
            "english": "Today does not work; I am busy. How about tomorrow?"
          },
          {
            "speaker": "A",
            "hanzi": "明天晚上十点钟可以吗？",
            "pinyin": "Míngtiān wǎnshang shí diǎn zhōng kěyǐ ma?",
            "english": "Would ten tomorrow night work?"
          },
          {
            "speaker": "B",
            "hanzi": "十点太晚了。七点可以。",
            "pinyin": "Shí diǎn tài wǎn le. Qī diǎn kěyǐ.",
            "english": "Ten is too late. Seven works."
          },
          {
            "speaker": "A",
            "hanzi": "好的，那么明天七点见。",
            "pinyin": "Hǎo de, nàme míngtiān qī diǎn jiàn.",
            "english": "All right. See you at seven tomorrow."
          },
          {
            "speaker": "B",
            "hanzi": "好，再见！",
            "pinyin": "Hǎo, zàijiàn!",
            "english": "Okay, goodbye!"
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "请问 + 称呼 + 在吗？",
        "pattern_pinyin": "qǐngwèn + chēnghu + zài ma?",
        "function_en": "Use 请问 (qǐngwèn) plus a name and 在吗 (zài ma) when asking if someone is available on the telephone.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "请问李先生在吗？",
          "pinyin": "Qǐngwèn Lǐ xiānsheng zài ma?",
          "english": "May I speak to Mr Li?",
          "teaching_note": "This sounds courteous when another person answers the telephone."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "时间 + 不行；另一个时间 + 呢？",
        "pattern_pinyin": "shíjiān + bù xíng; lìng yí ge shíjiān + ne?",
        "function_en": "The particle 呢 (ne) offers an elliptical alternative when the topic is already understood.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "今晚不行，明天呢？",
          "pinyin": "Jīnwǎn bù xíng, míngtiān ne?",
          "english": "Tonight does not work; how about tomorrow?",
          "teaching_note": "The follow-up invites the other speaker to consider another time."
        }
      },
      {
        "id": "grammar-3",
        "kind": "grammar_pattern",
        "pattern_hanzi": "太晚了 + 早点见",
        "pattern_pinyin": "tài wǎn le + zǎo diǎn jiàn",
        "function_en": "Use 太晚了 (tài wǎn le) to object and 早点 (zǎo diǎn) to suggest an earlier time.",
        "example": {
          "id": "pattern-ex-3",
          "hanzi": "太晚了，我们早点见。",
          "pinyin": "Tài wǎn le, wǒmen zǎo diǎn jiàn.",
          "english": "That is too late; let us meet earlier.",
          "teaching_note": "Pair your objection with a concrete earlier meeting suggestion."
        }
      },
