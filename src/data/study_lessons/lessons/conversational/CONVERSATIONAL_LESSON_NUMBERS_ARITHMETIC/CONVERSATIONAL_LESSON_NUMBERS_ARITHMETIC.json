  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to say two-digit numbers and ask or answer simple addition questions. Use the model conversation to notice the expressions, then practice the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "二加三是多少？",
            "pinyin": "Èr jiā sān shì duōshao?",
            "english": "What is two plus three?"
          },
          {
            "speaker": "B",
            "hanzi": "五。",
            "pinyin": "Wǔ.",
            "english": "Five."
          },
          {
            "speaker": "A",
            "hanzi": "六加六是多少？",
            "pinyin": "Liù jiā liù shì duōshao?",
            "english": "What is six plus six?"
          },
          {
            "speaker": "B",
            "hanzi": "十二。",
            "pinyin": "Shí'èr.",
            "english": "Twelve."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "数字 + 加 + 数字 + 是多少？",
        "pattern_pinyin": "shùzì + jiā + shùzì + shì duōshao?",
        "function_en": "Use 加 (jiā) for addition; 多少 (duōshao) asks for the result.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "六加六是多少？",
          "pinyin": "liù jiā liù shì duōshao?",
          "english": "What is six plus six?",
          "teaching_note": "Use the pattern to ask for a total during a purchase."
        },
        "pattern_pseudo_translation": "<first number> + 加 + <second number> + 是多少？"
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "数字 + 十 + 数字",
        "pattern_pinyin": "shùzì + shí + shùzì",
        "function_en": "Numbers 11–19 use ten plus a digit, while 20–99 use tens plus a digit.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "二十五",
          "pinyin": "èrshíwǔ",
          "english": "Twenty-five.",
          "teaching_note": "二十五 (èrshíwǔ) consists of two tens plus five."
        },
        "pattern_pseudo_translation": "<tens digit> + 十 + <ones digit>"
      },
