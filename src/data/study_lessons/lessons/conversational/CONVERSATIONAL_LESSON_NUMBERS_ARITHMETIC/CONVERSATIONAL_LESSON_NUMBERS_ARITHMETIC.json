          {
            "speaker": "A",
            "hanzi": "这是十三块还是三十块？",
            "pinyin": "Zhè shì shísān kuài háishi sānshí kuài?",
            "english": "Is this thirteen or thirty yuan?"
          },
          {
            "speaker": "B",
            "hanzi": "十三块，不是三十块。",
            "pinyin": "Shísān kuài, bú shì sānshí kuài.",
            "english": "Thirteen yuan, not thirty."
          },
          {
            "speaker": "A",
            "hanzi": "那两件一共多少钱？",
            "pinyin": "Nà liǎng jiàn yígòng duōshao qián?",
            "english": "Then how much are two items altogether?"
          },
          {
            "speaker": "B",
            "hanzi": "一共二十六块。",
            "pinyin": "Yígòng èrshíliù kuài.",
            "english": "Twenty-six yuan altogether."
          }
        ]
