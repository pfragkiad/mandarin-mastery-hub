        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to recognize numbers from one to forty-plus. Use the model conversation to notice the expressions, then practise the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "二加三是多少？",
            "pinyin": "Èr jiā sān shì duōshao?",
            "english": "What is two plus three?"
          },
          {
            "speaker": "B",
            "hanzi": "五。",
            "pinyin": "Wǔ.",
            "english": "Five."
          },
          {
            "speaker": "A",
            "hanzi": "六加六是多少？",
            "pinyin": "Liù jiā liù shì duōshao?",
            "english": "What is six plus six?"
          },
          {
            "speaker": "B",
            "hanzi": "十二。",
            "pinyin": "Shí’èr.",
            "english": "Twelve."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "A 加 B 是多少",
        "pattern_pinyin": "A jiā B shì duōshao",
        "function_en": "Use 加 (jiā) for addition; 多少 (duōshao) asks for the result.",
        "example": {
