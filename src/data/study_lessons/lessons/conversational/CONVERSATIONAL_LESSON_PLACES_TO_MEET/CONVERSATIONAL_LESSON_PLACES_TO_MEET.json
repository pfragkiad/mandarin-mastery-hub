  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to invite someone to meet for food, decline one place, and suggest another. Use the model conversation to notice the expressions, then practice the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你想去哪儿吃午饭？",
            "pinyin": "Nǐ xiǎng qù nǎr chī wǔfàn?",
            "english": "Where would you like to have lunch?"
          },
          {
            "speaker": "B",
            "hanzi": "我想去饭店。",
            "pinyin": "Wǒ xiǎng qù fàndiàn.",
            "english": "I would like to go to a restaurant."
          },
          {
            "speaker": "A",
            "hanzi": "去北京饭店，好吗？",
            "pinyin": "Qù Běijīng Fàndiàn, hǎo ma?",
            "english": "How about going to the Beijing Hotel?"
          },
          {
            "speaker": "B",
            "hanzi": "好，我们去吧。",
            "pinyin": "Hǎo, wǒmen qù ba.",
            "english": "Okay, let us go."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "想 + 去 + 地点 + 动作",
        "pattern_pinyin": "xiǎng + qù + dìdiǎn + dòngzuò",
        "function_en": "Combine destination and purpose in one sentence.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "我想去饭店吃。",
          "pinyin": "wǒ xiǎng qù fàndiàn chī.",
          "english": "I want to go to a restaurant to eat.",
          "teaching_note": "Link a proposed destination to the activity you want to do there."
        },
        "pattern_pseudo_translation": "想 + 去 + <place> + <what to do>"
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "在 + 地点 + 动作",
        "pattern_pinyin": "zài + dìdiǎn + dòngzuò",
        "function_en": "Use 在 (zài) before a place to say where an action happens.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "我想在这儿喝茶。",
          "pinyin": "wǒ xiǎng zài zhèr hē chá.",
          "english": "I want to drink tea here.",
          "teaching_note": "You can use this structure to suggest staying here instead of going elsewhere."
        },
        "pattern_pseudo_translation": "在 + <place> + <what to do>"
      },
      {
        "id": "key-expressions",
        "kind": "review_set",
        "items": [
          {
            "hanzi": "你想去哪儿",
            "pinyin": "nǐ xiǎng qù nǎr",
            "meaning_en": "Where do you want to go?"
          },
          {
            "hanzi": "你想去哪儿吃",
            "pinyin": "nǐ xiǎng qù nǎr chī",
            "meaning_en": "Where do you want to eat?"
          },
          {
            "hanzi": "去咖啡厅",
            "pinyin": "qù kāfēitīng",
            "meaning_en": "Go to a café."
          },
          {
