  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to ask permission, request an item politely, and respond appropriately. Use the model conversation to notice the expressions, then practice the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你可不可以给我一点钱？",
            "pinyin": "Nǐ kě bu kěyǐ gěi wǒ yìdiǎn qián?",
            "english": "Could you give me some money?"
          },
          {
            "speaker": "B",
            "hanzi": "可以，我给你十块人民币。",
            "pinyin": "Kěyǐ, wǒ gěi nǐ shí kuài rénmínbì.",
            "english": "Yes, I can. I will give you ten yuan."
          },
          {
            "speaker": "A",
            "hanzi": "谢谢你！",
            "pinyin": "Xièxie nǐ!",
            "english": "Thank you!"
          },
          {
            "speaker": "B",
            "hanzi": "不客气。",
            "pinyin": "Bú kèqi.",
            "english": "You are welcome."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "可不可以 + 动作？",
        "pattern_pinyin": "kě bu kěyǐ + dòngzuò?",
        "function_en": "An A-not-A form of 可以 (kěyǐ) asks about possibility or permission.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "你可不可以买茶？",
          "pinyin": "nǐ kě bu kěyǐ mǎi chá?",
          "english": "Can you buy tea?",
          "teaching_note": "Ask whether an action is possible or allowed in the situation."
        },
        "pattern_pseudo_translation": "可不可以 + <what to do>？"
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "给 + 人 + 数量 + 物品",
        "pattern_pinyin": "gěi + rén + shùliàng + wùpǐn",
        "function_en": "给 (gěi) can mean to give something to someone.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "给我一点茶。",
          "pinyin": "gěi wǒ yìdiǎn chá.",
          "english": "Give me a little tea.",
          "teaching_note": "In a polite request, consider adding 请 (qǐng) before the verb."
        },
        "pattern_pseudo_translation": "给 + <person> + <number or amount> + <item>"
      },
      {
        "id": "key-expressions",
        "kind": "review_set",
        "items": [
          {
            "hanzi": "我可以",
            "pinyin": "wǒ kěyǐ",
            "meaning_en": "I can; I am allowed to."
          },
          {
            "hanzi": "你可以",
            "pinyin": "nǐ kěyǐ",
            "meaning_en": "You can; you are allowed to."
          },
          {
            "hanzi": "你可不可以",
            "pinyin": "nǐ kě bu kěyǐ",
            "meaning_en": "Can you?; may you?"
          },
          {
            "hanzi": "你可不可以现在吃",
            "pinyin": "nǐ kě bu kěyǐ xiànzài chī",
            "meaning_en": "Can you eat now?"
          },
          {
            "hanzi": "我不可以",
            "pinyin": "wǒ bù kěyǐ",
            "meaning_en": "I cannot; I am not allowed to."
          },
          {
            "hanzi": "给我一点人民币",
            "pinyin": "gěi wǒ yìdiǎn rénmínbì",
            "meaning_en": "Give me a little RMB."
          },
          {
            "hanzi": "你可不可以给我一点钱",
            "pinyin": "nǐ kě bu kěyǐ gěi wǒ yìdiǎn qián",
            "meaning_en": "Could you give me some money?"
          },
          {
            "hanzi": "我给你十块美金",
            "pinyin": "wǒ gěi nǐ shí kuài měijīn",
            "meaning_en": "I will give you ten US dollars."
          },
          {
            "hanzi": "不客气",
            "pinyin": "bú kèqi",
            "meaning_en": "You are welcome."
          },
          {
            "hanzi": "你可不可以买很多啤酒",
            "pinyin": "nǐ kě bu kěyǐ mǎi hěn duō píjiǔ",
            "meaning_en": "Can you buy a lot of beer?"
          },
          {
            "hanzi": "我可以买很多啤酒",
            "pinyin": "wǒ kěyǐ mǎi hěn duō píjiǔ",
            "meaning_en": "I can buy a lot of beer."
          },
          {
            "hanzi": "你可不可以去买一点啤酒",
            "pinyin": "nǐ kě bu kěyǐ qù mǎi yìdiǎn píjiǔ",
            "meaning_en": "Can you go buy some beer?"
          },
          {
            "hanzi": "我可以去买一点啤酒",
            "pinyin": "wǒ kěyǐ qù mǎi yìdiǎn píjiǔ",
            "meaning_en": "I can go buy some beer."
          },
          {
            "hanzi": "我不可以给你",
            "pinyin": "wǒ bù kěyǐ gěi nǐ",
            "meaning_en": "I cannot give it to you."
          },
          {
            "hanzi": "给我三块人民币",
            "pinyin": "gěi wǒ sān kuài rénmínbì",
            "meaning_en": "Give me three yuan."
          },
          {
            "hanzi": "我给你五块美金",
            "pinyin": "wǒ gěi nǐ wǔ kuài měijīn",
            "meaning_en": "I will give you five US dollars."
          },
          {
            "hanzi": "可不可以",
            "pinyin": "kě bu kěyǐ",
            "meaning_en": "may I?; can or cannot?"
          },
          {
            "hanzi": "是不是",
            "pinyin": "shì bú shì",
            "meaning_en": "is it or not?"
          },
          {
            "hanzi": "有没有",
            "pinyin": "yǒu méiyǒu",
            "meaning_en": "do you have?; is there any?"
          },
          {
            "hanzi": "给你",
            "pinyin": "gěi nǐ",
            "meaning_en": "here you are; give to you"
          },
          {
            "hanzi": "太多了",
            "pinyin": "tài duō le",
            "meaning_en": "that is too much"
          }
        ]
      },
      {
        "id": "guided-speaking",
        "kind": "explanation",
        "text": "Speaking task: Ask politely for an item and respond with permission, refusal or thanks."
      },
      {
        "id": "source-coverage-dialogue",
        "kind": "dialogue",
        "title": "Asking Whether You May Pay",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "请问，可不可以用人民币付钱？",
            "pinyin": "Qǐngwèn, kě bu kěyǐ yòng rénmínbì fù qián?",
            "english": "Excuse me, may I pay with yuan?"
          },
          {
            "speaker": "B",
            "hanzi": "可以。你有现金吗？",
            "pinyin": "Kěyǐ. Nǐ yǒu xiànjīn ma?",
            "english": "Yes. Do you have cash?"
          },
          {
            "speaker": "A",
            "hanzi": "我有钱，可是只有十块。",
            "pinyin": "Wǒ yǒu qián, kěshì zhǐ yǒu shí kuài.",
            "english": "I have money, but only ten yuan."
          },
          {
            "speaker": "B",
            "hanzi": "十块不够，这个要十五块。",
            "pinyin": "Shí kuài bú gòu, zhège yào shíwǔ kuài.",
            "english": "Ten yuan is not enough. This costs fifteen yuan."
          }
        ]
      },
      {
        "id": "source-coverage-grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "主语 + 可不可以 + 动词 + 物品？",
        "pattern_pinyin": "zhǔyǔ + kě bu kěyǐ + dòngcí + wùpǐn?",
        "function_en": "可不可以 (kě bu kěyǐ) asks for permission or possibility as an A-not-A question.",
        "example": {
          "id": "source-coverage-grammar-1--example",
          "hanzi": "我可不可以用美金？",
          "pinyin": "Wǒ kě bu kěyǐ yòng měijīn?",
          "english": "May I use US dollars?",
          "teaching_note": "Here the customer is checking whether paying in US dollars is acceptable."
        },
        "pattern_pseudo_translation": "<who or what> + 可不可以 + <action word> + <item>？"
      }
    ],
