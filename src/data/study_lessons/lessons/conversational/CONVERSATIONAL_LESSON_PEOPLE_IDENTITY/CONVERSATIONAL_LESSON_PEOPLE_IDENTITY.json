  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to introduce yourself, ask about someone’s nationality, and respond to a follow-up question. Use the model conversation to notice the expressions, then practice the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你是美国人吗？",
            "pinyin": "Nǐ shì Měiguó rén ma?",
            "english": "Are you American?"
          },
          {
            "speaker": "B",
            "hanzi": "不是，我是中国人。",
            "pinyin": "Bú shì, wǒ shì Zhōngguó rén.",
            "english": "No, I am Chinese."
          },
          {
            "speaker": "B",
            "hanzi": "你呢？",
            "pinyin": "Nǐ ne?",
            "english": "And you?"
          },
          {
            "speaker": "A",
            "hanzi": "我是美国人。",
            "pinyin": "Wǒ shì Měiguó rén.",
            "english": "I am American."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "主语 + 是 + 身份",
        "pattern_pinyin": "zhǔyǔ + shì + shēnfèn",
        "function_en": "Use 是 (shì) to identify nationality or identity.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "我是中国人。",
          "pinyin": "wǒ shì Zhōngguó rén.",
          "english": "I am Chinese.",
          "teaching_note": "Replace the nationality with another identity to introduce yourself or someone else."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "主语 + 不是 + 身份",
        "pattern_pinyin": "zhǔyǔ + bú shì + shēnfèn",
        "function_en": "不 (bù) changes to bú before a fourth-tone syllable, as in 是 (shì).",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "我不是美国人。",
          "pinyin": "wǒ bú shì Měiguó rén.",
          "english": "I am not American.",
          "teaching_note": "The spoken reading changes to bú shì before fourth-tone 是 (shì)."
        }
      },
