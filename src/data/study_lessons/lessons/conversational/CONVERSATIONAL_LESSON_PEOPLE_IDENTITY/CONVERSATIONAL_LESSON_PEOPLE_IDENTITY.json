      {
        "id": "source-coverage-grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "主语 + 是不是 + 身份？",
        "pattern_pinyin": "zhǔyǔ + shì bú shì + shēnfèn?",
        "function_en": "是不是 (shì bú shì) is a positive-negative question; normally omit final 吗 (ma) here.",
        "example": {
          "id": "source-coverage-grammar-1--example",
          "hanzi": "你是不是中国人？",
          "pinyin": "Nǐ shì bú shì Zhōngguó rén?",
          "english": "Are you Chinese?",
          "teaching_note": "A direct response may begin with 是 (shì) or 不是 (bú shì)."
        }
