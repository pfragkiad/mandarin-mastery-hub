      {
        "id": "guided-speaking",
        "kind": "explanation",
        "text": "Speaking task: Ask the price of tea or beer; answer with a simple amount in RMB or dollars."
      },
      {
        "id": "source-coverage-dialogue",
        "kind": "dialogue",
        "title": "Comparing Currency and Cash on Hand",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "这件东西十八块人民币。",
            "pinyin": "Zhè jiàn dōngxi shíbā kuài rénmínbì.",
            "english": "This item costs eighteen yuan."
          },
          {
            "speaker": "B",
            "hanzi": "太多钱了！我只有八块，不够。",
            "pinyin": "Tài duō qián le! Wǒ zhǐ yǒu bā kuài, bú gòu.",
            "english": "That is too much money! I only have eight yuan, not enough."
          },
          {
            "speaker": "A",
            "hanzi": "你有美金吗？",
            "pinyin": "Nǐ yǒu měijīn ma?",
            "english": "Do you have US dollars?"
          },
          {
            "speaker": "B",
            "hanzi": "没有。可是我朋友有很多人民币。",
            "pinyin": "Méiyǒu. Kěshì wǒ péngyou yǒu hěn duō rénmínbì.",
            "english": "No. But my friend has plenty of yuan."
          }
        ]
      },
      {
        "id": "source-coverage-grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "只有 + 数量 + 钱；不够",
        "pattern_pinyin": "zhǐ yǒu + shùliàng + qián; bú gòu",
        "function_en": "只有 (zhǐ yǒu) emphasizes a limited amount; 够 (gòu) means enough.",
        "example": {
          "id": "source-coverage-grammar-1--example",
          "hanzi": "我只有五块钱，不够。",
          "pinyin": "Wǒ zhǐ yǒu wǔ kuài qián, bú gòu.",
          "english": "I only have five yuan; that is not enough.",
          "teaching_note": "This gives a practical reason for being unable to pay the requested amount."
        },
        "pattern_pseudo_translation": "只有 + <number or amount> + 钱；不够"
      }
    ],
