  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to ask the prices of common drinks and reply with amounts in renminbi. Use the model conversation to notice the expressions, then practice the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "请问，一杯啤酒多少钱？",
            "pinyin": "Qǐngwèn, yì bēi píjiǔ duōshao qián?",
            "english": "Excuse me, how much is a glass of beer?"
          },
          {
            "speaker": "B",
            "hanzi": "十块人民币。",
            "pinyin": "Shí kuài rénmínbì.",
            "english": "Ten yuan."
          },
          {
            "speaker": "A",
            "hanzi": "你有多少钱？",
            "pinyin": "Nǐ yǒu duōshao qián?",
            "english": "How much money do you have?"
          },
          {
            "speaker": "B",
            "hanzi": "我有二十块人民币。",
            "pinyin": "Wǒ yǒu èrshí kuài rénmínbì.",
            "english": "I have twenty yuan."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "物品 + 多少钱？",
        "pattern_pinyin": "wùpǐn + duōshao qián?",
        "function_en": "多少钱 (duōshao qián) asks for the price.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "一杯茶多少钱？",
          "pinyin": "yì bēi chá duōshao qián?",
          "english": "How much is a cup of tea?",
          "teaching_note": "Name the item when checking a quoted price."
        },
        "pattern_pseudo_translation": "<item> + 多少钱？"
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "数量 + 块 + 人民币",
        "pattern_pinyin": "shùliàng + kuài + rénmínbì",
        "function_en": "块 (kuài) is the colloquial unit used to count yuan or a currency amount.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "我有十块人民币。",
          "pinyin": "wǒ yǒu shí kuài rénmínbì.",
          "english": "I have ten yuan.",
          "teaching_note": "In ordinary conversations, 块 (kuài) is the casual word for yuan."
        },
        "pattern_pseudo_translation": "<number or amount> + 块 + 人民币"
      },
