  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Practice ask how much something costs. Transcript-referenced conversational Mandarin study organized by communicative goal rather than audio track. Use the model conversation to notice the expressions, then practise the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "请问，一杯啤酒多少钱？",
            "pinyin": "Qǐngwèn, yì bēi píjiǔ duōshao qián?",
            "english": "Excuse me, how much is a glass of beer?"
          },
          {
            "speaker": "B",
            "hanzi": "十块人民币。",
            "pinyin": "Shí kuài rénmínbì.",
            "english": "Ten yuan."
          },
          {
            "speaker": "A",
            "hanzi": "你有人民币吗？",
            "pinyin": "Nǐ yǒu rénmínbì ma?",
            "english": "Do you have Chinese currency?"
          },
          {
            "speaker": "B",
            "hanzi": "有，我有二十块。",
            "pinyin": "Yǒu, wǒ yǒu èrshí kuài.",
            "english": "Yes, I have twenty yuan."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "多少钱",
        "pattern_pinyin": "duōshao qián",
        "function_en": "多少钱 (duōshao qián) asks for the price.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "一杯茶多少钱？",
          "pinyin": "yì bēi chá duōshao qián?",
          "english": "How much is a cup of tea?",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "数词 + 块 + 币种",
        "pattern_pinyin": "shùcí kuài bìzhǒng",
        "function_en": "块 (kuài) is the colloquial unit used to count yuan or a currency amount.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "我有十块人民币。",
          "pinyin": "wǒ yǒu shí kuài rénmínbì.",
          "english": "I have ten yuan.",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
