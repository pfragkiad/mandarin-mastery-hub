  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to say what you want, decline food politely, and accept an offered drink. Use the model conversation to notice the expressions, then practise the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你想吃一点东西吗？",
            "pinyin": "Nǐ xiǎng chī yìdiǎn dōngxi ma?",
            "english": "Would you like something to eat?"
          },
          {
            "speaker": "B",
            "hanzi": "我不想吃。",
            "pinyin": "Wǒ bù xiǎng chī.",
            "english": "I do not want to eat."
          },
          {
            "speaker": "A",
            "hanzi": "你想喝一点茶吗？",
            "pinyin": "Nǐ xiǎng hē yìdiǎn chá ma?",
            "english": "Would you like some tea?"
          },
          {
            "speaker": "B",
            "hanzi": "好，我想喝一点茶。",
            "pinyin": "Hǎo, wǒ xiǎng hē yìdiǎn chá.",
            "english": "Yes, I would like a little tea."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "我想吃午饭。",
        "pattern_pinyin": "wǒ xiǎng chī wǔfàn.",
        "function_en": "想 (xiǎng) expresses a wish or desire followed by a verb.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "我想吃午饭。",
          "pinyin": "wǒ xiǎng chī wǔfàn.",
          "english": "I want to eat lunch.",
          "teaching_note": "想 (xiǎng) expresses a wish or desire followed by a verb."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "你想不想喝茶？",
        "pattern_pinyin": "nǐ xiǎng bu xiǎng hē chá?",
        "function_en": "An A-not-A question asks whether someone wants to do something.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "你想不想喝茶？",
          "pinyin": "nǐ xiǎng bu xiǎng hē chá?",
          "english": "Do you want to drink tea?",
          "teaching_note": "An A-not-A question asks whether someone wants to do something."
        }
      },
      {
        "id": "key-expressions",
        "kind": "review_set",
        "items": [
          {
            "hanzi": "我想",
            "pinyin": "wǒ xiǎng",
            "meaning_en": "I would like to; I want to."
          },
          {
            "hanzi": "你想",
            "pinyin": "nǐ xiǎng",
            "meaning_en": "You would like to; you want to."
          },
          {
            "hanzi": "我不想",
            "pinyin": "wǒ bù xiǎng",
            "meaning_en": "I do not want to."
          },
          {
            "hanzi": "我想吃",
            "pinyin": "wǒ xiǎng chī",
            "meaning_en": "I want to eat."
          },
          {
            "hanzi": "我想喝一点东西",
            "pinyin": "wǒ xiǎng hē yìdiǎn dōngxi",
            "meaning_en": "I would like something to drink."
          },
          {
            "hanzi": "你想买什么",
            "pinyin": "nǐ xiǎng mǎi shénme",
            "meaning_en": "What do you want to buy?"
          },
          {
            "hanzi": "我想要一点茶",
            "pinyin": "wǒ xiǎng yào yìdiǎn chá",
            "meaning_en": "I would like a little tea."
          },
          {
            "hanzi": "你想不想",
            "pinyin": "nǐ xiǎng bu xiǎng",
            "meaning_en": "Do you want to (or not)?"
          },
          {
            "hanzi": "我不要",
            "pinyin": "wǒ bú yào",
            "meaning_en": "I do not want it."
          },
          {
            "hanzi": "你想吃一点东西吗",
            "pinyin": "nǐ xiǎng chī yìdiǎn dōngxi ma",
            "meaning_en": "Would you like something to eat?"
          },
          {
            "hanzi": "我想吃一点东西",
            "pinyin": "wǒ xiǎng chī yìdiǎn dōngxi",
            "meaning_en": "I would like something to eat."
          },
          {
            "hanzi": "我不想现在吃",
            "pinyin": "wǒ bù xiǎng xiànzài chī",
            "meaning_en": "I do not want to eat now."
          },
          {
            "hanzi": "我想现在喝",
            "pinyin": "wǒ xiǎng xiànzài hē",
            "meaning_en": "I would like to drink now."
          },
          {
            "hanzi": "我要现在吃午饭",
            "pinyin": "wǒ yào xiànzài chī wǔfàn",
            "meaning_en": "I intend to have lunch now."
          },
          {
            "hanzi": "我不要吃",
            "pinyin": "wǒ bú yào chī",
            "meaning_en": "I do not want to eat."
          },
          {
            "hanzi": "你想什么时候吃",
            "pinyin": "nǐ xiǎng shénme shíhou chī",
            "meaning_en": "When would you like to eat?"
          }
        ]
      },
      {
        "id": "guided-speaking",
        "kind": "explanation",
        "text": "Speaking task: Offer food and drink, accept one offer and politely decline another."
      }
    ],
    "practice": {
