  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to ask where a street is and explain whether a place is here or over there. Use the model conversation to notice the expressions, then practice the patterns and speak aloud.\n\nPronunciation note: This course uses some northern-style 儿化 (érhuà) forms. The final -r belongs to the preceding syllable, not a separate syllable. For location questions, 哪儿 (nǎr), 这儿 (zhèr), and 那儿 (nàr) have common alternatives 哪里 (nǎlǐ), 这里 (zhèlǐ), and 那里 (nàlǐ)."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "请问，学院路在哪儿？",
            "pinyin": "Qǐngwèn, Xuéyuàn Lù zài nǎr?",
            "english": "Excuse me, where is Xueyuan Road?"
          },
          {
            "speaker": "B",
            "hanzi": "在那儿。",
            "pinyin": "Zài nàr.",
            "english": "It is over there."
          },
          {
            "speaker": "A",
            "hanzi": "长安街也在那儿吗？",
            "pinyin": "Cháng'ān Jiē yě zài nàr ma?",
            "english": "Is Chang’an Street also over there?"
          },
          {
            "speaker": "B",
            "hanzi": "不，长安街在这儿。",
            "pinyin": "Bù, Cháng'ān Jiē zài zhèr.",
            "english": "No, Chang’an Street is here."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "地名 + 在 + 哪儿？",
        "pattern_pinyin": "dìmíng + zài + nǎr?",
        "function_en": "Ask for a location with 在哪儿 (zài nǎr), without adding 吗 (ma).",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "学院路在哪儿？",
          "pinyin": "Xuéyuàn Lù zài nǎr?",
          "english": "Where is Xueyuan Road?",
          "teaching_note": "Replace the place name to ask about a street, building, or meeting point."
        },
        "pattern_pseudo_translation": "<place you’re looking for> + 在 + 哪儿？"
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "不在 + 地点",
        "pattern_pinyin": "bú zài + dìdiǎn",
        "function_en": "Negate a location with 不在 (bú zài); the 不 changes tone before fourth-tone 在.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "不在这儿。",
          "pinyin": "bú zài zhèr.",
          "english": "It is not here.",
          "teaching_note": "After correcting a mistaken location, give the right place or direction."
        },
        "pattern_pseudo_translation": "不在 + <place>"
      },
      {
        "id": "key-expressions",
        "kind": "review_set",
        "items": [
          {
            "hanzi": "请问学院路在哪儿",
            "pinyin": "qǐngwèn Xuéyuàn Lù zài nǎr",
            "meaning_en": "Excuse me, where is Xueyuan Road?"
          },
          {
            "hanzi": "学院路在哪儿",
            "pinyin": "Xuéyuàn Lù zài nǎr",
            "meaning_en": "Where is Xueyuan Road?"
          },
          {
            "hanzi": "长安街在哪儿",
            "pinyin": "Cháng'ān Jiē zài nǎr",
            "meaning_en": "Where is Chang’an Street?"
          },
          {
            "hanzi": "在这儿",
            "pinyin": "zài zhèr",
            "meaning_en": "It is here; located here."
          },
          {
            "hanzi": "在那儿",
            "pinyin": "zài nàr",
            "meaning_en": "It is there; located there."
          },
          {
            "hanzi": "不在这儿",
            "pinyin": "bú zài zhèr",
            "meaning_en": "Not here."
          },
          {
            "hanzi": "长安街在那儿",
            "pinyin": "Cháng'ān Jiē zài nàr",
            "meaning_en": "Chang’an Street is over there."
          },
          {
            "hanzi": "学院路在这儿",
            "pinyin": "Xuéyuàn Lù zài zhèr",
            "meaning_en": "Xueyuan Road is here."
          },
          {
            "hanzi": "我不知道",
            "pinyin": "wǒ bù zhīdào",
            "meaning_en": "I do not know."
          },
          {
            "hanzi": "学院路在那儿",
            "pinyin": "Xuéyuàn Lù zài nàr",
            "meaning_en": "Xueyuan Road is over there."
          },
          {
            "hanzi": "长安街在这儿",
            "pinyin": "Cháng'ān Jiē zài zhèr",
            "meaning_en": "Chang'an Street is here."
          },
          {
            "hanzi": "长安街不在这儿",
            "pinyin": "Cháng'ān Jiē bú zài zhèr",
            "meaning_en": "Chang'an Street is not here."
          },
          {
            "hanzi": "学院路呢",
            "pinyin": "Xuéyuàn Lù ne",
            "meaning_en": "How about Xueyuan Road?"
          },
          {
            "hanzi": "不在那儿",
            "pinyin": "bú zài nàr",
            "meaning_en": "Not over there."
          },
          {
            "hanzi": "你知道长安街在哪儿吗",
            "pinyin": "nǐ zhīdào Cháng'ān Jiē zài nǎr ma",
            "meaning_en": "Do you know where Chang'an Street is?"
          },
          {
            "hanzi": "长安街呢",
            "pinyin": "Cháng'ān Jiē ne",
            "meaning_en": "And what about Chang'an Street?"
          },
          {
            "hanzi": "学院路",
            "pinyin": "Xuéyuàn Lù",
            "meaning_en": "Xueyuan Road"
          },
          {
            "hanzi": "长安街",
            "pinyin": "Cháng'ān Jiē",
            "meaning_en": "Chang’an Avenue"
          },
          {
            "hanzi": "可是",
            "pinyin": "kěshì",
            "meaning_en": "but; however"
          },
          {
            "hanzi": "您",
            "pinyin": "nín",
            "meaning_en": "you (polite)"
          },
          {
            "hanzi": "去长安街",
            "pinyin": "qù Cháng'ān Jiē",
            "meaning_en": "go to Chang’an Avenue"
          }
        ]
      },
      {
        "id": "guided-speaking",
        "kind": "explanation",
        "text": "Speaking task: Role-play asking for Xueyuan Road and Chang’an Street; answer here/there/not here."
      },
      {
        "id": "source-coverage-dialogue",
        "kind": "dialogue",
        "title": "Checking Two Street Names",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "请问，您知道长安街在哪儿吗？",
            "pinyin": "Qǐngwèn, nín zhīdào Cháng'ān Jiē zài nǎr ma?",
            "english": "Excuse me, do you know where Chang’an Avenue is?"
          },
          {
            "speaker": "B",
            "hanzi": "对不起，我不知道。",
            "pinyin": "Duìbuqǐ, wǒ bù zhīdào.",
            "english": "Sorry, I do not know."
          },
          {
            "speaker": "A",
            "hanzi": "那学院路呢？",
            "pinyin": "Nà Xuéyuàn Lù ne?",
            "english": "What about Xueyuan Road?"
          },
          {
            "speaker": "B",
            "hanzi": "学院路在前面，可是长安街不在这儿。",
            "pinyin": "Xuéyuàn Lù zài qiánmiàn, kěshì Cháng'ān Jiē bú zài zhèr.",
            "english": "Xueyuan Road is ahead, but Chang’an Avenue is not here."
          }
        ]
      }
    ],
