        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Topic lesson based on Conversational Mandarin, tracks 1–16. Dialogue is an editorial teaching exchange using source-attested expressions; it is not presented as a verbatim audio transcript."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "请问，学院路在哪儿？",
            "pinyin": "Qǐngwèn, Xuéyuàn Lù zài nǎr?",
            "english": "Excuse me, where is Xueyuan Road?"
          },
          {
            "speaker": "B",
            "hanzi": "在那儿。",
            "pinyin": "Zài nàr.",
            "english": "It is over there."
          },
          {
            "speaker": "A",
            "hanzi": "长安街也在那儿吗？",
            "pinyin": "Cháng’ān Jiē yě zài nàr ma?",
            "english": "Is Chang’an Street also over there?"
          },
          {
            "speaker": "B",
            "hanzi": "不，长安街在这儿。",
            "pinyin": "Bù, Cháng’ān Jiē zài zhèr.",
            "english": "No, Chang’an Street is here."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "地点 + 在 + 哪儿",
        "pattern_pinyin": "dìdiǎn zài nǎr",
        "function_en": "Ask for a location with 在哪儿 (zài nǎr), without adding 吗 (ma).",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "学院路在哪儿？",
          "pinyin": "Xuéyuàn Lù zài nǎr?",
          "english": "Where is Xueyuan Road?",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "不在 + 地点",
        "pattern_pinyin": "bú zài dìdiǎn",
        "function_en": "Negate a location with 不在 (bú zài); the 不 changes tone before fourth-tone 在.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "不在这儿。",
          "pinyin": "bú zài zhèr.",
          "english": "It is not here.",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
