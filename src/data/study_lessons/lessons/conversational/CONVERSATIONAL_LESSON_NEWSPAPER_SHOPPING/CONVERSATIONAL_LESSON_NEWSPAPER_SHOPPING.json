  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to ask for a newspaper, confirm its price, and respond when you lack the right currency. practice the new dialogue and the examples, then complete the role-play."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "您好，请问你们有没有美国报纸？",
            "pinyin": "Nín hǎo, qǐngwèn nǐmen yǒu méiyǒu Měiguó bàozhǐ?",
            "english": "Hello, do you have American newspapers?"
          },
          {
            "speaker": "B",
            "hanzi": "有，也有英文报纸。",
            "pinyin": "Yǒu, yě yǒu Yīngwén bàozhǐ.",
            "english": "Yes, and we also have English-language newspapers."
          },
          {
            "speaker": "A",
            "hanzi": "这份报纸是不是十八块？",
            "pinyin": "Zhè fèn bàozhǐ shì bú shì shíbā kuài?",
            "english": "Does this newspaper cost eighteen yuan?"
          },
          {
            "speaker": "B",
            "hanzi": "不是十八块，是八块人民币。",
            "pinyin": "Bú shì shíbā kuài, shì bā kuài rénmínbì.",
            "english": "Not eighteen; it is eight yuan."
          },
          {
            "speaker": "A",
            "hanzi": "我有美金，可是没有人民币。",
            "pinyin": "Wǒ yǒu měijīn, kěshì méiyǒu rénmínbì.",
            "english": "I have US dollars but no yuan."
          },
          {
            "speaker": "B",
            "hanzi": "这里只收人民币。",
            "pinyin": "Zhèlǐ zhǐ shōu rénmínbì.",
            "english": "We only accept yuan here."
          },
          {
            "speaker": "A",
            "hanzi": "那么我一会儿再来，谢谢。",
            "pinyin": "Nàme wǒ yíhuìr zài lái, xièxie.",
            "english": "Then I will come back in a little while, thank you."
          },
          {
            "speaker": "B",
            "hanzi": "不客气！",
            "pinyin": "Bú kèqi!",
            "english": "You are welcome!"
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "有没有 + 物品？",
        "pattern_pinyin": "yǒu méiyǒu + wùpǐn?",
        "function_en": "有没有 (yǒu méiyǒu) is the A-not-A form of 有 (yǒu), used for availability or possession.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "你有没有今天的报纸？",
          "pinyin": "Nǐ yǒu méiyǒu jīntiān de bàozhǐ?",
          "english": "Do you have today’s newspaper?",
          "teaching_note": "Replace newspaper with another item when asking whether it is in stock."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "物品 + 是不是 + 价格？",
        "pattern_pinyin": "wùpǐn + shì bú shì + jiàgé?",
        "function_en": "是不是 (shì bú shì) asks for confirmation without a final 吗 (ma).",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "这个是不是八块？",
          "pinyin": "Zhège shì bú shì bā kuài?",
          "english": "Is this eight yuan?",
          "teaching_note": "Use this to check the amount you think you heard."
        }
      },
      {
        "id": "grammar-3",
        "kind": "grammar_pattern",
        "pattern_hanzi": "数字 + 不是 + 另一个数字",
        "pattern_pinyin": "shùzì + bú shì + lìng yí ge shùzì",
        "function_en": "Check numbers carefully: 八 (bā) is eight, whereas 十八 (shíbā) is eighteen.",
        "example": {
          "id": "pattern-ex-3",
          "hanzi": "八块，不是十八块。",
          "pinyin": "Bā kuài, bú shì shíbā kuài.",
          "english": "Eight yuan, not eighteen yuan.",
          "teaching_note": "Repeat the corrected number if the buyer misheard the price."
        }
      },
      {
        "id": "key-expressions",
        "kind": "review_set",
        "items": [
          {
            "hanzi": "报纸",
            "pinyin": "bàozhǐ",
