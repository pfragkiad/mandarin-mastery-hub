  "sections": {
    "blocks": [
      {
        "id": "lesson-intro",
        "kind": "explanation",
        "text": "Learn to choose between two options in a question. Use the model conversation to notice the expressions, then practise the patterns and speak aloud."
      },
      {
        "id": "model-dialogue",
        "kind": "dialogue",
        "title": "Model conversation",
        "turns": [
          {
            "speaker": "A",
            "hanzi": "你想喝茶还是啤酒？",
            "pinyin": "Nǐ xiǎng hē chá háishi píjiǔ?",
            "english": "Would you like tea or beer?"
          },
          {
            "speaker": "B",
            "hanzi": "我想喝茶。",
            "pinyin": "Wǒ xiǎng hē chá.",
            "english": "I would like tea."
          },
          {
            "speaker": "A",
            "hanzi": "你想现在喝还是过一会儿喝？",
            "pinyin": "Nǐ xiǎng xiànzài hē háishi guò yíhuìr hē?",
            "english": "Do you want it now or later?"
          },
          {
            "speaker": "B",
            "hanzi": "过一会儿吧。",
            "pinyin": "Guò yíhuìr ba.",
            "english": "A little later, please."
          }
        ]
      },
      {
        "id": "grammar-1",
        "kind": "grammar_pattern",
        "pattern_hanzi": "A 还是 B",
        "pattern_pinyin": "A háishi B",
        "function_en": "还是 (háishi) is normal in questions that present a choice.",
        "example": {
          "id": "pattern-ex-1",
          "hanzi": "你喝茶还是啤酒？",
          "pinyin": "nǐ hē chá háishi píjiǔ?",
          "english": "Tea or beer?",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
      {
        "id": "grammar-2",
        "kind": "grammar_pattern",
        "pattern_hanzi": "A 或者 B",
        "pattern_pinyin": "A huòzhě B",
        "function_en": "或者 (huòzhě) commonly offers alternatives in statements.",
        "example": {
          "id": "pattern-ex-2",
          "hanzi": "我想买茶或者啤酒。",
          "pinyin": "wǒ xiǎng mǎi chá huòzhě píjiǔ.",
          "english": "I want to buy tea or beer.",
          "teaching_note": "Use this construction in your own dialogue."
        }
      },
      {
        "id": "key-expressions",
        "kind": "review_set",
        "items": [
          {
            "hanzi": "你想喝茶还是啤酒",
            "pinyin": "nǐ xiǎng hē chá háishi píjiǔ",
            "meaning_en": "Would you like tea or beer?"
          },
          {
            "hanzi": "我想买茶或者啤酒",
            "pinyin": "wǒ xiǎng mǎi chá huòzhě píjiǔ",
            "meaning_en": "I want to buy tea or beer."
          },
          {
            "hanzi": "一点钟还是两点钟",
            "pinyin": "yì diǎn zhōng háishi liǎng diǎn zhōng",
            "meaning_en": "One o’clock or two o’clock?"
          },
          {
            "hanzi": "四点钟或者五点钟",
            "pinyin": "sì diǎn zhōng huòzhě wǔ diǎn zhōng",
            "meaning_en": "Four or five o’clock."
          },
          {
            "hanzi": "你要不要",
            "pinyin": "nǐ yào bu yào",
            "meaning_en": "Do you want it?"
          },
          {
            "hanzi": "你想不想",
            "pinyin": "nǐ xiǎng bu xiǎng",
            "meaning_en": "Do you want to?"
          },
          {
            "hanzi": "你有没有",
            "pinyin": "nǐ yǒu méiyǒu",
            "meaning_en": "Do you have any?"
          },
          {
            "hanzi": "好不好",
            "pinyin": "hǎo bu hǎo",
            "meaning_en": "Is that okay?"
          },
          {
            "hanzi": "八点钟还是九点钟",
            "pinyin": "bā diǎn zhōng háishi jiǔ diǎn zhōng",
            "meaning_en": "Eight or nine o'clock?"
          },
          {
            "hanzi": "你想要茶还是啤酒",
            "pinyin": "nǐ xiǎng yào chá háishi píjiǔ",
            "meaning_en": "Would you like tea or beer?"
          },
          {
            "hanzi": "你要不要美金",
            "pinyin": "nǐ yào bu yào Měijīn",
            "meaning_en": "Do you want US dollars?"
          },
          {
            "hanzi": "你有没有人民币",
            "pinyin": "nǐ yǒu méiyǒu rénmínbì",
            "meaning_en": "Do you have any RMB?"
          },
          {
            "hanzi": "你想不想吃一点东西",
            "pinyin": "nǐ xiǎng bu xiǎng chī yìdiǎn dōngxi",
            "meaning_en": "Do you want something to eat?"
          },
          {
            "hanzi": "现在还是过一会儿",
            "pinyin": "xiànzài háishi guò yíhuìr",
            "meaning_en": "Now or later?"
          }
        ]
      },
      {
        "id": "guided-speaking",
        "kind": "explanation",
        "text": "Speaking task: Ask three choice questions: drinks, location, and time. Answer using a complete sentence."
      }
